+            } else {
+                format!("{queried_family:?}/{queried_pass_role:?}")
+            }
+        }
+        LutQueryStamp::Refused {
+            declared_family,
+            declared_pass_role,
+            tool_family,
+        } => format!(
+            "refused — no rows for {tool_family:?} on \
+             {declared_family:?}/{declared_pass_role:?}"
+        ),
+    }
