+"""P38: why the wood above a deep move of op 2 stood.
+For each node that a move lowers by more than DEEP, and each level of the op above the move Z
+(below the node top), the class of the node at that level:
+  kept     : under the disc of a tool centre in a region the level planned (the wood was in reach of a plan)
+  no field / F-038 forecast / small : under the disc of a centre in a dropped region or piece
+  none     : under no centre region of the level (S1)
+usage: attr.py <dump.jsonl> <deep.npz>
+"""
+import json, sys, math, collections
+import numpy as np
+from matplotlib.path import Path
+from scipy import ndimage
+from gapmap import CELL, NX, NY, OFF, disc
+R = 3.0
+dump = [json.loads(l) for l in open(sys.argv[1])]
+d = np.load(sys.argv[2]); rows = d["rows"]; tall = d["tall"]
+levels = sorted({o["z"] for o in dump}, reverse=True)
+PRI = ["kept", "no field", "F-038 forecast", "small"]
+masks = {(z, k): np.zeros((NY, NX), bool) for z in levels for k in PRI}
+fp = disc(R)
+for o in dump:
+    ext = np.array(o["ext"]) + np.array(OFF)   # setup frame -> G-code frame
+    if len(ext) < 3: continue
+    i0 = max(0, int(ext[:, 0].min() / CELL) - 17); i1 = min(NX - 1, int(ext[:, 0].max() / CELL) + 18)
+    j0 = max(0, int(ext[:, 1].min() / CELL) - 17); j1 = min(NY - 1, int(ext[:, 1].max() / CELL) + 18)
+    J, I = np.mgrid[j0:j1 + 1, i0:i1 + 1]
+    pts = np.c_[I.ravel() * CELL, J.ravel() * CELL]
+    m = Path(ext).contains_points(pts)
+    for h in o["holes"]:
+        hh = np.array(h) + np.array(OFF)
+        if len(hh) >= 3: m &= ~Path(hh).contains_points(pts)
+    m = ndimage.binary_dilation(m.reshape(J.shape), structure=fp)
+    masks[(o["z"], o["kind"])][j0:j1 + 1, i0:i1 + 1] |= m
+piece = {int(r[0]): r for r in rows}
+res = collections.defaultdict(lambda: [0, 0.0, set()])
+per_piece = {}
+for n, x, y, before, after in tall:
+    n = int(n); r = piece[n]; zc = min(r[3], r[6])
+    i = int(round(x / CELL)); j = int(round(y / CELL))
+    cls = []
+    for z in levels:
+        if z <= zc + 0.3 or z >= before - 0.05: continue
+        c = "none"
+        for k in PRI[::-1]:
+            if masks[(z, k)][j, i]: c = k
+        # priority: a drop class wins over kept when both hold (the piece of a kept region)
+        for k in PRI[1:]:
+            if masks[(z, k)][j, i]: c = k; break
+        cls.append((z, c))
+    key = tuple(c for _, c in cls) or ("no level above",)
+    per_piece.setdefault(n, collections.Counter())[key] += 1
+summary = collections.Counter(); length = collections.Counter(); desc = collections.Counter()
+for n, ctr in per_piece.items():
+    r = piece[n]; key = ctr.most_common(1)[0][0]
+    L = math.hypot(r[4] - r[1], r[5] - r[2])
+    plunge = abs(r[6] - r[3]) > 0.5
+    k2 = ("DESCENT " if plunge else "") + " > ".join(key)
+    summary[k2] += 1; length[k2] += L
+print("levels", levels)
+print("deep pieces", len(per_piece))
+for k, v in summary.most_common():
+    print(f"{v:4d} pieces {length[k]:7.1f} mm  classes at the levels above (top first): {k}")
