+"""P38 instrument: the axial depth of each fed move of one op, on the replay stock.
+depth of a move = (highest stock node under the tool along the move, before the move) - (lowest tool Z of the move),
+read only on nodes the move lowers by more than EPS (the nodes that it cuts).
+usage: deep.py <nc> <op name prefix> <out.npz>
+"""
+import sys, math
+import numpy as np
+from gapmap import *
+EPS = 0.05
+DEEP = 6.3   # depth per pass 6.0 + the bar of the replay (one node 0.2 + 0.1 tolerance)
+def run(nc, prefix, out):
+    top = np.full((NY, NX), STOCK_TOP)
+    rows = []; n = 0; tall = []
+    for op, tool, p0, p1 in moves(nc):
+        if op.startswith(prefix):
+            kind, R, half = TOOLS[tool]
+            x0, y0, z0 = p0; x1, y1, z1 = p1
+            ia = max(0, int(math.ceil((min(x0, x1) - R) / CELL))); ib = min(NX - 1, int(math.floor((max(x0, x1) + R) / CELL)))
+            ja = max(0, int(math.ceil((min(y0, y1) - R) / CELL))); jb = min(NY - 1, int(math.floor((max(y0, y1) + R) / CELL)))
+            before = top[ja:jb + 1, ia:ib + 1].copy()
+            stamp(top, tool, p0, p1)
+            after = top[ja:jb + 1, ia:ib + 1]
+            cut = before - after > EPS
+            if cut.any():
+                d = float((before - after)[cut].max()); a = cut.sum() * CELL * CELL
+                hi = float(before[cut].max())
+            else:
+                d = 0.0; a = 0.0; hi = float('nan')
+            rows.append((n, x0, y0, z0, x1, y1, z1, d, a, hi))
+            if d > DEEP:
+                jj, ii = np.nonzero((before - after) > DEEP)
+                for j, i in zip(jj, ii):
+                    tall.append((n, (ia + i) * CELL, (ja + j) * CELL, before[j, i], after[j, i]))
+            n += 1
+        else:
+            stamp(top, tool, p0, p1)
+    np.savez_compressed(out, rows=np.array(rows), tall=np.array(tall))
+    return np.array(rows)
+if __name__ == "__main__":
+    r = run(sys.argv[1], sys.argv[2], sys.argv[3])
+    d = r[:, 7]
+    print("fed pieces", len(r), "cutting", (d > 0).sum())
+    for b in (6.0, 6.3, 7, 9, 12, 15, 18, 20):
+        m = d > b
+        L = np.hypot(np.hypot(r[m, 4] - r[m, 1], r[m, 5] - r[m, 2]), r[m, 6] - r[m, 3]).sum()
+        print(f"depth > {b:5.1f}: {m.sum():6d} pieces, fed length {L:8.1f} mm")
+    k = np.argmax(d); print("deepest", r[k])
