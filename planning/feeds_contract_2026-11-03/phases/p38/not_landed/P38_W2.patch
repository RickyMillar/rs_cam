+"""P38 W3: the moves of one op that cut below the target (by more than BAR), on the replay.
+usage: w3.py <nc> <op prefix> <out.npz>"""
+import sys, math
+import numpy as np
+from gapmap import *
+T = target(); ok = np.isfinite(T)
+def run(nc, prefix, out):
+    top = np.full((NY, NX), STOCK_TOP); rows = []; n = 0; line_of = {}
+    for op, tool, p0, p1 in moves(nc):
+        if not op.startswith(prefix):
+            stamp(top, tool, p0, p1); continue
+        kind, R, half = TOOLS[tool]
+        x0, y0, z0 = p0; x1, y1, z1 = p1
+        ia = max(0, int(math.ceil((min(x0, x1) - R) / CELL))); ib = min(NX - 1, int(math.floor((max(x0, x1) + R) / CELL)))
+        ja = max(0, int(math.ceil((min(y0, y1) - R) / CELL))); jb = min(NY - 1, int(math.floor((max(y0, y1) + R) / CELL)))
+        before = top[ja:jb + 1, ia:ib + 1].copy()
+        stamp(top, tool, p0, p1)
+        after = top[ja:jb + 1, ia:ib + 1]; t = T[ja:jb + 1, ia:ib + 1]; o = ok[ja:jb + 1, ia:ib + 1]
+        new = o & (after < before - 1e-6) & (after - t < -BAR)
+        if new.any():
+            g = np.where(new, after - t, 0); j, i = np.unravel_index(np.argmin(g), g.shape)
+            rows.append((n, x0, y0, z0, x1, y1, z1, new.sum() * CELL * CELL, g[j, i], (ia + i) * CELL, (ja + j) * CELL, t[j, i]))
+        n += 1
+    r = np.array(rows); np.savez_compressed(out, rows=r); return r
+if __name__ == "__main__":
+    r = run(sys.argv[1], sys.argv[2], sys.argv[3])
+    print("moves that cut below the target by >", BAR, ":", len(r))
+    if len(r):
+        # cluster by index gaps
+        cl = [[r[0]]]
+        for row in r[1:]:
+            (cl[-1] if row[0] - cl[-1][-1][0] <= 20 else cl.append([row]) or cl[-1]).append(row) if row[0] - cl[-1][-1][0] <= 20 else None
+        for c in cl:
+            c = np.array(c); k = np.argmin(c[:, 8])
+            print(f"idx {int(c[0,0]):6d}-{int(c[-1,0]):6d} n {len(c):4d} setup X {c[:,1].min()-18.5:6.1f}..{c[:,1].max()-18.5:6.1f} Y {c[:,2].min()-8.5:6.1f}..{c[:,2].max()-8.5:6.1f} tool z {c[:,6].min():6.2f}..{c[:,3].max():6.2f} deepest {c[k,8]:6.2f} mm below at setup ({c[k,9]-18.5:.1f}, {c[k,10]-8.5:.1f}) target {c[k,11]:.2f}")
