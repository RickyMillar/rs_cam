+"""P38 W2: the coverage readings of one run (summary.json rough_coverage)."""
+import json, sys
+tag = sys.argv[1]
+s = json.load(open(f"out_{tag}/summary.json"))
+for r in s.get("rough_coverage", []):
+    o = r["outcome"]
+    if o["state"] != "measured":
+        print(r["toolpath_id"], "NOT MEASURED", o["reading"]); continue
+    c = o["reading"]; isl = c["islands"]
+    cell = c["cell_mm"]
+    one = [i for i in isl if i["min_width_mm"] <= cell * 1.001]
+    wall = [i for i in isl if i["touches_wall"]]
+    print(f"id {r['toolpath_id']}: measured; cell {cell} bar {c['bar_mm']:.3f}; compared {c['compared_area_mm2']:.0f} mm2; above {c['above_spec_area_mm2']:.1f} mm2 in {len(isl)} islands; {len(wall)} at a wall; one cell wide: {len(one)} islands, {sum(i['area_mm2'] for i in one):.1f} mm2 ({sum(1 for i in one if i['touches_wall'])} at a wall); tallest {max((i['max_standing_mm'] for i in isl), default=0):.2f}")
+    for i in sorted(isl, key=lambda i: -i["area_mm2"])[:int(sys.argv[2]) if len(sys.argv) > 2 else 8]:
+        b = i["bbox"]
