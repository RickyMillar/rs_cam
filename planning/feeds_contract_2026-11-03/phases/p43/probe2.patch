+#[allow(clippy::all, clippy::pedantic, clippy::print_stderr, reason = "temporary probe")]
+fn p43_stage(tag: &str, z_level: f64, region_idx: usize, segs: &[crate::adaptive::AdaptiveSegment]) {
+    if std::env::var("P43PROBE").is_err() { return; }
+    // The least X of a cut point, a link point and a rapid point in the window y 205..240 (setup frame).
+    let (mut cut, mut link, mut rapid) = (f64::INFINITY, f64::INFINITY, f64::INFINITY);
+    let (mut ncut, mut on_edge) = (0usize, 0usize);
+    for s in segs {
+        match s {
+            crate::adaptive::AdaptiveSegment::Cut(path) => for p in path { if p.y > 205.0 && p.y < 240.0 { cut = cut.min(p.x); ncut += 1; if p.x < 34.9 { on_edge += 1; } } },
+            crate::adaptive::AdaptiveSegment::Link(p) => if p.y > 205.0 && p.y < 240.0 { link = link.min(p.x); },
+            crate::adaptive::AdaptiveSegment::Rapid(p) => if p.y > 205.0 && p.y < 240.0 { rapid = rapid.min(p.x); },
+            _ => {}
+        }
+    }
+    eprintln!("P43 stage {tag} z {z_level:.3} region {region_idx}: least x in window: cut {cut:.3} link {link:.3} rapid {rapid:.3}; cut points {ncut}, of them x < 34.9: {on_edge}");
+}
+
+#[allow(clippy::all, clippy::pedantic, clippy::print_stderr, reason = "temporary probe")]
+fn p43_probe(tag: &str, ctx: &ClearZLevelContext<'_>, stock: &TriDexelStock, surface_hm: &SurfaceHeightmap, z_level: f64, regions: &[crate::polygon::Polygon2]) {
+    if std::env::var("P43PROBE").is_err() { return; }
+    let g = &stock.z_grid;
+    eprintln!("P43 {tag} z {z_level:.3} grid origin ({:.3},{:.3}) cell {} rows {} cols {}", g.origin_u, g.origin_v, g.cell_size, g.rows, g.cols);
+    let row = ((221.5 - g.origin_v) / g.cell_size).round() as usize;
+    let mut line = String::new();
+    for col in 0..g.cols {
+        let (x, y) = g.cell_to_world(row, col);
+        if x > 22.0 && x < 42.0 {
+            line += &format!(" [x {:.2} y {:.2} top {:.3} surf {:.3} mat {}]", x, y, super::stock_top_z_at(stock, row, col), surface_hm.z_or_bbox_floor_at(row, col), cell_has_material(stock, surface_hm, row, col, z_level, ctx.stock_to_leave));
+        }
+    }
+    eprintln!("P43 {tag} z {z_level:.3} row:{line}");
+    for (k, r) in regions.iter().enumerate() {
+        let pts: Vec<String> = r.exterior.iter().filter(|p| p.x < 42.0 && p.y > 205.0 && p.y < 240.0).map(|p| format!("({:.2},{:.2})", p.x, p.y)).collect();
+        eprintln!("P43 {tag} z {z_level:.3} region {k} raw pts {}", pts.join(" "));
+    }
+}
