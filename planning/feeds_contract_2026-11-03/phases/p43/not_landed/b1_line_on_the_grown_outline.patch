+#[test]
+fn p43_explore() {
+    for shelf_z in [0.0, 2.0, 4.5, 7.5] {
+        let off = wall_fixture_p43(OnePassHold::Off, shelf_z);
+        let on = wall_fixture_p43(
+            OnePassHold::FreshStock {
+                link_kinematics: None,
+            },
+            shelf_z,
+        );
+        println!("P43 explore shelf {shelf_z}: off {off:?} on {on:?}");
+    }
+}
