+/// P38 fixture: a rest stock on a flat floor (Z 0). A block of 20 x 24 mm
+/// stands 3 mm tall. A rib 1.5 mm wide stands 12 mm tall across it (when
+/// `rib`). Cell 0.5 mm, tool 6.35 mm, Depth/Pass 3 mm, stock to leave 0.5,
+/// stay-down clearance 0.5.
+///
+/// The levels are 9, 6, 3 and 0.5. At 9, 6 and 3 the rib is the only
+/// material: a region of 36 mm2, under the small-region bound (152.4 mm2),
+/// so each level drops it. At 0.5 the block is a region of 480 mm2 that
+/// holds the rib.
+///
+/// Returns the deepest simulated axial depth of a sample (mm) and the
+/// record of the plan.
+fn deepest_cut_on_rib_fixture(rib: bool) -> (f64, Option<LeftStock>) {
+    deepest_cut_on_rib_fixture_with(rib, ClearingStrategy3d::GeodesicAdaptive)
+}
+
+/// [`deepest_cut_on_rib_fixture`] with the strategy named. Geodesic Adaptive
+/// goes through `LevelSink::emit`, Contour Parallel through
+/// `push_segment_with_stamp`: the two doors of the rule.
+fn deepest_cut_on_rib_fixture_with(
+    rib: bool,
+    strategy: ClearingStrategy3d,
+) -> (f64, Option<LeftStock>) {
+    let mesh = crate::mesh::make_test_flat(60.0);
+    let si = SpatialIndex::build(&mesh, 10.0);
+    let cutter = flat_cutter();
+    let (cell, n) = (0.5, 121usize);
+    let mut tops = vec![0.0f64; n * n];
+    for row in 0..n {
+        for col in 0..n {
+            let (x, y) = (-30.0 + col as f64 * cell, -30.0 + row as f64 * cell);
+            if (5.0..=25.0).contains(&x) && (-12.0..=12.0).contains(&y) {
+                tops[row * n + col] = if rib && (13.0..=14.5).contains(&x) {
+                    12.0
+                } else {
+                    3.0
+                };
+            }
+        }
+    }
+    let stock = make_stock_with_cells(n, n, -30.0, -30.0, cell, -10.0, &tops);
+    let mut params = default_params();
+    params.clearing_strategy = strategy;
+    params.depth.stock_top_z = if rib { 12.0 } else { 3.0 };
+    params.initial_stock = Some(stock.clone());
+    let out =
+        adaptive_3d_toolpath_output_with_cancel(&mesh, &si, &cutter, &params, &|| false, None)
+            .expect("not cancelled");
+    let mut sim_stock = stock;
+    let samples = sim_stock
+        .simulate_toolpath_with_metrics_with_cancel(
+            &out.toolpath,
+            &cutter,
+            StockCutDirection::FromTop,
+            ToolpathId::from_raw(0),
+            12_000,
+            2,
+            3000.0,
+            0.5,
+            None,
+            &[],
+            &[],
+            false,
+            &|| false,
+        )
+        .expect("the simulation is not cancelled");
+    let deepest = samples.iter().map(|s| s.axial_doc_mm).fold(0.0, f64::max);
+    (deepest, out.left_stock)
+}
+
+/// P38 (prediction P-6): no simulated sample of a 3D Rough cuts deeper than
+/// one Depth/Pass plus the stay-down clearance, also where the levels above
+/// left stock. The rib of the fixture stands 11.5 mm above the floor of the
+/// last level; before the rule the last level cut it at that depth. The
+/// operation states the stock that it kept off.
+#[test]
+fn a_level_does_not_cut_what_the_levels_above_left_p38() {
+    let (deepest, left) = deepest_cut_on_rib_fixture(true);
+    let limit = 3.0 + 0.5;
+    assert!(
+        deepest <= limit + 1e-6,
+        "a sample cuts {deepest:.2} mm deep; one Depth/Pass and the clearance are {limit} mm"
+    );
+    let left = left.expect("the plan dropped the rib and kept off it");
+    assert!(left.small_regions >= 1, "{left:?}");
+    assert!(left.kept_off_moves >= 1, "{left:?}");
+    assert!(left.stands(), "{left:?}");
+    // The rib: 4 cells x 49 cells of 0.25 mm2 at most; the tool must have
+    // met a part of it.
+    assert!(
+        left.kept_off_area_mm2 > 0.0 && left.kept_off_area_mm2 <= 49.0,
+        "{left:?}"
+    );
+    // 12 mm of stock above the cutter of the last level (Z 0.5).
+    assert!((left.kept_off_tallest_mm - 11.5).abs() < 1e-3, "{left:?}");
+    let [x, _, z] = left.kept_off_at;
+    assert!(
+        (13.0..=14.5).contains(&x) && (z - 12.0).abs() < 1e-3,
+        "{left:?}"
+    );
+}
+
+/// P38: a plan that meets no such stock keeps no move off, and it cuts the
+/// block (the control of the fixture).
+#[test]
+fn a_plan_with_one_pass_of_stock_keeps_no_move_off_p38() {
+    let (deepest, left) = deepest_cut_on_rib_fixture(false);
+    assert!(
+        (2.0..=3.5).contains(&deepest),
+        "the block is one pass deep: {deepest:.2}"
+    );
+    assert!(left.is_none_or(|l| l.kept_off_moves == 0), "{left:?}");
+}
+
+/// P38: the rule holds at the second segment door too. Contour Parallel has
+/// no small-region bound of its own, so the control states what it cuts: if
+/// it cuts the rib level by level, no sample is deep and no move is kept
+/// off; if a level leaves the rib, the rule keeps the tool off it. In both
+/// cases no sample is deeper than one Depth/Pass plus the clearance.
+#[test]
+fn contour_parallel_holds_one_pass_at_its_door_p38() {
+    let (deepest, left) =
+        deepest_cut_on_rib_fixture_with(true, ClearingStrategy3d::ContourParallel);
+    let limit = 3.0 + 0.5;
+    assert!(
+        deepest <= limit + 1e-6,
+        "a sample cuts {deepest:.2} mm deep; one Depth/Pass and the clearance are {limit} mm \
+         ({left:?})"
+    );
+}
