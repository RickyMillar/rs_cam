diff --git a/crates/rs_cam_core/src/adaptive3d/one_pass.rs b/crates/rs_cam_core/src/adaptive3d/one_pass.rs
new file mode 100644
index 000000000..51611fb59
--- /dev/null
+++ b/crates/rs_cam_core/src/adaptive3d/one_pass.rs
@@ -0,0 +1,418 @@
+//! P38: no fed move of a 3D Rough meets stock that stands more than one
+//! Depth/Pass above the cutter.
+//!
+//! A level cuts one Depth/Pass only where every level above it cut its own.
+//! Where a level above left stock (a dropped region, a dropped cut group, a
+//! strip that made no region, the stock of an earlier operation), the level
+//! below met that stock at its full height: on the Wanaka back, 20.7 mm with
+//! a stated Depth/Pass of 6 mm.
+//!
+//! [`clip_to_one_pass`] is the rule, at the one door of every planned
+//! segment (`push_segment_with_stamp`, `LevelSink::emit`), after the
+//! boundary clip and before the stamp:
+//!
+//! - A point of a cut is kept off when a planner cell under the tool disc
+//!   stands more than [`OnePass::limit_mm`] above the cutter there. The cut
+//!   goes out as the pieces between such points, each with its own entry.
+//! - A link whose chord meets such stock becomes an entry at its end. An
+//!   entry whose own disc meets such stock is not made.
+//! - Each cell that kept a move off is recorded ([`KeptOff`]). The plan
+//!   reads the record at its end (`left_stock`), and the operation states
+//!   the stock in `geom.rough_left_stock`.
+//!
+//! The rule removes cut and link moves; it adds none. A plan that meets no
+//! such stock is the same plan: its segments pass unchanged. A cut that the
+//! rule splits gets one entry for each kept piece, so the plan can hold more
+//! entries. The rule reads an entry at its own column only, as the planner
+//! models it (a vertical descent, G-SIMCORE); the legs of a shipped ramp
+//! are not read here (P38 section 5.3).
+//!
+//! The resolution: the read is on the planner cells. A strip narrower than
+//! one cell at the edge of the disc can be outside the read.
+//!
+//! The read is the cell centres inside the tool disc, not the conservative
+//! disc top. A centre the planner takes has no model above the cutter
+//! inside the disc (the drop-cutter floor), so a column that reads tall
+//! there is stock. A read past the disc would count the part beside a wall.
+//!
+//! P40 B (prototype, NOT LANDED): the read of the disc edge is STRICT. A
+//! cell counts when its centre is at least half a cell inside the edge of
+//! the disc ([`edge_inset_mm`]): the tool then covers the cell to its far
+//! side along the radius. A cell whose centre is nearer to the edge holds
+//! the edge of the disc. Beside a wall of the model that cell is the wall
+//! line: the stamp lowers it by its covered part only, so it stands tall
+//! at each level below, and the read of P38 (`d_sq > r_sq`) kept every
+//! move off that is tangent to a wall from the second level on.
+//!
+//! `P40_ONE_PASS_READ=coverage` (a probe switch of the prototype) reads
+//! each cell with a centre inside the disc at its covered part times its
+//! height above the cutter: the quantity that the simulation reports as
+//! the depth of a sample (`dexel_stock/stamping.rs`: the blend of a cell by
+//! its coverage, `max_penetration`).
+
+use std::cell::RefCell;
+
+use crate::dexel_stock::TriDexelStock;
+use crate::geo::P3;
+use crate::stock::radial_profile::RadialProfileLUT;
+
+use super::clearing::PlannerCursor;
+use super::path::Adaptive3dSegment;
+use super::stock_top_z_at;
+
+/// A piece shorter than this in XY is not cut.
+const MIN_PIECE_MM: f64 = 1e-6;
+
+/// The rule of one operation and its record.
+pub(super) struct OnePass {
+    /// One Depth/Pass plus the stay-down clearance (the dexel allowance):
+    /// the bound of a `deep` step (`StepSplit::StockDepth`, D43).
+    pub(super) limit_mm: f64,
+    pub(super) kept_off: RefCell<KeptOff>,
+}
+
+impl OnePass {
+    pub(super) fn new(depth_per_pass: f64, stay_down_clearance_mm: f64) -> Self {
+        Self {
+            limit_mm: depth_per_pass + stay_down_clearance_mm.max(0.0),
+            kept_off: RefCell::new(KeptOff::default()),
+        }
+    }
+}
+
+/// The cells that kept a move off, each with the lowest cutter Z a move
+/// would have had there.
+#[derive(Debug, Default)]
+pub(super) struct KeptOff {
+    /// Row-major on the planner grid; `NAN`: the cell kept no move off.
+    /// Empty until the first record.
+    cutter_z: Vec<f32>,
+    cols: usize,
+    /// The moves the rule did not make: each piece of a cut between two
+    /// kept pieces, each link, each entry.
+    pub(super) moves: usize,
+}
+
+impl KeptOff {
+    fn record(&mut self, stock: &TriDexelStock, row: usize, col: usize, cutter_z: f64) {
+        let grid = &stock.z_grid;
+        if self.cutter_z.is_empty() {
+            self.cutter_z = vec![f32::NAN; grid.rows * grid.cols];
+            self.cols = grid.cols;
+        }
+        if let Some(slot) = self.cutter_z.get_mut(row * grid.cols + col) {
+            *slot = if slot.is_nan() {
+                cutter_z as f32
+            } else {
+                slot.min(cutter_z as f32)
+            };
+        }
+    }
+
+    /// Each recorded cell: `(row, col, cutter Z)`.
+    pub(super) fn cells(&self) -> impl Iterator<Item = (usize, usize, f64)> + '_ {
+        let cols = self.cols.max(1);
+        self.cutter_z
+            .iter()
+            .enumerate()
+            .filter(|(_, z)| !z.is_nan())
+            .map(move |(i, z)| (i / cols, i % cols, f64::from(*z)))
+    }
+}
+
+/// The tool of the read: its radial profile and its radius.
+#[derive(Clone, Copy)]
+pub(super) struct PassTool<'a> {
+    pub(super) lut: &'a RadialProfileLUT,
+    pub(super) radius: f64,
+}
+
+/// The most that a planner cell under the disc of the tool at `p` stands
+/// above the cutter there (mm), read on the cell centres inside the disc.
+/// `NEG_INFINITY`: no cell is under the disc.
+pub(super) fn stock_over_cutter(stock: &TriDexelStock, tool: PassTool<'_>, p: P3) -> f64 {
+    let mut worst = f64::NEG_INFINITY;
+    for_each_cell_over(stock, tool, p, f64::NEG_INFINITY, |_, _, over, _| {
+        worst = worst.max(over);
+    });
+    worst
+}
+
+/// P40 B: the inset of the strict read from the edge of the disc (mm): half
+/// a cell, the distance from a cell centre to its side.
+fn edge_inset_mm(cell_size: f64) -> f64 {
+    0.5 * cell_size
+}
+
+/// P40 B probe switch: read a cell at its covered part times its height.
+fn coverage_read() -> bool {
+    static MODE: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *MODE.get_or_init(|| std::env::var("P40_ONE_PASS_READ").is_ok_and(|v| v == "coverage"))
+}
+
+/// The part of the square cell at offset `(du, dv)` from the tool axis that
+/// lies inside the disc of `r_sq`, on the 4 x 4 sub-samples of the stamp
+/// (`dexel_stock::stamping::point_cell_coverage`: offsets of 1/8 and 3/8 of
+/// a cell).
+fn covered_part(du: f64, dv: f64, r_sq: f64, cs: f64) -> f64 {
+    const OFFSETS: [f64; 4] = [-3.0 / 8.0, -1.0 / 8.0, 1.0 / 8.0, 3.0 / 8.0];
+    let mut inside = 0_u32;
+    for v in OFFSETS {
+        for u in OFFSETS {
+            let (px, py) = (du + u * cs, dv + v * cs);
+            if px * px + py * py <= r_sq {
+                inside += 1;
+            }
+        }
+    }
+    f64::from(inside) / 16.0
+}
+
+/// Call `f(row, col, over, cutter_z)` for each cell centre inside the disc
+/// of the tool at `p` that stands more than `above` over the cutter there.
+fn for_each_cell_over(
+    stock: &TriDexelStock,
+    tool: PassTool<'_>,
+    p: P3,
+    above: f64,
+    mut f: impl FnMut(usize, usize, f64, f64),
+) {
+    let grid = &stock.z_grid;
+    let cs = grid.cell_size;
+    if cs <= 0.0 || tool.radius < 0.0 {
+        return;
+    }
+    let index = |v: f64, n: usize| -> Option<usize> {
+        #[expect(
+            clippy::cast_possible_truncation,
+            clippy::cast_sign_loss,
+            reason = "checked finite, floored at 0 and clamped to the grid"
+        )]
+        let i = v.max(0.0) as usize;
+        (v.is_finite() && n > 0).then(|| i.min(n - 1))
+    };
+    let (Some(c0), Some(c1), Some(r0), Some(r1)) = (
+        index(
+            ((p.x - tool.radius - grid.origin_u) / cs).floor(),
+            grid.cols,
+        ),
+        index(((p.x + tool.radius - grid.origin_u) / cs).ceil(), grid.cols),
+        index(
+            ((p.y - tool.radius - grid.origin_v) / cs).floor(),
+            grid.rows,
+        ),
+        index(((p.y + tool.radius - grid.origin_v) / cs).ceil(), grid.rows),
+    ) else {
+        return;
+    };
+    let r_sq = tool.radius * tool.radius;
+    let weighted = coverage_read();
+    // The strict read: a centre at least half a cell inside the edge.
+    let strict = (tool.radius - edge_inset_mm(cs)).max(0.0);
+    let read_sq = if weighted { r_sq } else { strict * strict };
+    for row in r0..=r1 {
+        for col in c0..=c1 {
+            let (cx, cy) = grid.cell_to_world(row, col);
+            let d_sq = (cx - p.x).powi(2) + (cy - p.y).powi(2);
+            if d_sq > read_sq {
+                continue;
+            }
+            let Some(h) = tool.lut.height_at_dist_sq(d_sq) else {
+                continue;
+            };
+            let cutter_z = p.z + h;
+            let height = stock_top_z_at(stock, row, col) - cutter_z;
+            let over = if weighted {
+                covered_part(cx - p.x, cy - p.y, r_sq, cs) * height
+            } else {
+                height
+            };
+            if over > above {
+                f(row, col, over, cutter_z);
+            }
+        }
+    }
+}
+
+/// True when the tool at `p` meets stock over the limit. With `record`,
+/// each such cell goes into the record.
+fn kept_off_at(
+    rule: &OnePass,
+    stock: &TriDexelStock,
+    tool: PassTool<'_>,
+    p: P3,
+    record: bool,
+) -> bool {
+    if !record {
+        return stock_over_cutter(stock, tool, p) > rule.limit_mm;
+    }
+    let mut any = false;
+    let mut kept_off = rule.kept_off.borrow_mut();
+    for_each_cell_over(stock, tool, p, rule.limit_mm, |row, col, _, cutter_z| {
+        any = true;
+        kept_off.record(stock, row, col, cutter_z);
+    });
+    any
+}
+
+/// One read point of a cut: a vertex of the path, or a point on a chord.
+struct Sample {
+    p: P3,
+    vertex: bool,
+    off: bool,
+}
+
+/// The read points of `path`: each vertex, and points at most one planner
+/// cell apart on each chord.
+fn samples(rule: &OnePass, stock: &TriDexelStock, tool: PassTool<'_>, path: &[P3]) -> Vec<Sample> {
+    let cell = stock.z_grid.cell_size.max(1e-3);
+    let mut out: Vec<Sample> = Vec::with_capacity(path.len());
+    let mut push = |p: P3, vertex: bool| {
+        out.push(Sample {
+            p,
+            vertex,
+            off: kept_off_at(rule, stock, tool, p, true),
+        });
+    };
+    if let Some(first) = path.first() {
+        push(*first, true);
+    }
+    for pair in path.windows(2) {
+        let [a, b] = pair else { continue };
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        let n = crate::util::steps::steps(len, cell).unwrap_or(1).max(1);
+        for k in 1..=n {
+            let t = k as f64 / n as f64;
+            push(
+                P3::new(
+                    a.x + t * (b.x - a.x),
+                    a.y + t * (b.y - a.y),
+                    a.z + t * (b.z - a.z),
+                ),
+                k == n,
+            );
+        }
+    }
+    out
+}
+
+/// The pieces of a cut between its kept-off points: each run of read points
+/// the rule keeps, as its first point, the vertices inside it and its last
+/// point. Returns the pieces, whether the first starts at the start of the
+/// path, and whether the last ends at its end.
+fn kept_pieces(samples: &[Sample]) -> (Vec<Vec<P3>>, bool, bool) {
+    let mut pieces: Vec<Vec<P3>> = Vec::new();
+    let mut current: Vec<P3> = Vec::new();
+    let mut last: Option<P3> = None;
+    let mut close = |current: &mut Vec<P3>, last: &mut Option<P3>| {
+        if let Some(end) = last.take()
+            && current.last() != Some(&end)
+        {
+            current.push(end);
+        }
+        let length: f64 = current
+            .windows(2)
+            .map(|w| match w {
+                [a, b] => (b.x - a.x).hypot(b.y - a.y) + (b.z - a.z).abs(),
+                _ => 0.0,
+            })
+            .sum();
+        if current.len() >= 2 && length > MIN_PIECE_MM {
+            pieces.push(std::mem::take(current));
+        } else {
+            current.clear();
+        }
+    };
+    for s in samples {
+        if s.off {
+            close(&mut current, &mut last);
+            continue;
+        }
+        if current.is_empty() || s.vertex {
+            current.push(s.p);
+            last = None;
+        } else {
+            last = Some(s.p);
+        }
+    }
+    close(&mut current, &mut last);
+    let first_is_start = samples.first().is_some_and(|s| !s.off)
+        && pieces.first().and_then(|p| p.first()) == samples.first().map(|s| &s.p);
+    let last_is_end = samples.last().is_some_and(|s| !s.off)
+        && pieces.last().and_then(|p| p.last()) == samples.last().map(|s| &s.p);
+    (pieces, first_is_start, last_is_end)
+}
+
+/// The rule on one segment (see the module text). `cursor.pass_gap` says
+/// that the rule dropped the move before this one, so the tool is not where
+/// this segment starts and its first piece needs an entry.
+pub(super) fn clip_to_one_pass(
+    rule: &OnePass,
+    stock: &TriDexelStock,
+    tool: PassTool<'_>,
+    cursor: &mut PlannerCursor,
+    segment: Adaptive3dSegment,
+) -> Vec<Adaptive3dSegment> {
+    match segment {
+        Adaptive3dSegment::Marker(_) => vec![segment],
+        Adaptive3dSegment::Rapid(entry) | Adaptive3dSegment::RapidWithFloor { entry, .. } => {
+            if kept_off_at(rule, stock, tool, entry, true) {
+                rule.kept_off.borrow_mut().moves += 1;
+                cursor.pass_gap = true;
+                Vec::new()
+            } else {
+                cursor.pass_gap = false;
+                vec![segment]
+            }
+        }
+        Adaptive3dSegment::Link(target) => {
+            let chord_free = !cursor.pass_gap
+                && cursor.last_pos.is_some_and(|from| {
+                    samples(rule, stock, tool, &[from, target])
+                        .iter()
+                        .all(|s| !s.off)
+                });
+            if chord_free {
+                return vec![segment];
+            }
+            rule.kept_off.borrow_mut().moves += 1;
+            if kept_off_at(rule, stock, tool, target, false) {
+                cursor.pass_gap = true;
+                Vec::new()
+            } else {
+                cursor.pass_gap = false;
+                vec![Adaptive3dSegment::Rapid(target)]
+            }
+        }
+        Adaptive3dSegment::Cut(ref path) if path.len() < 2 => vec![segment],
+        Adaptive3dSegment::Cut(path) => {
+            let read = samples(rule, stock, tool, &path);
+            if !cursor.pass_gap && read.iter().all(|s| !s.off) {
+                return vec![Adaptive3dSegment::Cut(path)];
+            }
+            let (pieces, first_is_start, last_is_end) = kept_pieces(&read);
+            let off_runs = read
+                .iter()
+                .zip(std::iter::once(false).chain(read.iter().map(|s| s.off)))
+                .filter(|(s, before)| s.off && !before)
+                .count();
+            rule.kept_off.borrow_mut().moves += off_runs;
+            if pieces.is_empty() {
+                cursor.pass_gap = true;
+                return Vec::new();
+            }
+            let continues = first_is_start && !cursor.pass_gap;
+            let mut out: Vec<Adaptive3dSegment> = Vec::with_capacity(pieces.len() * 2);
+            for (i, piece) in pieces.into_iter().enumerate() {
+                if (i > 0 || !continues)
+                    && let Some(first) = piece.first()
+                {
+                    out.push(Adaptive3dSegment::Rapid(*first));
+                }
+                out.push(Adaptive3dSegment::Cut(piece));
+            }
+            cursor.pass_gap = !last_is_end;
+            out
+        }
+    }
+}
