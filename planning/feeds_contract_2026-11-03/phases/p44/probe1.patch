+/// P44 probe (prints only; not for the product): env `P44PROBE` = an output folder.
+#[allow(clippy::all, clippy::pedantic, clippy::restriction, reason = "temporary probe")]
+pub(super) mod p44 {
+    use std::io::Write;
+    thread_local! {
+        pub static BITS: std::cell::RefCell<Vec<u8>> = const { std::cell::RefCell::new(Vec::new()) };
+        pub static SEQ: std::cell::Cell<usize> = const { std::cell::Cell::new(0) };
+    }
+    static NEXT: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(1);
+    pub fn dir() -> Option<String> { std::env::var("P44PROBE").ok() }
+    pub fn on() -> bool { dir().is_some() }
+    pub fn next_seq() -> usize { let n = NEXT.fetch_add(1, std::sync::atomic::Ordering::SeqCst); SEQ.with(|s| s.set(n)); n }
+    pub fn seq() -> usize { SEQ.with(|s| s.get()) }
+    pub fn line(text: String) {
+        let Some(d) = dir() else { return };
+        if let Ok(mut f) = std::fs::OpenOptions::new().create(true).append(true).open(format!("{d}/probe.log")) {
+            let _ = writeln!(f, "{text}");
+        }
+    }
+    pub fn bytes(name: &str, data: &[u8]) {
+        let Some(d) = dir() else { return };
+        let _ = std::fs::write(format!("{d}/{name}"), data);
+    }
+    pub fn bbox(poly: &crate::polygon::Polygon2) -> String {
+        let (mut x0, mut y0, mut x1, mut y1) = (f64::INFINITY, f64::INFINITY, f64::NEG_INFINITY, f64::NEG_INFINITY);
+        for p in &poly.exterior { x0 = x0.min(p.x); y0 = y0.min(p.y); x1 = x1.max(p.x); y1 = y1.max(p.y); }
+        format!("{x0:.2} {y0:.2} {x1:.2} {y1:.2}")
+    }
+    pub fn stock(radius: f64, stock: &crate::dexel_stock::TriDexelStock, hm: &crate::surface::slope::SurfaceHeightmap) {
+        if !on() { return; }
+        let g = &stock.z_grid;
+        let mut top = Vec::with_capacity(g.rows * g.cols * 4);
+        let mut floor = Vec::with_capacity(g.rows * g.cols * 4);
+        for row in 0..g.rows { for col in 0..g.cols {
+            top.extend_from_slice(&(super::super::stock_top_z_at(stock, row, col) as f32).to_le_bytes());
+            floor.extend_from_slice(&(hm.z_or_bbox_floor_at(row, col) as f32).to_le_bytes());
+        } }
+        bytes(&format!("r{radius:.1}_stocktop.f32"), &top);
+        bytes(&format!("r{radius:.1}_floor.f32"), &floor);
+        line(format!("final r {radius:.3} rows {} cols {} origin {:.4} {:.4} cell {:.5}", g.rows, g.cols, g.origin_u, g.origin_v, g.cell_size));
+    }
+}
