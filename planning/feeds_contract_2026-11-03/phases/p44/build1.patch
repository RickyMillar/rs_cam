+                    for dc in [-1isize, 0, 1] {
+                        let (Some(r2), Some(c2)) = (
+                            row.checked_add_signed(dr).filter(|&v| v < rows),
+                            col.checked_add_signed(dc).filter(|&v| v < cols),
+                        ) else {
+                            continue;
+                        };
