+    out: &mut LeftStock,
+    standing: &super::standing::Standing,
+    cell_why: &[Option<LeftWhy>],
+    held: &super::one_pass::HeldOff,
+    limit_mm: f64,
+    stock: &TriDexelStock,
+    tool_radius: f64,
