+        min_factor: 1.0,
+        ..LevelContourStats::default()
+    };
+    if !ctx.one_pass.on {
+        return none;
+    }
+    #[cfg(test)]
+    if REGION_CONTOUR_OFF_FOR_CONTROL.with(std::cell::Cell::get) {
+        return none;
+    }
