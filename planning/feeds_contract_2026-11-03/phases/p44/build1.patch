+/// P44 fixture (H4): the wall of the P42 fixture (X 10, top Z 9) and a rest
+/// stock where a larger tool left a strip 2 mm wide and 6 mm tall at the
+/// foot of the wall (X 8..10, Y -10..10). A block 3 mm tall stands away
+/// from the wall (X -20..-5), so that the plan has a level. No tool centre
+/// can stand over the strip (the tool-centre limit is X 6.825), so the
+/// strip makes no region at any level.
+///
+/// Returns the deepest simulated sample, the highest stock in the strip on
+/// the line Y 0 between X 8.0 and 9.4 after the simulation, and the record.
+fn wall_strip_fixture_p44() -> (f64, f64, Option<LeftStock>) {
+    let (wall_x, wall_top) = (10.0, 9.0);
+    let vertices = vec![
+        P3::new(-40.0, -40.0, 0.0),
+        P3::new(wall_x, -40.0, 0.0),
+        P3::new(wall_x, 40.0, 0.0),
+        P3::new(-40.0, 40.0, 0.0),
+        P3::new(wall_x, -40.0, wall_top),
+        P3::new(wall_x, 40.0, wall_top),
+        P3::new(40.0, -40.0, wall_top),
+        P3::new(40.0, 40.0, wall_top),
+    ];
+    let triangles = vec![
+        [0, 1, 2],
+        [0, 2, 3],
+        [1, 4, 5],
+        [1, 5, 2],
+        [4, 6, 7],
+        [4, 7, 5],
+    ];
+    let mesh = TriangleMesh::from_raw(vertices, triangles);
+    let si = SpatialIndex::build(&mesh, 10.0);
+    let cutter = flat_cutter();
+    let (cell, n) = (0.2, 351usize);
+    let mut tops = vec![0.0f64; n * n];
+    for row in 0..n {
+        for col in 0..n {
+            let (x, y) = (-35.0 + col as f64 * cell, -35.0 + row as f64 * cell);
+            tops[row * n + col] = if x > wall_x {
+                wall_top
+            } else if x >= 8.0 - 1e-9 && (-10.0..=10.0).contains(&y) {
+                6.0
+            } else if (-20.0..=-5.0).contains(&x) && (-12.0..=12.0).contains(&y) {
+                3.0
+            } else {
+                0.0
+            };
+        }
+    }
+    let stock = make_stock_with_cells(n, n, -35.0, -35.0, cell, -10.0, &tops);
+    let mut params = default_params();
+    params.clearing_strategy = ClearingStrategy3d::GeodesicAdaptive;
+    params.linking.one_pass_hold = OnePassHold::RemainingStock {
+        link_kinematics: None,
+    };
+    params.depth.stock_top_z = 9.0;
+    params.initial_stock = Some(stock.clone());
+    let out =
+        adaptive_3d_toolpath_output_with_cancel(&mesh, &si, &cutter, &params, &|| false, None)
+            .expect("not cancelled");
+    let mut sim_stock = stock;
+    let samples = sim_stock
+        .simulate_toolpath_with_metrics_with_cancel(
+            &out.toolpath,
+            &cutter,
+            StockCutDirection::FromTop,
+            ToolpathId::from_raw(0),
+            12_000,
+            2,
+            3000.0,
+            0.5,
+            None,
+            &[],
+            &[],
+            false,
+            &|| false,
+        )
+        .expect("the simulation is not cancelled");
+    let deepest = samples
+        .iter()
+        .map(|s| s.axial_engagement_mm)
+        .fold(0.0, f64::max);
+    let row = 175; // Y 0
+    let highest = (0..n)
+        .filter(|&col| (8.0..=9.4).contains(&(-35.0 + col as f64 * cell)))
+        .map(|col| stock_top_z_at(&sim_stock, row, col))
+        .fold(f64::NEG_INFINITY, f64::max);
+    (deepest, highest, out.left_stock)
+}
+
+/// P44 (H4): a rough on remaining stock cuts the strip that stands beside a
+/// wall where no region of a level holds it (`level_contour::strip_pass`),
+/// one Depth/Pass per round. The contour runs one planner cell plus the cut
+/// tolerance inside the tool-centre limit, so the tool reaches X 9.7; the
+/// read is to X 9.4. The control (no strip pass): the strip keeps its 6 mm.
+#[test]
+fn a_strip_beside_a_wall_with_no_region_is_cut_p44() {
+    let (deepest, highest, left) = wall_strip_fixture_p44();
+    assert!(
