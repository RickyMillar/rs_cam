+                polygon_rings(&band)
+                    .map(|ring| {
+                        ring.iter()
+                            .zip(ring.iter().cycle().skip(1))
+                            .map(|(a, b)| (b.x - a.x).hypot(b.y - a.y))
+                            .sum::<f64>()
+                    })
+                    .sum()
+            };
+            if length >= ctx.min_region_cut_length_mm {
+                continue;
+            }
+            dropped += 1;
