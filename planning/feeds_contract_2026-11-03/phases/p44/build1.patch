+    ctx: &ClearZLevelContext<'_>,
+    material_stock: &mut TriDexelStock,
+    surface_hm: &SurfaceHeightmap,
+    level: WallLevel,
+    regions: &[&crate::polygon::Polygon2],
+    segments: &mut Vec<Adaptive3dSegment>,
+    cursor: &mut PlannerCursor,
