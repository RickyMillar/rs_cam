+        "{none:?}"
+    );
+    assert_eq!(none.standing_pieces, 0, "{none:?}");
+    assert!(
+        !none.stands(),
+        "no drop record: the finding is not raised: {none:?}"
+    );
+    // The dropped piece covers strip A: strip A is a named place, and the
+    // finding is raised. Strip B stays in the sum.
