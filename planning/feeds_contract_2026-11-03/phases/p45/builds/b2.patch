+                {
+                    let (x, y) = grid.cell_to_world(row, col);
+                    if band.contains_point(&P2::new(x, y))
+                        && let Some(c) = standing
+                            .padded
+                            .get_mut((row + 1) * standing.padded_cols + (col + 1))
+                    {
+                        *c = false;
+                    }
+                }
