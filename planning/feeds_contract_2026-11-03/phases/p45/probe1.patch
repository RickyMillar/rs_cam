+/// P45 probe only: the planner stock as rows, cols, origin, cell, then the
+/// ray top and the conservative top of each cell.
+fn p45_dump_stock(stock: &TriDexelStock, path: &str) {
+    let g = &stock.z_grid;
+    let mut b: Vec<u8> = Vec::new();
+    b.extend((g.rows as u64).to_le_bytes());
+    b.extend((g.cols as u64).to_le_bytes());
+    b.extend(g.origin_u.to_le_bytes());
+    b.extend(g.origin_v.to_le_bytes());
+    b.extend(g.cell_size.to_le_bytes());
+    for row in 0..g.rows {
+        for col in 0..g.cols {
+            b.extend((stock_top_z_at(stock, row, col) as f32).to_le_bytes());
+        }
+    }
+    for row in 0..g.rows {
+        for col in 0..g.cols {
+            b.extend(g.conservative_top_at(row, col).to_le_bytes());
+        }
+    }
+    let _ = std::fs::write(path, b);
+}
