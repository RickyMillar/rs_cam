{"post_stream":{"posts":[{"id":78142,"name":"Donald Becker","username":"ADB8056","avatar_template":"/user_avatar/forum.sienci.com/adb8056/{size}/2973_2.png","created_at":"2026-04-10T15:03:37.245Z","cooked":"\u003cp\u003eI recently viewed a  Sienci video about their new MK3 Long Mill. Using a rather fancy testing device, they showed that the rigidity of the MK3 is anywhere from 60 to 80% greater than the MK2 versions. I have used my MK1 for over four years now and wonder if there is much of difference between the MK2 and the MK1 rigidity?\u003c/p\u003e","post_number":1,"post_type":1,"posts_count":2,"updated_at":"2026-04-10T15:03:37.245Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":13,"reads":41,"readers_count":40,"score":88.2,"yours":false,"topic_id":26150,"topic_slug":"longmill-rigidity","display_username":"Donald Becker","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":1246,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/longmill-rigidity/26150/1","reactions":[{"id":"+1","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_vote":false},{"id":78202,"name":"Donald Becker","username":"ADB8056","avatar_template":"/user_avatar/forum.sienci.com/adb8056/{size}/2973_2.png","created_at":"2026-04-11T17:48:30.783Z","cooked":"\u003cp\u003eA Google search led me to several production updates on Sienci’s blog as the various versions of the Longmill were rolled out. The MK2 was designed to be 2 to 3 times stronger than the MK1 and 50% more rigid. The MK 2.5 was not a structural change over the MK2 but the MK3 was designed to be 60 to 80% more rigid than the MK2.5.\u003c/p\u003e","post_number":2,"post_type":1,"posts_count":2,"updated_at":"2026-04-11T17:48:30.783Z","reply_count":0,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":0,"reads":22,"readers_count":21,"score":34.4,"yours":false,"topic_id":26150,"topic_slug":"longmill-rigidity","display_username":"Donald Becker","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":2}],"moderator":false,"admin":false,"staff":false,"user_id":1246,"hidden":false,"trust_level":2,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/longmill-rigidity/26150/2","reactions":[{"id":"+1","type":"emoji","count":2}],"current_user_reaction":null,"reaction_users_count":2,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null}],"stream":[78142,78202]},"timeline_lookup":[[1,209],[2,208]],"suggested_topics":[{"fancy_title":"Anyone traming your machine or jobs with software?","id":25275,"title":"Anyone traming your machine or jobs with software?","slug":"anyone-traming-your-machine-or-jobs-with-software","posts_count":7,"reply_count":5,"highest_post_number":7,"image_url":null,"created_at":"2025-12-25T15:20:13.992Z","last_posted_at":"2025-12-28T09:03:26.238Z","bumped":true,"bumped_at":"2025-12-28T09:03:26.238Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archive