+#[allow(clippy::unwrap_used)]
+pub mod psg_stash {
+    use std::sync::Mutex;
+    pub static PATHS: Mutex<Vec<(String, crate::toolpath::Toolpath)>> = Mutex::new(Vec::new());
+    pub static PLANNER: Mutex<Option<crate::dexel_stock::TriDexelStock>> = Mutex::new(None);
