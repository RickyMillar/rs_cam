+        std::env::var_os("PSG").is_some()
+    }
+    pub fn push(name: &str, tp: &crate::toolpath::Toolpath) {
+        if on() {
+            PATHS.lock().unwrap().push((name.to_owned(), tp.clone()));
+        }
+    }
+}
