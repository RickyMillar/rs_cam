+/// §16.9: the widest swept width (mm) of a feed move from `p` to `q` with
+/// a tool of `radius`, read on the 3D planner stock by the rule of the 2D
+/// `swept_width_on`: at each sample along the move (every half cell, as
+/// [`step_axial_depth`]), the grid cells inside the disc whose stock stands
+/// above the tool's Z there plus `clearance` (the dexel allowance), spread
+/// across the move's XY heading by this much. A cell the move has already
+/// passed over counts at most at the Z the tool passed it (an earlier
+/// sample within R cut it down to that Z, and no lower): a descent sweeps
+/// nothing below its own path, so the stock it descends into still
+/// counts. 0 for a move with no XY length (a pure rise or
+/// drop has no side width; its depth is [`step_axial_depth`]'s). Any
+/// strategy's draped cut can read it.
+pub(super) fn step_swept_width(
+    stock: &TriDexelStock,
+    p: P3,
+    q: P3,
+    radius: f64,
+    clearance: f64,
+) -> f64 {
+    let grid = &stock.z_grid;
+    let cs = grid.cell_size;
+    let (dx, dy) = (q.x - p.x, q.y - p.y);
+    let len = (dx * dx + dy * dy).sqrt();
+    if len < 1e-9 || cs <= 0.0 {
+        return 0.0;
+    }
+    let (ux, uy) = (dx / len, dy / len);
+    let (nx, ny) = (-uy, ux);
+    let n = (len / (cs * 0.5).max(1e-3)).ceil().max(1.0) as usize;
+    let r_sq = radius * radius;
+    let r_cells = (radius / cs).ceil() as isize;
+    let mut widest = 0.0_f64;
+    for k in 0..=n {
+        let t = k as f64 / n as f64;
+        let (x, y, z) = (p.x + dx * t, p.y + dy * t, p.z + t * (q.z - p.z));
+        let col0 = ((x - grid.origin_u) / cs).round() as isize;
+        let row0 = ((y - grid.origin_v) / cs).round() as isize;
+        let (mut lo, mut hi) = (f64::INFINITY, f64::NEG_INFINITY);
+        for row in (row0 - r_cells)..=(row0 + r_cells) {
+            for col in (col0 - r_cells)..=(col0 + r_cells) {
+                if row < 0 || col < 0 || row as usize >= grid.rows || col as usize >= grid.cols {
+                    continue;
+                }
+                let (cx, cy) = (
+                    grid.origin_u + col as f64 * cs,
+                    grid.origin_v + row as f64 * cs,
+                );
+                let (ex, ey) = (cx - x, cy - y);
+                if ex * ex + ey * ey > r_sq {
+                    continue;
+                }
+                // The cell's top after the earlier samples of this move: each
+                // one within R cut it down to its own Z.
+                let mut top = super::stock_top_z_at(stock, row as usize, col as usize);
+                for j in 0..k {
+                    let tj = j as f64 / n as f64;
+                    let (jx, jy) = (p.x + dx * tj, p.y + dy * tj);
+                    if (cx - jx).powi(2) + (cy - jy).powi(2) <= r_sq {
+                        top = top.min(p.z + tj * (q.z - p.z));
+                    }
+                }
+                if top <= z + clearance {
+                    continue;
+                }
+                let u = ex * nx + ey * ny;
+                lo = lo.min(u);
+                hi = hi.max(u);
+            }
+        }
+        if hi >= lo {
+            widest = widest.max(hi - lo);
+        }
+    }
+    widest
