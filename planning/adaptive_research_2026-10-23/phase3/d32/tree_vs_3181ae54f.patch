+            with exact readings; run by name with --ignored (§16.9 width read)"]
+fn the_width_read_splits_a_wide_draped_step() {
+    // The shelf: x from 12 to 30, y from -12 to 12, at Z 6.5: above the
+    // level (floor 4 + leave 0.5) by 2 mm, under the top by 3.5 mm.
+    let mesh = height_field(MESH_HALF, MESH_STEP, |x, y| {
+        if x.hypot(y) <= ISLAND_RADIUS {
+            TOP_Z
+        } else if (12.0..=30.0).contains(&x) && y.abs() <= 12.0 {
+            6.5
+        } else if x.abs() <= POCKET_HALF_X && y.abs() <= POCKET_HALF_Y {
+            FLOOR_Z
+        } else {
+            TOP_Z
+        }
+    });
+    let index = SpatialIndex::build(&mesh, 10.0);
+    let mut failures: Vec<String> = Vec::new();
+    let mut width_total = 0usize;
+    for (label, options) in [
+        ("geodesic_local_oneway", GeodesicOptions::C16_LOCAL_ONEWAY),
+        (
+            "geodesic_local_spiral_pick",
+            GeodesicOptions::C35_SPIRAL_PICK,
+        ),
+    ] {
+        let mut p = params(ClearingStrategy3d::Geodesic(options));
+        p.depth.depth_per_pass = TOP_Z - FLOOR_Z;
+        p.linking.step_split = Some(StepSplit::StockDepth);
+        p.linking.keep_down_route = Some(KeepDownRoute::Off);
+        let (out, research) = plan(&mesh, &index, &p);
+        let stats = research.split_stats;
+        eprintln!(
+            "{label} shelf: step split made {} (by width {}), avoided {}, max ap avoided {:.3} mm",
+            stats.made, stats.width_split, stats.avoided, stats.max_ap_avoided_mm
+        );
+        width_total += stats.width_split;
+        // The base: the same plan under the historical path-shape split.
+        let mut base = params(ClearingStrategy3d::Geodesic(options));
+        base.depth.depth_per_pass = TOP_Z - FLOOR_Z;
+        base.linking.step_split = Some(StepSplit::PathShape);
+        base.linking.keep_down_route = Some(KeepDownRoute::Off);
+        let (base_out, base_research) = plan(&mesh, &index, &base);
+        let base_r = read(&mesh, &base_out, &base_research.turns, false);
+        eprintln!(
+            "{label} shelf, path-shape base: {}",
+            summary(label, &base_r)
+        );
+        for line in &base_r.over {
+            eprintln!("  {label} base over: {line}");
+        }
+        let r = read(&mesh, &out, &research.turns, false);
+        eprintln!("{}", summary(label, &r));
+        for line in &r.screened {
+            eprintln!("  {label} screened: {line}");
+        }
+        for probe in &r.probes {
+            eprintln!("  {label} {probe}");
+        }
+        // The shelf over-loads under the historical rule too (G-FACESLAB:
+        // the 2D plan reads the shelf as stock in its slab, the 3D drape
+        // lifts the cut there). The stock-read split must add no over to
+        // the same plan under the path-shape split. Counted by MOVE: one
+        // place cut by one long move reads more samples than the same place
+        // cut by two short ones.
