+fn over_moves(lines: &[String]) -> usize {
+    lines
+        .iter()
+        .filter_map(|l| {
+            l.split_whitespace()
+                .nth(1)
+                .and_then(|n| n.parse::<usize>().ok())
+        })
+        .collect::<BTreeSet<usize>>()
+        .len()
+}
