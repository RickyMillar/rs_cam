+
+/// Research (§18.9): the load reads of one level under a field, and the
+/// reads over the pass ceiling, split by whether the cells the 2D grid holds
+/// as AIR (outside the plan's polygon) are needed to put them over.
+#[cfg(feature = "research")]
+#[derive(Debug, Default)]
+pub struct SlabReadCounter {
+    ceiling: f64,
+    reads: std::sync::atomic::AtomicUsize,
+    over_with_air: std::sync::atomic::AtomicUsize,
+    over_own: std::sync::atomic::AtomicUsize,
+}
+
+#[cfg(feature = "research")]
+impl SlabReadCounter {
+    /// Count one read: `all` with every cell, `own` with the AIR cells left
+    /// out.
+    pub(crate) fn record(&self, all: f64, own: f64) {
+        use std::sync::atomic::Ordering::Relaxed;
+        self.reads.fetch_add(1, Relaxed);
+        if all > self.ceiling {
+            if own > self.ceiling {
+                self.over_own.fetch_add(1, Relaxed);
+            } else {
+                self.over_with_air.fetch_add(1, Relaxed);
+            }
+        }
+    }
+
+    /// (reads, over the ceiling only with the AIR cells, over without them).
+    #[must_use]
+    pub fn counts(&self) -> (usize, usize, usize) {
+        use std::sync::atomic::Ordering::Relaxed;
+        (
+            self.reads.load(Relaxed),
+            self.over_with_air.load(Relaxed),
+            self.over_own.load(Relaxed),
+        )
+    }
 }
 
