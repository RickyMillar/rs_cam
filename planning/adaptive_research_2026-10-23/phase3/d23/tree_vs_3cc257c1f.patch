+/// C37 (instrument): [`plan_rapids`] of `segments`, each with the class of
+/// the nearest of the producer's joins `marks` within [`turn_bound`] (the
+/// longest join a turn may take, the same bound as the plan's). The
+/// replay refuses a join, or the end of the arc before it (the head-on
+/// lens, C25), and re-enters at or near the join; a re-entry farther away
+/// is not at a join.
+pub(crate) fn classify_reentries(
+    segments: &[AdaptiveSegment],
+    marks: &[JoinMark],
+    params: &AdaptiveParams,
+) -> Vec<Reentry> {
+    let bound = turn_bound(params.stepover, planner_cell(params));
+    plan_rapids(segments)
+        .into_iter()
+        .map(|r| {
+            let join = marks
+                .iter()
+                .map(|m| (point_to_segment_distance(&r.at, &m.from, &m.to), m.class))
+                .filter(|&(d, _)| d <= bound)
+                .min_by(|a, b| a.0.total_cmp(&b.0))
+                .map(|(_, class)| class);
+            Reentry {
+                at: r.at,
+                producer: r.producer,
+                join,
+            }
+        })
+        .collect()
+}
