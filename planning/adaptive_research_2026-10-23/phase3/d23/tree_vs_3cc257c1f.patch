+//! Research arm C38 (adaptive research 2026-10-23, Phase 3): the outer band
+//! of a cased part. Behind the `research` feature; the shipped arms never
+//! reach it. The note is
+//! `planning/adaptive_research_2026-10-23/P3_C38_outer_band.md`.
+//!
+//! - G-b: the research arm has no F-038 forecast (`clear_one_region`). It
+//!   judges a region on its own plan ([`planned_cut_mm`]), and a skipped
+//!   region leaves no research record ([`RecordMark`]).
+//! - Item B: the C31 grown outline stops at the stock box
+//!   ([`clip_to_stock_box`]). Beyond the box edge no material stands, so
+//!   the grow there would put phantom stock in the 2D grid. At a wall and
+//!   at the containment line the grow stays: the stock there is real.
+//!
+//! - The corridor opening ([`corridor_opening`]): a slice piece where the
+//!   field does not apply because its seed (a centre clearance of R) does
+//!   not fit is planned as concentric loops at the stepover, whose steps
+//!   are counted slots (operator ruling 2026-10-26: an over-ceiling step at
+//!   feed × c/w, as a turn).
+//!
+//! No new constant: the threshold is `min_region_cut_length_mm`, the box is
+//! the planner stock's, and the loops step by the stepover.
+
+use crate::adaptive::AdaptiveSegment;
+use crate::adaptive::research_geodesic::{ArcCounts, JoinClass, JoinMark, SlicePlan};
+use crate::dexel_stock::TriDexelStock;
+use crate::geo::P2;
+use crate::polygon::{Polygon2, offset_polygon};
+
+use super::clearing::ClearZLevelContext;
+
+/// The XY cut length (mm) of a region's 2D plan: the sum of its `Cut`
+/// polylines. Links and entries do not count, as in the F-038 forecast.
+pub(super) fn planned_cut_mm(segments: &[AdaptiveSegment]) -> f64 {
+    segments
+        .iter()
+        .map(|seg| match seg {
+            AdaptiveSegment::Cut(path) => crate::geo::polyline_length_2d(path),
+            AdaptiveSegment::Rapid(_) | AdaptiveSegment::Link(_) | AdaptiveSegment::Marker(_) => {
+                0.0
+            }
+        })
+        .sum()
+}
+
+/// The lengths of the research records of a level before one region's
+/// plan: the turn and slot records (`SliceTurns::mark`) and the core-zone
+/// records. [`Self::roll_back`] takes the records of a skipped region out
+/// again, as `pick_region_plan` does for the plan it does not keep.
+pub(super) struct RecordMark {
+    turns: crate::adaptive::research_geodesic::SliceTurnsMark,
+    core_zones: usize,
+    joins: usize,
+}
+
+impl RecordMark {
+    pub(super) fn of(ctx: &ClearZLevelContext<'_>) -> Self {
+        Self {
+            turns: ctx.research_turns.borrow().mark(),
+            core_zones: ctx.research_core_zones.borrow().len(),
+            joins: ctx.research_joins.borrow().len(),
+        }
+    }
+
+    pub(super) fn roll_back(&self, ctx: &ClearZLevelContext<'_>) {
+        ctx.research_turns.borrow_mut().truncate(self.turns);
+        ctx.research_core_zones
+            .borrow_mut()
+            .truncate(self.core_zones);
+        ctx.research_joins.borrow_mut().truncate(self.joins);
+    }
+}
+
+/// The C31 grown outlines of a region clipped to the XY box of the planner
+/// stock, or `None` when nothing is left (the region then keeps the
+/// shipped path, as when the grow gives no outline).
+///
+/// A polygon inside the box is returned unchanged, so a region away from
+/// the stock edge plans exactly as before.
+pub(super) fn clip_to_stock_box(
+    grown: Vec<Polygon2>,
+    stock: &TriDexelStock,
+) -> Option<Vec<Polygon2>> {
+    let (lo, hi) = (stock.stock_bbox.min, stock.stock_bbox.max);
+    let inside = |poly: &Polygon2| {
+        poly.exterior
+            .iter()
+            .all(|p| p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y)
+    };
+    let stock_box = Polygon2::rectangle(lo.x, lo.y, hi.x, hi.y);
+    let out: Vec<Polygon2> = grown
+        .into_iter()
+        .flat_map(|poly| {
+            if inside(&poly) {
+                vec![poly]
+            } else {
+                poly.intersection(&stock_box)
+            }
+        })
+        .filter(|poly| poly.exterior.len() >= 3)
+        .collect();
+    (!out.is_empty()).then_some(out)
+}
+
+/// C38: the corridor opening of one slice piece, or `None` when the piece
+/// is not a corridor.
+///
+/// The piece is a corridor when its 2D tool-centre region (`polygon` inset
+/// by R, the region the planner plans in) is not empty and holds no centre
+/// clearance of R (its inset by R more is empty). There the field's seed
+/// (the starter rim of radius R) does not fit, and under the 2D pass load
+/// every pass of the agent's narrow loops is refused, because the first
+/// pass through a closed strip is a slot (P3_C38 §2).
+///
+/// The plan: the concentric loops of the tool-centre region at `k · s`
+/// (k = 0, 1, …, while the inset is not empty), outside in, each ring a
+/// closed `Cut` after a `Rapid`, its edges split to steps of at most `s`.
+/// Every step is a slot ([`SlicePlan::slots`]): the replay admits it as a
+/// turn (each step is shorter than `turn_bound`), and the 3D stage feeds
+/// it at `c / w` of its measured engagement, or at the full feed where it
+/// holds the ceiling (`turn_feed_factor`). In a strip of centre width
+/// `2ρ ≤ 2s` the plan is the two edges: the first is the slot (w about 1),
+/// the second bites `2ρ`.
+pub(super) fn corridor_opening(
+    polygon: &Polygon2,
+    params: &crate::adaptive::AdaptiveParams,
+) -> Option<SlicePlan> {
+    let r = params.tool_radius;
+    let s = params.stepover;
+    if !r.is_finite() || !s.is_finite() || r <= 0.0 || s <= 0.0 {
+        return None;
+    }
+    let centre: Vec<Polygon2> = offset_polygon(polygon, r);
+    if centre.is_empty() || centre.iter().any(|c| !offset_polygon(c, r).is_empty()) {
+        return None;
+    }
+    let mut segments: Vec<AdaptiveSegment> = Vec::new();
+    let mut slots: Vec<(P2, P2)> = Vec::new();
+    // One C37 join mark per entered loop, so that the re-entry there reads
+    // as a corridor slot entry, not as an open-arc join.
+    let mut joins: Vec<JoinMark> = Vec::new();
+    let mut loops = 0usize;
+    // The insets stop before R: a centre clearance of R does not exist.
+    let mut k = 0usize;
+    while (k as f64) * s < r {
+        let d = (k as f64) * s;
+        let rings: Vec<Polygon2> = if k == 0 {
+            centre.clone()
+        } else {
+            centre.iter().flat_map(|c| offset_polygon(c, d)).collect()
+        };
+        if rings.is_empty() {
+            break;
+        }
+        for poly in &rings {
+            for ring in std::iter::once(&poly.exterior).chain(poly.holes.iter()) {
+                let path = closed_steps(ring, s);
+                let Some(&start) = path.first() else {
+                    continue;
+                };
+                slots.extend(path.windows(2).filter_map(|w| match w {
+                    &[a, b] => Some((a, b)),
+                    _ => None,
+                }));
+                joins.push(JoinMark {
+                    from: start,
+                    to: start,
+                    class: JoinClass::Corridor,
+                });
+                segments.push(AdaptiveSegment::Rapid(start));
+                segments.push(AdaptiveSegment::Cut(path));
+                loops += 1;
+            }
+        }
+        k += 1;
+    }
+    if slots.is_empty() {
+        return None;
+    }
+    let cut_mm: f64 = slots
+        .iter()
+        .map(|(a, b)| (b.x - a.x).hypot(b.y - a.y))
+        .sum();
+    tracing::info!(
+        loops,
+        slot_steps = slots.len(),
+        cut_mm = %format!("{cut_mm:.1}"),
+        centre_area_mm2 = %format!("{:.1}", centre.iter().map(Polygon2::area).sum::<f64>()),
+        "C38 corridor opening"
+    );
+    Some(SlicePlan {
+        segments,
+        turns: Vec::new(),
+        slots,
+        joins,
+        arcs: ArcCounts::default(),
+        core: None,
+    })
+}
+
+/// A closed ring as a path that returns to its first point, each edge split
+/// into equal steps of at most `max_step`. Empty for fewer than 3 points.
+fn closed_steps(ring: &[P2], max_step: f64) -> Vec<P2> {
+    let mut pts: Vec<P2> = ring.to_vec();
+    if let (Some(&first), Some(&last)) = (pts.first(), pts.last())
+        && pts.len() > 1
+        && (first.x - last.x).hypot(first.y - last.y) < 1e-9
+    {
+        pts.pop();
+    }
+    if pts.len() < 3 {
+        return Vec::new();
+    }
+    if let Some(&first) = pts.first() {
+        pts.push(first);
+    }
+    let mut out: Vec<P2> = Vec::with_capacity(pts.len());
+    for w in pts.windows(2) {
+        let &[a, b] = w else {
+            continue;
+        };
+        if out.is_empty() {
+            out.push(a);
+        }
+        let len = (b.x - a.x).hypot(b.y - a.y);
+        let n = ((len / max_step).ceil() as usize).max(1);
+        for i in 1..=n {
+            let t = i as f64 / n as f64;
+            out.push(P2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y)));
+        }
+    }
+    out
+}
