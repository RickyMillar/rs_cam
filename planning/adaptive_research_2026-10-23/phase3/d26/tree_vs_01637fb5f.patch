+/// G-CLIPAIR (§11 a): the boundary grown by the tool radius, the reach of a
+/// disc whose centre is inside `boundary`, for the research arm with Global
+/// ordering; `None` otherwise (the shipped clear). The boundary clear then
+/// empties only the planner-stock cells outside this reach. The cells
+/// between the boundary and the reach keep their stock, which a cut from
+/// inside the boundary meets (P3_C38 §10.7, §11.1b).
+pub(super) fn boundary_reach(
+    params: &Adaptive3dParams,
+    boundary: &Polygon2,
+    tool_radius: f64,
+) -> Option<Vec<Polygon2>> {
+    let research = matches!(params.clearing_strategy, ClearingStrategy3d::Geodesic(_));
+    let global = matches!(params.linking.region_ordering, RegionOrdering::Global);
+    if !research || !global || !tool_radius.is_finite() || tool_radius <= 0.0 {
+        return None;
+    }
+    let reach = offset_polygon(boundary, -tool_radius);
+    (!reach.is_empty()).then_some(reach)
