+/// Research (C40): why `plan_and_emit_region` handed the sink an entry
+/// (`Adaptive3dSegment::Rapid`).
+#[cfg(feature = "research")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum EntryCause {
+    /// The first 2D `Rapid` of an outline's plan.
+    Start,
+    /// A later 2D `Rapid` of the plan: a refusal of the replay.
+    Reentry2d,
+    /// A 2D `Link` that is not held.
+    Link2d,
+    /// The large-Z split of a draped cut.
+    LargeZ,
+    /// The same split on a held link lifted as a cut (C26b).
+    LargeZHeld,
+    /// The end of an air run inside a cut.
+    AirRun,
+    /// The shipped perimeter sweep (its exterior or a hole).
+    Sweep,
+    /// The level's waterline cleanup (`clearing::waterline_cleanup`).
+    Waterline,
+    /// The boundary clip (`centre_clip::clip_segment`): a cut piece that
+    /// does not continue from the tool, or a link it turned into an entry.
+    Clip,
+}
+
+/// Research (C40): one entry handed to the sink, at its XY.
+#[cfg(feature = "research")]
+#[derive(Debug, Clone, Copy)]
+pub struct EntryCauseRecord {
+    pub x: f64,
+    pub y: f64,
+    pub cause: EntryCause,
+}
+
+/// Research (C40): how the emitter made an entry.
+#[cfg(feature = "research")]
+#[derive(Debug, Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub enum EntryKind {
+    /// A keep-down link: the traverse before it is a feed (F-038b).
+    LiftOver,
+    /// A retract and plunge: the traverse before it is a rapid.
+    Plunge,
+}
+
+/// Research (C40): one entry of the emitted toolpath: a run of entry
+/// moves (`EntryPlunge`, `EntryHelix`, `EntryRamp`, and the peck's
+/// retracts between them), its end, its drop (the Z where the run starts
+/// less its end Z), and its cause: the record at its end XY, or `None`
+/// (Other) when no record matches. `join` is the C37 class of a
+/// `Reentry2d`.
+#[cfg(feature = "research")]
+#[derive(Debug, Clone, Copy)]
+pub struct EntryRecord {
+    pub x: f64,
+    pub y: f64,
+    pub z: f64,
+    pub drop_mm: f64,
+    pub kind: EntryKind,
+    pub cause: Option<EntryCause>,
+    pub join: Option<crate::adaptive::research_geodesic::JoinClass>,
+}
+
+/// Research (C40): the exact key of an XY (the emitter keeps the entry
+/// point's coordinates, so equal points give equal keys).
+#[cfg(feature = "research")]
+fn xy_key(x: f64, y: f64) -> (i64, i64) {
+    ((x * 1e6).round() as i64, (y * 1e6).round() as i64)
+}
+
+/// Research (C40): the entries of `tp` with their causes (`causes`, by
+/// XY; the last record at an XY wins) and, for a 2D re-entry, the C37
+/// join class (`joins`).
+#[cfg(feature = "research")]
+fn entry_records(
+    tp: &Toolpath,
+    causes: &[EntryCauseRecord],
+    joins: &[JoinsRecord],
+) -> Vec<EntryRecord> {
+    use crate::toolpath::{MoveIntent, MoveType};
+    let cause_at: std::collections::HashMap<(i64, i64), EntryCause> =
+        causes.iter().map(|c| (xy_key(c.x, c.y), c.cause)).collect();
+    let join_at: std::collections::HashMap<
+        (i64, i64),
+        crate::adaptive::research_geodesic::JoinClass,
+    > = joins
+        .iter()
+        .flat_map(|j| &j.reentries)
+        .filter_map(|r| r.join.map(|class| (xy_key(r.at.x, r.at.y), class)))
+        .collect();
+    let is_entry = |i: MoveIntent| {
+        matches!(
+            i,
+            MoveIntent::EntryPlunge | MoveIntent::EntryHelix | MoveIntent::EntryRamp
+        )
+    };
+    let moves = &tp.moves;
+    let mut out = Vec::new();
+    let mut k = 0usize;
+    while k < moves.len() {
+        let Some(first) = moves.get(k) else { break };
+        if !is_entry(first.intent) {
+            k += 1;
+            continue;
+        }
+        // The run: entry moves, and the peck's retracts at the same XY.
+        let mut last = k;
+        let mut j = k + 1;
+        while let Some(m) = moves.get(j) {
+            if is_entry(m.intent) {
+                last = j;
+            } else if !(m.intent == MoveIntent::Retract
+                && moves.get(last).is_some_and(|l| {
+                    (l.target.x - m.target.x).abs() < 1e-9 && (l.target.y - m.target.y).abs() < 1e-9
+                }))
+            {
+                break;
+            }
+            j += 1;
+        }
+        let Some(end) = moves.get(last).map(|m| m.target) else {
+            break;
+        };
+        let start_z = k
+            .checked_sub(1)
+            .and_then(|i| moves.get(i))
+            .map_or(end.z, |m| m.target.z);
+        // The traverse before the entry: the last move before the run that
+        // ends at another XY than the one before it.
+        let kind = (1..k)
+            .rev()
+            .find_map(|i| {
+                let (a, b) = (moves.get(i - 1)?, moves.get(i)?);
+                ((b.target.x - a.target.x).hypot(b.target.y - a.target.y) > 1e-9)
+                    .then_some(matches!(b.move_type, MoveType::Rapid))
+            })
+            .map_or(EntryKind::Plunge, |rapid| {
+                if rapid {
+                    EntryKind::Plunge
+                } else {
+                    EntryKind::LiftOver
+                }
+            });
+        let key = xy_key(end.x, end.y);
+        out.push(EntryRecord {
+            x: end.x,
+            y: end.y,
+            z: end.z,
+            drop_mm: start_z - end.z,
+            kind,
