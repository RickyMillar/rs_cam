+
+/// G-CLIPAIR (§11 b, c): which planner-stock cells have their centre inside
+/// the boundary, and the reach of a disc in cells. Built by the boundary
+/// clear (`path.rs`) when [`boundary_reach`] gives a reach.
+pub(super) struct ResearchClip {
+    /// One flag per planner-stock cell (row-major, `rows × cols`).
+    inside: Vec<bool>,
+    rows: usize,
+    cols: usize,
+    tool_radius: f64,
+    cell_size: f64,
+}
+
+impl ResearchClip {
+    pub(super) fn new(
+        inside: Vec<bool>,
+        rows: usize,
+        cols: usize,
+        tool_radius: f64,
+        cell_size: f64,
+    ) -> Option<Self> {
+        (inside.len() == rows * cols && cell_size > 0.0).then_some(Self {
+            inside,
+            rows,
+            cols,
+            tool_radius,
+            cell_size,
+        })
+    }
+
+    /// Restrict a level's padded material grid (`build_material_bool_grid`:
+    /// cell `(r, c)` of the stock is padded cell `(r + 1, c + 1)`) to the
+    /// region cells of the research arm:
+    /// - (b) a cell whose centre is outside the boundary is not a region
+    ///   cell, whatever its stock (the boundary clear gave this before);
+    /// - (c) a cell inside the boundary is a region cell when it holds
+    ///   material, or when a material cell outside the boundary (the band
+    ///   that the reach keeps) lies within the tool radius of it: a disc
+    ///   centred there cuts that band.
+    pub(super) fn restrict_regions(
+        &self,
+        grid: &mut [bool],
+        padded_rows: usize,
+        padded_cols: usize,
+    ) {
+        if padded_rows != self.rows + 2 || padded_cols != self.cols + 2 {
+            return;
+        }
+        let at = |r: usize, c: usize| (r + 1) * padded_cols + (c + 1);
+        let mut band: Vec<(usize, usize)> = Vec::new();
+        for r in 0..self.rows {
+            for c in 0..self.cols {
+                let inside = self.inside.get(r * self.cols + c).copied().unwrap_or(false);
+                if let Some(cell) = grid.get_mut(at(r, c))
+                    && *cell
+                    && !inside
+                {
+                    *cell = false;
+                    band.push((r, c));
+                }
+            }
+        }
+        let reach = (self.tool_radius / self.cell_size).floor() as isize;
+        let r_sq = self.tool_radius * self.tool_radius;
+        for &(r, c) in &band {
+            for dr in -reach..=reach {
+                for dc in -reach..=reach {
+                    let (dx, dy) = (dc as f64 * self.cell_size, dr as f64 * self.cell_size);
+                    if dx * dx + dy * dy > r_sq {
+                        continue;
+                    }
+                    let (rr, cc) = (r as isize + dr, c as isize + dc);
+                    if rr < 0 || cc < 0 || rr as usize >= self.rows || cc as usize >= self.cols {
+                        continue;
+                    }
+                    let (rr, cc) = (rr as usize, cc as usize);
+                    if self
+                        .inside
+                        .get(rr * self.cols + cc)
+                        .copied()
+                        .unwrap_or(false)
+                        && let Some(cell) = grid.get_mut(at(rr, cc))
