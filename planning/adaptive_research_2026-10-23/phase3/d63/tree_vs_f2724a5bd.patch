+/// D63 (G-RESTDOC): the anchor reads the stock the tool meets. A band
+/// within one tool radius beyond the centre containment counts (a disc
+/// centred on the containment line cuts it); stock beyond the tool's reach
+/// does not. The read is the shared `tool_reach_cells` test (radius plus
+/// half a cell).
+#[test]
+fn the_anchor_reads_the_stock_the_tool_meets_d63() {
+    let (mesh, si) = make_flat_mesh(); // 50x50mm flat at z=0
+    let cutter = flat_cutter();
+    let cell_size = 0.5;
+    let box_top = 14.0;
+    let cut_top = 2.0_f64;
+    let leave = 0.5;
+    let tool_radius = default_params().geometry.tool_radius;
+    let containment = vec![crate::polygon::Polygon2::rectangle(-15.0, -15.0, 0.0, 15.0)];
+    let anchor_with_band = |band: &dyn Fn(f64) -> bool| {
+        let mut stock =
+            TriDexelStock::from_stock(-20.0, -20.0, 20.0, 20.0, -1.0, box_top, cell_size);
+        for row in 0..stock.z_grid.rows {
+            for col in 0..stock.z_grid.cols {
+                let (x, _) = stock.z_grid.cell_to_world(row, col);
+                if !band(x) {
+                    crate::stock::dexel::ray_subtract_above(
+                        stock.z_grid.ray_mut(row, col),
+                        cut_top as f32,
+                    );
+                }
+            }
+        }
+        let hm = SurfaceHeightmap::from_mesh(
+            &mesh,
+            &si,
+            &cutter,
+            stock.z_grid.origin_u,
+            stock.z_grid.origin_v,
+            stock.z_grid.rows,
+            stock.z_grid.cols,
+            cell_size,
+            -1.0,
+        );
+        let prior = super::path::PriorStockTops::read(&stock, &containment, tool_radius);
+        super::path::level_anchor_z(Some(&prior), &hm, leave, box_top)
+    };
+    // A full-height band inside the tool's reach, beyond the containment.
+    let inside_reach = anchor_with_band(&|x| x > 0.0 && x < tool_radius);
+    assert!(
+        (inside_reach - box_top).abs() < 1e-6,
+        "the band in reach did not count: anchor {inside_reach}"
+    );
+    // The same band beyond the reach (radius plus one cell out).
+    let beyond = anchor_with_band(&|x| x > tool_radius + 2.0 * cell_size);
+    assert!(
+        (beyond - cut_top).abs() < 1e-6,
+        "stock beyond the reach counted: anchor {beyond}"
+    );
 }
 
