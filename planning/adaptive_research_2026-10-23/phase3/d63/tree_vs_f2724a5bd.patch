+/// D63 (G-RESTDOC): the planner cells the tool can meet. A cell is in reach
+/// when its square touches a disc of `tool_radius` centred inside the
+/// centre containment `centre_boundary`. This is the sliver-safe test of
+/// the entry-floor read (`TriDexelStock::max_conservative_top_cell_in_disc`:
+/// the cell centre within the radius plus half a cell), built as the
+/// containment grown by the radius plus half a cell. `None`: no
+/// containment, every cell is in reach.
+///
+/// THE one test of "the stock the tool meets": the level anchor and the D50
+/// guard both read it, through [`PriorStockTops`].
+pub(super) fn tool_reach_cells(
+    stock: &TriDexelStock,
+    centre_boundary: &[crate::polygon::Polygon2],
+    tool_radius: f64,
+) -> Option<Vec<bool>> {
+    if centre_boundary.is_empty() {
+        return None;
+    }
+    let grid = &stock.z_grid;
+    let grow = tool_radius.max(0.0) + grid.cell_size * 0.5;
+    let reach: Vec<crate::polygon::Polygon2> = centre_boundary
+        .iter()
+        .flat_map(|p| crate::polygon::offset_polygon(p, -grow))
+        .collect();
+    let mut cells = Vec::with_capacity(grid.rows * grid.cols);
+    for row in 0..grid.rows {
+        for col in 0..grid.cols {
+            let (x, y) = grid.cell_to_world(row, col);
+            let p = crate::geo::P2::new(x, y);
+            cells.push(reach.iter().any(|q| q.contains_point(&p)));
+        }
+    }
+    Some(cells)
+}
