+/// D63 (G-RESTDOC): the column tops of the cells in the tool's reach
+/// ([`tool_reach_cells`]), read from the planner stock after the border
+/// clear and BEFORE the boundary clear. The boundary clear keeps only the
+/// cells whose centre is inside the raw boundary, but a disc centred on a
+/// `Center` containment line reaches one radius beyond it: there a previous
+/// op can have left stock (the research arm's §16 stock-edge band). The
+/// level anchor and the D50 guard read this, so the first level sits at most
+/// one Depth/Pass under the highest stock the tool meets. Built on prior
+/// stock only; a fresh op reads no stock.
+pub(super) struct PriorStockTops {
+    /// Row-major; `None` for a cell out of reach or with no material.
+    tops: Vec<Option<f64>>,
+    cols: usize,
+}
+
+impl PriorStockTops {
+    pub(super) fn read(
+        stock: &TriDexelStock,
+        centre_boundary: &[crate::polygon::Polygon2],
+        tool_radius: f64,
+    ) -> Self {
+        let reach = tool_reach_cells(stock, centre_boundary, tool_radius);
+        let grid = &stock.z_grid;
+        let mut tops = Vec::with_capacity(grid.rows * grid.cols);
+        for row in 0..grid.rows {
+            for col in 0..grid.cols {
+                let in_reach = reach
+                    .as_ref()
+                    .is_none_or(|r| r.get(row * grid.cols + col).copied().unwrap_or(false));
+                tops.push(
+                    in_reach
+                        .then(|| crate::stock::dexel::ray_top(grid.ray(row, col)).map(f64::from))
+                        .flatten(),
+                );
+            }
+        }
+        Self {
+            tops,
+            cols: grid.cols,
+        }
+    }
+
+    /// `(row, col, top)` of every reach cell that holds material.
+    pub(super) fn cells(&self) -> impl Iterator<Item = (usize, usize, f64)> + '_ {
+        let cols = self.cols.max(1);
+        self.tops
+            .iter()
+            .enumerate()
+            .filter_map(move |(i, top)| top.map(|t| (i / cols, i % cols, t)))
+    }
+}
