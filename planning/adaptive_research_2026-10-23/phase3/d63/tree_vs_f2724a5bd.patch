+//! D63 (G-RESTDOC, `planning/adaptive_research_2026-10-23/phase3/d63/`): a
+//! 3D Rough on remaining stock starts its levels at most one Depth/Pass
+//! under the highest stock its tool meets inside its containment, also
+//! where that stock is beyond its raw boundary.
+//!
+//! The stock stands well past the model. The source (op 0, contour
+//! parallel, `Center` on the silhouette, 1 mm leave) cuts out to the
+//! silhouette plus one tool radius, so a band beyond that stays at the stock
+//! top. The rest op (op 1, contour parallel on remaining stock, no leave) has
+//! the silhouette grown by half a tool radius with `Center` containment: its
+//! centre reaches that line, so its tool cuts the band out to one and a half
+//! radii, one radius past its raw boundary. (Half a radius keeps the corners
+//! of its raw line within the source's rounded reach, so no uncut corner
+//! stands inside the raw line.) Its boundary clear keeps only the cells inside the raw line,
+//! where only the source's 1 mm skin stands, so the level anchor used to read
+//! the skin: the first level sat at the plate, and the band was taken from
+//! the stock top in one pass. Now the anchor reads the
+//! stock the tool meets before the boundary clear, so the first level is at
+//! most one Depth/Pass under the ring top, and the simulated axial
+//! engagement of the rest op stays within one Depth/Pass (plus one
+//! simulation cell, the dexel quantisation of the reading).
+
+#![expect(
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    clippy::print_stderr,
+    reason = "test code: an expect is how a test reports a failure; the test prints its measurements for the reader"
+)]
+
+mod common;
+
+use common::meshes::height_field;
+use common::session::{mesh_model, stock_over, toolpath_config};
+use common::tools::endmill_tool_config;
+
+use rs_cam_core::compute::catalog::OperationConfig;
+use rs_cam_core::compute::config::{
+    BoundaryConfig, BoundaryContainment, BoundarySource, StockSource,
+};
+use rs_cam_core::compute::operation_configs::{Adaptive3dConfig, ClearingStrategy};
+use rs_cam_core::ids::ToolId;
+use rs_cam_core::session::{
+    AddToolpathArgs, Command, ProjectSession, ProjectSessionBuilder, SimulationOptions,
+    SimulationResolution,
+};
+use rs_cam_core::trace::toolpath_spans::{SpanKind, SpanPayload};
+use std::sync::atomic::AtomicBool;
+
+const TOP_Z: f64 = 10.0;
+const PLATE_Z: f64 = 1.0;
+const MESH_HALF: f64 = 30.0;
+const MESH_STEP: f64 = 0.5;
+const TOOL_DIAMETER: f64 = 6.0;
+const DEPTH_PER_PASS: f64 = 3.0;
+const SIM_CELL: f64 = 0.5;
+/// The source's axial leave: the skin inside the rest op's raw line.
+const SOURCE_LEAVE: f64 = 1.0;
+/// How far the stock stands past the model: wider than two tool radii, so a
+/// band stays beyond the source's reach and inside the rest op's.
+const STOCK_MARGIN: f64 = 8.0;
+
+fn rough(
+    leave: f64,
+    offset: f64,
+    stock_source: StockSource,
+) -> (OperationConfig, BoundaryConfig, StockSource) {
+    (
+        OperationConfig::Adaptive3d(Adaptive3dConfig {
+            stepover: 2.0,
+            depth_per_pass: DEPTH_PER_PASS,
+            stock_to_leave_axial: leave,
+            clearing_strategy: ClearingStrategy::ContourParallel,
+            ..Adaptive3dConfig::default()
+        }),
+        BoundaryConfig {
+            enabled: true,
+            source: BoundarySource::ModelSilhouette,
+            containment: BoundaryContainment::Center,
+            offset,
+        },
+        stock_source,
+    )
+}
+
+/// The pair; the rest op's boundary is the silhouette grown by
+/// `rest_offset`.
+fn session(rest_offset: f64) -> ProjectSession {
+    let mesh = height_field(MESH_HALF, MESH_STEP, |_, _| PLATE_Z);
+    let mut stock = stock_over(MESH_HALF + STOCK_MARGIN, TOP_Z);
+    rs_cam_core::compute::fixture_values::fill_unset_stock(&mut stock);
+    let mut builder = ProjectSessionBuilder::new().stock(stock);
+    let tool_idx = builder.add_tool(endmill_tool_config(TOOL_DIAMETER));
+    let tool_id = ToolId::from_raw(builder.tools()[tool_idx].id.raw());
+    let model_id = builder.add_model(mesh_model(mesh, "plate"));
+    let (op, boundary, stock_source) = rough(SOURCE_LEAVE, 0.0, StockSource::Fresh);
+    let mut op0 = toolpath_config("rough", op, tool_id, model_id);
+    op0.boundary = boundary;
+    op0.stock_source = stock_source;
+    let _ = builder.add_toolpath(0, op0).expect("add the rough");
+    let mut session = builder.build();
+    let (op, boundary, stock_source) = rough(0.0, rest_offset, StockSource::FromRemainingStock);
+    let mut op1 = toolpath_config("rest", op, tool_id, model_id);
+    op1.boundary = boundary;
+    op1.stock_source = stock_source;
+    // The debug trace states the planned level list ("Compute Z levels").
+    op1.debug_options.enabled = true;
+    let _ = session
+        .apply(Command::AddToolpath(AddToolpathArgs {
+            setup_index: 0,
+            config: Box::new(op1),
+        }))
+        .expect("add the rest op");
+    session
+}
+
+fn simulate(session: &mut ProjectSession) {
+    let cancel = AtomicBool::new(false);
+    session
+        .run_simulation(
+            &SimulationOptions {
+                resolution: SimulationResolution::Fixed(SIM_CELL),
+                ..SimulationOptions::default()
+            },
+            &cancel,
+        )
+        .expect("simulate");
+}
+
+/// What one run of the pair measures on the rest op.
+struct RestRun {
+    /// The plan's first level (`z_top` of the "Compute Z levels" span).
+    planned_first: f64,
+    /// The highest level that emitted a depth pass.
+    emitted_first: f64,
+    /// The simulated axial engagement of the rest op's cutting samples.
+    max_axial: f64,
+    cutting: usize,
+}
+
+/// The rest op's offset that leaves the band beyond its raw line: half a
+/// tool radius (its raw corners stay inside the source's rounded reach).
+const BAND_BEYOND_RAW: f64 = TOOL_DIAMETER / 4.0;
+
+fn run(rest_offset: f64) -> RestRun {
+    let mut session = session(rest_offset);
+    let cancel = AtomicBool::new(false);
+    session
+        .generate_toolpath(0, &cancel)
+        .expect("generate the rough");
+    simulate(&mut session);
+    session
+        .generate_toolpath(1, &cancel)
+        .expect("generate the rest op");
+    let result = session.result_at(1).expect("the rest op's result");
+    let planned_first = result
+        .debug_trace
+        .as_ref()
+        .expect("the rest op's debug trace")
+        .spans
+        .iter()
+        .find(|span| span.kind == "z_level_plan")
+        .and_then(|span| span.counters.get("z_top").copied())
+        .expect("the level plan span states z_top");
+    let emitted_first = result
+        .annotated()
+        .spans
+        .iter()
+        .filter_map(|span| match (span.kind, &span.payload) {
+            (SpanKind::DepthPass, Some(SpanPayload::DepthPass { z_level, .. })) => Some(*z_level),
+            _ => None,
+        })
+        .fold(f64::NEG_INFINITY, f64::max);
+
+    simulate(&mut session);
+    let rest_id = session.toolpath_configs()[1].id;
+    let trace = session
+        .simulation_result()
+        .and_then(|s| s.cut_trace.as_deref())
+        .expect("the cut trace");
+    let (mut max_axial, mut cutting) = (0.0_f64, 0usize);
+    for sample in trace.samples.iter().filter(|s| s.toolpath_id == rest_id) {
+        if sample.removed_volume_est_mm3 > 0.0 {
+            cutting += 1;
+            max_axial = max_axial.max(sample.axial_engagement_mm);
+        }
+    }
+    eprintln!(
+        "rest op: planned first level {planned_first:.3}, first emitted pass {emitted_first:.3} \
+         (band top {TOP_Z}), {cutting} cutting samples, max axial {max_axial:.3} (DPP {DEPTH_PER_PASS})"
+    );
+    assert!(
+        cutting > 0,
+        "the rest op cut nothing: the fixture tests nothing"
+    );
+    RestRun {
+        planned_first,
+        emitted_first,
+        max_axial,
+        cutting,
+    }
+}
+
+/// The anchor (D63): the plan's first level is at most one Depth/Pass
+/// under the band the tool meets beyond its raw boundary.
+#[test]
+fn a_rest_op_plans_its_first_level_one_depth_under_the_band_d63() {
+    let r = run(BAND_BEYOND_RAW);
+    assert!(
+        r.planned_first >= TOP_Z - DEPTH_PER_PASS - 1e-6,
+        "the rest op plans its first level at {:.3}, more than one Depth/Pass under the band at {TOP_Z}",
+        r.planned_first
+    );
+}
+
+/// G-RESTDOC, known defect, as an inverted assertion that runs
+/// (`tests/CLAUDE.md`): the level region holds no centre cell over the
+/// reach band. The boundary clear removes the band from the planner stock,
+/// so the planned levels above the stock inside the raw line emit nothing,
+/// and the band is cut at the lowest level by the edge of the disc, more
+/// than one Depth/Pass deep. This test pins that. When the region side of
+/// the fix lands (`phase3/d63/README.md` §5), it FAILS: then turn it into
+/// the rule (`max_axial <= DPP + one sim cell`, the first emitted pass at
+/// most one Depth/Pass under the band).
+#[test]
+fn g_restdoc_the_band_is_still_cut_deeper_than_one_depth_d63() {
+    let r = run(BAND_BEYOND_RAW);
+    assert!(
+        r.max_axial > DEPTH_PER_PASS + SIM_CELL && r.emitted_first < TOP_Z - DEPTH_PER_PASS - 1e-6,
+        "G-RESTDOC no longer reproduces (max axial {:.3}, first emitted pass {:.3}, {} cutting \
+         samples): the region side of the fix landed; turn this test into the rule",
+        r.max_axial,
+        r.emitted_first,
+        r.cutting
+    );
+}
+
+/// The D62 planted case (`phase3/fix43`): the rest op's raw line (the
+/// silhouette grown by two tool radii) takes in part of the band, so the
+/// boundary clear keeps it and the anchor read it before D63 too. The plan
+/// is unchanged: the first level is one Depth/Pass under the band.
+#[test]
+fn the_d62_planted_case_plans_one_depth_under_the_band_d63() {
+    let r = run(TOOL_DIAMETER);
+    assert!(
+        (r.planned_first - (TOP_Z - DEPTH_PER_PASS)).abs() < 1e-6,
+        "the D62 case plans its first level at {:.3}, not one Depth/Pass under the band at {TOP_Z}",
+        r.planned_first
+    );
+}
