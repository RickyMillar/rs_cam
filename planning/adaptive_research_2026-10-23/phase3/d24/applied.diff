+/// C22a (P3_C22_3d_turns.md §14): with the F-038 group filter on at the
+/// op default (`Adaptive3dConfig::default().min_region_cut_length_mm`), no
+/// research arm emits a held link keep-down over standing stock
+/// (`Research3d::held_link_faults` empty). The filter drops short groups
+/// after the 2D replay admitted the plan's links; the replay after the
+/// filter must refuse the links that crossed a dropped group's ground. The
+/// other tests run with the filter off (`min_region_cut_length_mm` 0).
+/// Two levels, no simulation.
+#[test]
+fn no_held_link_crosses_standing_stock_with_the_group_filter_on() {
+    let mesh = pocket_with_island();
+    let index = SpatialIndex::build(&mesh, 10.0);
+    let threshold = rs_cam_core::compute::operation_configs::Adaptive3dConfig::default()
+        .min_region_cut_length_mm;
+    assert!(threshold > 0.0, "the op default turns the F-038 filter off");
+    for (label, options) in [
+        ("geodesic_local_oneway", GeodesicOptions::C16_LOCAL_ONEWAY),
+        ("geodesic_local_zigzag", GeodesicOptions::C20_LOCAL_ZIGZAG),
+        ("geodesic_local_zigzag_v2", GeodesicOptions::C23_ZIGZAG_V2),
+        (
+            "geodesic_local_zigzag_pick",
+            GeodesicOptions::C28_ZIGZAG_PICK,
+        ),
+        (
+            "geodesic_local_spiral_pick",
+            GeodesicOptions::C35_SPIRAL_PICK,
+        ),
+        (
+            "geodesic_local_spiral_headon",
+            GeodesicOptions::C37_SPIRAL_HEADON,
+        ),
+    ] {
+        let mut p = params(ClearingStrategy3d::Geodesic(options));
+        p.linking.min_region_cut_length_mm = threshold;
+        let (out, _, _, _, _, link_faults) = plan(&mesh, &index, &p);
+        eprintln!(
+            "{label} with the group filter at {threshold} mm: {} moves, {} entries, {} held \
+             links over standing stock",
+            out.toolpath.moves.len(),
+            entry_count(&out.toolpath),
+            link_faults.len()
+        );
+        assert!(
+            link_faults.is_empty(),
+            "{label}: held links over standing stock: {link_faults:#?}"
+        );
+    }
+}
