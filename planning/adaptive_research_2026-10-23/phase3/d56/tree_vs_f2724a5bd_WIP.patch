+//! D56 (G-AIRPECK option b, `planning/adaptive_research_2026-10-23/phase3/
+//! d56/PREREG.md`): a `DerivedRestRegions` consumer's planner stock holds no
+//! holding frame outside its source op's machining reach, so the rapid
+//! floor of an entry beside the frame is the region's own stock, not the
+//! frame top.
+//!
+//! The source (op 0) roughs inside the model silhouette (`Inside`), so the
+//! stock ring outside the mesh (the frame) stays at the stock top. The
+//! consumer (op 1, contour parallel on remaining stock, `Center` on op 0's
+//! derived rest regions, `Plunge`) cuts the two channels that op 0 left;
+//! the channels run out to the mesh edge, beside the frame. Two regions:
+//! the consumer has no single pre-boundary, so the boundary clear did not
+//! clear the frame (wanaka op 7). The sliver-safe rapid-floor read took the
+//! frame cells beside the disc, and each entry there came down from the
+//! frame top. Now the planner clears the stock outside op 0's reach (the
+//! silhouette), and no entry's descent starts at the frame top.
+//!
+//! The research arm is selected only by `RS_CAM_RESEARCH_ADAPTIVE3D_ARM`
+//! (read once per process), so the test runs with that variable set.
+
+#![expect(
+    clippy::expect_used,
+    clippy::indexing_slicing,
+    clippy::panic,
+    clippy::print_stderr,
+    reason = "test code: a panic is how a test reports a failure; the test prints its measurements for the reader"
+)]
+
+mod common;
+
+use common::meshes::height_field;
+use common::session::{mesh_model, stock_over, toolpath_config};
+use common::tools::endmill_tool_config;
+
+use rs_cam_core::compute::catalog::OperationConfig;
+use rs_cam_core::compute::config::{
+    BoundaryConfig, BoundaryContainment, BoundarySource, StockSource,
+};
+use rs_cam_core::compute::operation_configs::{
+    Adaptive3dConfig, Adaptive3dEntryStyle, ClearingStrategy,
+};
+use rs_cam_core::ids::ToolId;
+use rs_cam_core::session::{
+    AddToolpathArgs, Command, ProjectSession, ProjectSessionBuilder, SimulationOptions,
+    SimulationResolution,
+};
+use rs_cam_core::toolpath::MoveIntent;
+use std::sync::atomic::AtomicBool;
+
+const TOP_Z: f64 = 10.0;
+const FLOOR_Z: f64 = 4.0;
+const MESH_HALF: f64 = 40.0;
+const MESH_STEP: f64 = 0.5;
+const CHANNEL_HALF_WIDTH: f64 = 4.8;
+/// The Y of the two channel centre lines.
+const CHANNEL_Y: f64 = 12.0;
+const WIDE_HALF_Y: f64 = 24.0;
+const WIDE_FLOOR_Z: f64 = 7.0;
+const TOOL_DIAMETER: f64 = 6.0;
+const SIM_CELL: f64 = 0.5;
+/// The research arm the run must select.
+const ARM: &str = "geodesic_local_spiral_pick";
+
+fn rough(strategy: ClearingStrategy) -> OperationConfig {
+    OperationConfig::Adaptive3d(Adaptive3dConfig {
+        stepover: 2.0,
+        depth_per_pass: 3.0,
+        clearing_strategy: strategy,
+        entry_style: Adaptive3dEntryStyle::Plunge,
+        ..Adaptive3dConfig::default()
+    })
+}
+
+/// The two channels and the wide pocket run the full X length of the mesh,
+/// so inside the silhouette nothing near a channel end stands above the
+/// wide floor; only the frame outside the mesh is at the stock top.
+fn session() -> ProjectSession {
+    let mesh = height_field(MESH_HALF, MESH_STEP, |_, y| {
+        if (y - CHANNEL_Y).abs() <= CHANNEL_HALF_WIDTH
+            || (y + CHANNEL_Y).abs() <= CHANNEL_HALF_WIDTH
+        {
+            FLOOR_Z
+        } else if y.abs() <= WIDE_HALF_Y {
+            WIDE_FLOOR_Z
+        } else {
+            TOP_Z
+        }
+    });
+    let mut stock = stock_over(MESH_HALF, TOP_Z);
+    rs_cam_core::compute::fixture_values::fill_unset_stock(&mut stock);
+    let mut builder = ProjectSessionBuilder::new().stock(stock);
+    let tool_idx = builder.add_tool(endmill_tool_config(TOOL_DIAMETER));
+    let tool_id = ToolId::from_raw(builder.tools()[tool_idx].id.raw());
+    let model_id = builder.add_model(mesh_model(mesh, "channels"));
+    let mut op0 = toolpath_config(
+        "rough",
+        rough(ClearingStrategy::AgentSearch),
+        tool_id,
+        model_id,
+    );
+    op0.rest_analysis.enabled = true;
+    op0.boundary = BoundaryConfig {
+        enabled: true,
+        source: BoundarySource::ModelSilhouette,
+        containment: BoundaryContainment::Inside,
+        offset: 0.0,
+    };
+    let index0 = builder.add_toolpath(0, op0).expect("add the rough");
+    let mut session = builder.build();
+    let source_toolpath_id = session.toolpath_configs()[index0].id;
+    let mut op1 = toolpath_config(
+        "edges, CP rest",
+        rough(ClearingStrategy::ContourParallel),
+        tool_id,
+        model_id,
+    );
+    op1.stock_source = StockSource::FromRemainingStock;
+    op1.boundary = BoundaryConfig {
+        enabled: true,
+        source: BoundarySource::DerivedRestRegions { source_toolpath_id },
+        containment: BoundaryContainment::Center,
+        offset: 0.0,
+    };
+    let _ = session
+        .apply(Command::AddToolpath(AddToolpathArgs {
+            setup_index: 0,
+            config: Box::new(op1),
+        }))
+        .expect("add the consumer");
+    session
+}
+
+#[test]
+#[ignore = "external: needs RS_CAM_RESEARCH_ADAPTIVE3D_ARM=geodesic_local_spiral_pick; run with -- --ignored"]
+fn a_rest_entry_ignores_the_frame_beyond_the_source_reach() {
+    assert_eq!(
+        std::env::var("RS_CAM_RESEARCH_ADAPTIVE3D_ARM").as_deref(),
+        Ok(ARM),
+        "run this test with RS_CAM_RESEARCH_ADAPTIVE3D_ARM={ARM}"
+    );
+    let mut session = session();
+    let cancel = AtomicBool::new(false);
+    session
+        .generate_toolpath(0, &cancel)
+        .expect("generate the rough");
+    let regions = session
+        .result_at(0)
+        .expect("the rough's result")
+        .annotated()
+        .produced
+        .rest_regions
+        .as_deref()
+        .expect("the rough states the regions it left")
+        .len();
+    assert!(regions >= 2, "the consumer needs two regions: {regions}");
+    session
+        .run_simulation(
+            &SimulationOptions {
+                resolution: SimulationResolution::Fixed(SIM_CELL),
+                ..SimulationOptions::default()
+            },
+            &cancel,
+        )
+        .expect("simulate the rough");
+    session
+        .generate_toolpath(1, &cancel)
+        .expect("generate the consumer");
+    let moves = &session
+        .result_at(1)
+        .expect("the consumer's result")
+        .annotated()
+        .toolpath
+        .moves;
+
+    // Each entry: its XY and the Z its first plunge feed starts from (the
+    // descent floor the rapid or the keep-down link stopped at).
+    let mut entries: Vec<(f64, f64, f64)> = Vec::new();
+    for w in moves.windows(2) {
+        if w[1].intent == MoveIntent::EntryPlunge && w[0].intent != MoveIntent::EntryPlunge {
+            entries.push((w[1].target.x, w[1].target.y, w[0].target.z));
+        }
+    }
+    // An entry whose sliver-safe read can take a frame cell: its disc comes
+    // within one cell of the mesh edge in X.
+    let r = TOOL_DIAMETER / 2.0;
+    let near_frame: Vec<&(f64, f64, f64)> = entries
+        .iter()
+        .filter(|(x, _, _)| x.abs() + r >= MESH_HALF - SIM_CELL)
+        .collect();
+    let highest = entries
+        .iter()
+        .map(|e| e.2)
+        .fold(f64::NEG_INFINITY, f64::max);
+    eprintln!(
+        "consumer: {} moves, {} entries, {} beside the frame, highest descent start {highest:.3}; \
+         entries (x, y, start) {entries:?}",
+        moves.len(),
+        entries.len(),
+        near_frame.len()
+    );
+    assert!(
+        !near_frame.is_empty(),
+        "no entry's disc comes near the frame: the fixture tests nothing"
+    );
+    assert!(
+        highest < TOP_Z,
+        "an entry's descent starts at {highest:.3}, at or above the frame top {TOP_Z}: \
+         the planner read the frame outside the source's reach"
+    );
+}
