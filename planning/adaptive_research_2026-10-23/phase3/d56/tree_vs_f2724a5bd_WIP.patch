+    /// D56: the machining reach of the source op of a `DerivedRestRegions`
+    /// consumer `tc`: the region the source's tool disc can sweep. The 3D
+    /// Rough planner of `tc` clears its stock outside it
+    /// (`Adaptive3dGeometry::source_reach`).
+    ///
+    /// The source never cut outside its reach (a holding frame stands
+    /// there). The consumer's disc is inside it: its centre stays in the
+    /// published regions, which lie inside the source's centre containment
+    /// (D48), and its tool is no larger than the source's unless its own
+    /// containment is `Inside` (D53). So no stock outside the reach can be
+    /// under the consumer's disc, and the sliver-safe rapid-floor read stops
+    /// reading the frame.
+    ///
+    /// `None` (no clear, as before) unless every condition holds: the
+    /// source's boundary is enabled and a single polygon (`Stock`,
+    /// `ModelSilhouette`) with `Inside` or `Center` containment, and the
+    /// source is on the setup and the model of `tc`, so `mesh` and
+    /// `stock_bbox` are its frame. The polygon is resolved with no
+    /// keep-outs, so the reach errs large (it clears less). `Inside`: the
+    /// raw polygon. `Center`: the raw polygon grown by the source's tool
+    /// radius, the radius its containment uses.
+    fn rest_source_reach(
+        &self,
+        tc: &crate::session::ToolpathConfig,
+        source_toolpath_id: crate::ids::ToolpathId,
+        stock_bbox: &crate::geo::BoundingBox3,
+        mesh: Option<&Arc<crate::mesh::TriangleMesh>>,
+    ) -> Option<Vec<crate::polygon::Polygon2>> {
+        use crate::compute::config::{BoundaryContainment, BoundarySource};
+        use crate::tool::MillingCutter as _;
+        let source = self
+            .toolpath_configs
+            .iter()
+            .find(|s| s.id == source_toolpath_id)?;
+        let boundary = &source.boundary;
+        if !boundary.enabled
+            || !matches!(
+                boundary.source,
+                BoundarySource::Stock | BoundarySource::ModelSilhouette
+            )
+            || source.model_id != tc.model_id
+            || self.setup_of_toolpath_id(source.id) != self.setup_of_toolpath_id(tc.id)
+        {
+            return None;
+        }
+        let raw = Self::resolve_containment_polygon(boundary, stock_bbox, mesh, &[]).ok()??;
+        match boundary.containment {
+            BoundaryContainment::Inside => Some(vec![raw]),
+            BoundaryContainment::Center => {
+                let radius = self
+                    .tool_by_id(source.tool_id)
+                    .and_then(|tool| crate::session::session_cutter(tool).ok())?
+                    .diameter()
+                    / 2.0;
+                let grown = crate::polygon::offset_polygon(&raw, -radius);
+                (!grown.is_empty()).then_some(grown)
+            }
+            BoundaryContainment::Outside => None,
+        }
+    }
