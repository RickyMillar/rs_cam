+/// C35: one line per core zone of a run, with its 2D re-entries (the
+/// record's `rapids_inside`) and its 3D re-entries: the entries (a run of
+/// `EntryPlunge`, `EntryHelix` or `EntryRamp` moves) that end at the zone's
+/// level, inside its disc (radius less one planner cell) and more than R
+/// from the seed (the starter's plunge is at the seed). Inside a core cut
+/// as one spiral each of them is a re-entry the plan should not have.
+fn core_zone_lines(
+    label: &str,
+    tp: &Toolpath,
+    zones: &[CoreZoneRecord],
+) -> Vec<(String, usize, usize)> {
+    zones
+        .iter()
+        .map(|zone| {
+            let mut descents = 0usize;
+            for (k, mv) in tp.moves.iter().enumerate() {
+                let entry_end = is_entry(mv.intent)
+                    && tp
+                        .moves
+                        .get(k + 1)
+                        .is_none_or(|next| !is_entry(next.intent));
+                if !entry_end {
+                    continue;
+                }
+                let d = (mv.target.x - zone.seed_x).hypot(mv.target.y - zone.seed_y);
+                if (mv.target.z - zone.z_level).abs() <= TOLERANCE
+                    && d > TOOL_RADIUS
+                    && d < zone.radius_mm - planner_cell()
+                {
+                    descents += 1;
+                }
+            }
+            let mut line = format!(
+                "{label} core Z {:.2} seed ({:.2}, {:.2}) radius {:.2} mm, {} levels: 2D \
+                 re-entries {}, 3D entries inside {descents}",
+                zone.z_level,
+                zone.seed_x,
+                zone.seed_y,
+                zone.radius_mm,
+                zone.levels,
+                zone.rapids_inside
+            );
+            // D21 instrument: each re-entry and each raw over-step inside.
+            for detail in zone.rapid_lines.iter().chain(&zone.over_lines) {
+                line.push_str("\n    ");
+                line.push_str(detail);
+            }
+            (line, zone.rapids_inside, descents)
+        })
+        .collect()
+}
