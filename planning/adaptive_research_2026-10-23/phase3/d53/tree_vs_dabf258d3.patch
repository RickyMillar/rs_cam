     /// or a `SessionError::OperationFailed` naming exactly what's missing.
     ///
diff --git a/crates/rs_cam_core/tests/a_larger_rest_consumer_tool_refuses_d53.rs b/crates/rs_cam_core/tests/a_larger_rest_consumer_tool_refuses_d53.rs
