+/// D44 (P3_C12_derived_rest_regions.md §2): the XY regions a run left to
+/// the rest pass: the union over the levels of the pieces it left
+/// (`ClearZLevelContext::research_left_pieces`), grown by `grow` (one
+/// planner cell: a piece is a raster outline of the planner's region
+/// cells and can lie up to one cell inside the true region). `None` when
+/// the run left no piece. Geometry only (§13.8): a later step can take it
+/// for every strategy.
+pub(super) fn left_regions(pieces: &[(f64, Polygon2)], grow: f64) -> Option<Vec<Polygon2>> {
+    let all: Vec<Polygon2> = pieces.iter().map(|(_, p)| p.clone()).collect();
+    let union = Polygon2::union_all(&all);
+    let grown: Vec<Polygon2> = union
+        .iter()
+        .flat_map(|p| offset_polygon(p, -grow.max(0.0)))
+        .collect();
+    let out = if grown.is_empty() {
+        union
+    } else {
+        Polygon2::union_all(&grown)
+    };
+    (!out.is_empty()).then_some(out)
+}
