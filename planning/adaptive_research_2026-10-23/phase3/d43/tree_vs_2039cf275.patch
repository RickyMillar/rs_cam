+
+/// The chip-area load of a cut (§18.6, §18.11; the one definition the
+/// planner and the judge agree, C43): the lateral strips `strips`
+/// (`(strip index, engaged depth mm)`, in index order, `pitch_mm` apart)
+/// integrated across the strip centres by the trapezoid with the cutter's
+/// chip cross-section `chip.mrr_cross_section_mm2` (the area the power gate
+/// multiplies by feed), over that of a full pass across the cutter,
+/// `mrr_cross_section_mm2(depth_per_pass, diameter)`.
+///
+/// Each pair of neighbouring strips adds `mrr_cross_section_mm2(mean of
+/// their depths, pitch)`; strips with a gap between them add nothing across
+/// it. So a full-depth band of `n` strip centres reads `(n − 1) · pitch`
+/// wide over the diameter: the extent between its outermost centres, the
+/// quantity the flat swept-width read measures (`search.rs::swept_width_on`).
+/// A layer `t` thinner than a pass reads `t / depth_per_pass` of that.
+#[must_use]
+pub fn strips_chip_load(
+    chip: ToolGeometryHint,
+    depth_per_pass: f64,
+    diameter: f64,
+    strips: impl IntoIterator<Item = (i64, f64)>,
+    pitch_mm: f64,
+) -> f64 {
+    let mut area = 0.0_f64;
+    let mut prev: Option<(i64, f64)> = None;
+    for (index, depth) in strips {
+        if let Some((p_index, p_depth)) = prev
+            && index == p_index + 1
+        {
+            area += chip.mrr_cross_section_mm2(0.5 * (p_depth + depth), pitch_mm);
+        }
+        prev = Some((index, depth));
+    }
+    area / chip.mrr_cross_section_mm2(depth_per_pass, diameter)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::strips_chip_load;
+    use crate::feeds::ToolGeometryHint;
+
+    /// §18.11 sentry of the one definition: at a full pass (every strip one
+    /// Depth/Pass deep) the load of `n` strip centres a cell apart is the
+    /// extent between the outermost centres over the diameter,
+    /// `(n − 1) · cell / D`, bit for bit, for 1 to 13 centres (a slot of a
+    /// 6 mm cutter on a 0.5 mm lattice), for the rectangular and the V-bit
+    /// cross-section (their shape factor cancels).
+    #[test]
+    fn a_full_pass_reads_the_extent_over_the_diameter() {
+        const D: f64 = 6.0;
+        const CELL: f64 = 0.5;
+        for chip in [
+            ToolGeometryHint::Flat,
+            ToolGeometryHint::VBit {
+                included_angle: 90.0,
+                tip_diameter: 0.0,
+            },
+        ] {
+            for dpp in [3.0, 6.0] {
+                for n in 1..=13_i64 {
+                    let load = strips_chip_load(chip, dpp, D, (0..n).map(|i| (i, dpp)), CELL);
+                    let extent = (n - 1) as f64 * CELL / D;
+                    assert_eq!(
+                        load.to_bits(),
+                        extent.to_bits(),
+                        "{chip:?}, DPP {dpp}, {n} centres: load {load}, extent {extent}"
+                    );
+                }
+            }
+        }
+    }
+
+    /// §18.11: a layer `t` across the strips reads `t / DPP` of the
+    /// full-pass load of the same strips; a gap between strips adds nothing
+    /// across it.
+    #[test]
+    fn a_thin_layer_reads_its_depth_over_the_pass_and_a_gap_adds_nothing() {
+        const D: f64 = 6.0;
+        const CELL: f64 = 0.5;
+        const DPP: f64 = 6.0;
+        for t in [0.1, 0.5, 1.5, 3.0] {
+            let full = strips_chip_load(
+                ToolGeometryHint::Flat,
+                DPP,
+                D,
+                (0..9).map(|i| (i, DPP)),
+                CELL,
+            );
+            let thin =
+                strips_chip_load(ToolGeometryHint::Flat, DPP, D, (0..9).map(|i| (i, t)), CELL);
+            assert!(
+                (thin - full * t / DPP).abs() <= 1e-15,
+                "layer {t}: {thin} against {}",
+                full * t / DPP
+            );
+        }
+        let split = strips_chip_load(
+            ToolGeometryHint::Flat,
+            DPP,
+            D,
+            [(0, DPP), (1, DPP), (5, DPP), (6, DPP)],
+            CELL,
+        );
+        assert_eq!(
+            split.to_bits(),
+            (2.0 * CELL / D).to_bits(),
+            "two bands of two centres"
+        );
+    }
+}
