+fn stepped_face() -> TriangleMesh {
+    height_field(MESH_HALF, MESH_STEP, |x, y| {
+        if x.abs() <= POCKET_HALF_X && y.abs() <= POCKET_HALF_Y {
+            if x.abs() <= 11.0 {
+                FLOOR_Z + 1.5
+            } else {
+                FLOOR_Z
+            }
+        } else {
+            TOP_Z
+        }
+    })
+}
