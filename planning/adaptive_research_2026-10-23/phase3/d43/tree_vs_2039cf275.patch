+                        "{name}, {split:?}: move {m} plunges {depth:.3} mm into stock at \
+                         ({:.2}, {:.2}), over the pass {dpp} (+ sim cell {SIM_CELL})",
+                        at[0], at[1]
+                    ));
+                }
+            }
+            eprintln!(
+                "{name}, {split:?}: {} moves, {} entries; step split made {} (by load {}), \
+                 avoided {}; split entries {} (over the pass {}, deepest planner read {:.3} mm); \
+                 plunge strokes into stock {strokes}, deepest {deepest:.3} mm",
+                tp.moves.len(),
+                entry_count(tp),
+                stats.made,
+                stats.width_split,
+                stats.avoided,
+                stats.split_entries,
+                stats.split_entries_over_dpp,
+                stats.max_split_entry_stock_mm
+            );
+            if stats.split_entries_over_dpp > 0 {
+                failures.push(format!(
+                    "{name}, {split:?}: {} split entries the planner reads as cutting more \
+                     than the pass {dpp} (deepest {:.3} mm)",
+                    stats.split_entries_over_dpp, stats.max_split_entry_stock_mm
+                ));
+            }
+        }
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
