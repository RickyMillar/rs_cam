+fn entry_records(
+    tp: &Toolpath,
+    causes: &[EntryCauseRecord],
+    joins: &[JoinsRecord],
+) -> Vec<EntryRecord> {
+    use crate::toolpath::{MoveIntent, MoveType};
+    let cause_at: std::collections::HashMap<(i64, i64), EntryCause> =
+        causes.iter().map(|c| (xy_key(c.x, c.y), c.cause)).collect();
+    let join_at: std::collections::HashMap<
+        (i64, i64),
+        crate::adaptive::research_geodesic::JoinClass,
+    > = joins
+        .iter()
+        .flat_map(|j| &j.reentries)
+        .filter_map(|r| r.join.map(|class| (xy_key(r.at.x, r.at.y), class)))
+        .collect();
+    let is_entry = |i: MoveIntent| {
+        matches!(
+            i,
+            MoveIntent::EntryPlunge | MoveIntent::EntryHelix | MoveIntent::EntryRamp
+        )
+    };
+    let moves = &tp.moves;
+    let mut out = Vec::new();
+    let mut k = 0usize;
+    while k < moves.len() {
+        let Some(first) = moves.get(k) else { break };
+        if !is_entry(first.intent) {
+            k += 1;
+            continue;
+        }
+        // The run: entry moves, and the peck's retracts at the same XY.
+        let mut last = k;
+        let mut j = k + 1;
+        while let Some(m) = moves.get(j) {
+            if is_entry(m.intent) {
+                last = j;
+            } else if !(m.intent == MoveIntent::Retract
+                && moves.get(last).is_some_and(|l| {
+                    (l.target.x - m.target.x).abs() < 1e-9 && (l.target.y - m.target.y).abs() < 1e-9
+                }))
+            {
+                break;
+            }
+            j += 1;
+        }
+        let Some(end) = moves.get(last).map(|m| m.target) else {
+            break;
+        };
+        let start_z = k
+            .checked_sub(1)
+            .and_then(|i| moves.get(i))
+            .map_or(end.z, |m| m.target.z);
+        // The traverse before the entry: the last move before the run that
+        // ends at another XY than the one before it.
+        let kind = (1..k)
+            .rev()
+            .find_map(|i| {
+                let (a, b) = (moves.get(i - 1)?, moves.get(i)?);
+                ((b.target.x - a.target.x).hypot(b.target.y - a.target.y) > 1e-9)
+                    .then_some(matches!(b.move_type, MoveType::Rapid))
