+    let mut current: Vec<crate::adaptive::AdaptiveSegment> = Vec::new();
+    for s in segs_2d_raw {
+        if matches!(s, crate::adaptive::AdaptiveSegment::Rapid(_)) && !current.is_empty() {
+            groups.push(std::mem::take(&mut current));
