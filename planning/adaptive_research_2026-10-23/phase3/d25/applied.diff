+/// after the 2D replay admitted the plan's links; the replay after the
+/// filter must refuse the links that crossed a dropped group's ground. The
+/// other tests run with the filter off (`min_region_cut_length_mm` 0).
+/// Two levels, no simulation.
+#[test]
+fn no_held_link_crosses_standing_stock_with_the_group_filter_on() {
+    let mesh = pocket_with_island();
+    let index = SpatialIndex::build(&mesh, 10.0);
+    let threshold = rs_cam_core::compute::operation_configs::Adaptive3dConfig::default()
+        .min_region_cut_length_mm;
