+    for (label, options) in [
+        ("geodesic_local_oneway", GeodesicOptions::C16_LOCAL_ONEWAY),
+        ("geodesic_local_zigzag", GeodesicOptions::C20_LOCAL_ZIGZAG),
+        ("geodesic_local_zigzag_v2", GeodesicOptions::C23_ZIGZAG_V2),
+        (
+            "geodesic_local_zigzag_pick",
+            GeodesicOptions::C28_ZIGZAG_PICK,
+        ),
+        (
+            "geodesic_local_spiral_pick",
+            GeodesicOptions::C35_SPIRAL_PICK,
+        ),
+        (
+            "geodesic_local_spiral_headon",
+            GeodesicOptions::C37_SPIRAL_HEADON,
+        ),
+    ] {
+        let mut p = params(ClearingStrategy3d::Geodesic(options));
+        p.linking.min_region_cut_length_mm = threshold;
+        let (out, _, _, _, _, link_faults, _) = plan(&mesh, &index, &p);
+        eprintln!(
+            "{label} with the group filter at {threshold} mm: {} moves, {} entries, {} held \
+             links over standing stock",
+            out.toolpath.moves.len(),
+            entry_count(&out.toolpath),
+            link_faults.len()
+        );
+        assert!(
+            link_faults.is_empty(),
+            "{label}: held links over standing stock: {link_faults:#?}"
+        );
+    }
+}
