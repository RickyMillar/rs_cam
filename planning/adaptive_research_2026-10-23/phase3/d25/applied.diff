+        out.push(EntryRecord {
+            x: end.x,
+            y: end.y,
+            z: end.z,
+            drop_mm: start_z - end.z,
+            kind,
+            cause: cause_at.get(&key).copied(),
+            join: join_at.get(&key).copied(),
+        });
+        k = j;
+    }
+    out
+}
