+        return Some(grown);
+    };
+    let grow = tool_radius - margin;
+    if !grow.is_finite() || grow <= 0.0 {
+        return Some(grown);
+    }
+    let reach: Vec<Polygon2> = clip
+        .polygons()
+        .iter()
+        .flat_map(|poly| offset_polygon(poly, -grow))
+        .collect();
+    if reach.is_empty() {
+        return None;
+    }
+    let inside = |poly: &Polygon2| {
+        reach
+            .iter()
+            .any(|r| poly.exterior.iter().all(|p| r.contains_point(p)))
+    };
+    let out: Vec<Polygon2> = grown
+        .into_iter()
+        .flat_map(|poly| {
+            if inside(&poly) {
+                vec![poly]
+            } else {
+                reach.iter().flat_map(|r| poly.intersection(r)).collect()
+            }
+        })
+        .filter(|poly| poly.exterior.len() >= 3)
+        .collect();
+    (!out.is_empty()).then_some(out)
+}
+
+/// §13.2: one chain of steps whose emitted moves get a reduced feed: the
+/// points of one slot loop in plan order, and the feed factor of each step
+/// (`factors[k]` for the step `pts[k] .. pts[k + 1]`). Toolpath data only
+/// (§13.8): a shared feed layer can take chains from any producer.
+#[derive(Debug, Clone)]
+pub struct FeedChain {
+    pub pts: Vec<P2>,
+    pub factors: Vec<f64>,
+}
+
+/// §13.2: what [`apply_chain_feeds`] did.
+#[derive(Debug, Clone, Default)]
+pub struct ChainFeedSummary {
+    pub chains: usize,
+    pub steps: usize,
+    /// Steps with a factor under 1 (they need a reduced feed).
+    pub reduced: usize,
+    /// Steps some move covered.
+    pub fed: usize,
+    /// Steps with a factor under 1 that no move covered.
+    pub unfed: usize,
+    /// Moves whose feed was lowered.
+    pub moves_lowered: usize,
+    /// Matches of a chain after a cutting move that is not on it, inside
+    /// the chain's own run (an interleaved move; the design asserts 0).
+    pub matched_out_of_run: usize,
+    pub lowest_factor: f64,
+    pub longest_move_mm: f64,
+    /// The chains matched against and the tolerance, so that a test can
+    /// find the slot moves again by geometry alone.
+    pub chain_list: Vec<FeedChain>,
+    pub tolerance: f64,
+}
+
+/// §13.2: the slot chains of a run's records: the kept slot records
+/// ([`TurnKind::Slot`], not both ends outside the boundary clip), split into
+/// chains where a record does not start at the end of the one before (a new
+/// loop).
+pub(super) fn slot_chains(turns: &SliceTurns) -> Vec<FeedChain> {
+    let mut chains: Vec<FeedChain> = Vec::new();
+    let mut last: Option<P2> = None;
+    for ((rec, kind), ends) in turns
+        .records
+        .iter()
+        .zip(&turns.kinds)
+        .zip(&turns.ends_inside)
+    {
+        if *kind != TurnKind::Slot || *ends == (false, false) {
+            last = None;
+            continue;
+        }
+        let joined = last.is_some_and(|q| (q.x - rec.from.x).hypot(q.y - rec.from.y) <= 1e-6);
+        match chains.last_mut() {
+            Some(chain) if joined => {
+                chain.pts.push(rec.to);
+                chain.factors.push(rec.feed_factor);
+            }
+            _ => chains.push(FeedChain {
+                pts: vec![rec.from, rec.to],
+                factors: vec![rec.feed_factor],
+            }),
+        }
+        last = Some(rec.to);
+    }
+    chains
+}
+
+/// The nearest step of `pts` to `q`: (step index, distance).
+fn nearest_step(pts: &[P2], q: &P2) -> Option<(usize, f64)> {
+    pts.windows(2)
+        .enumerate()
+        .filter_map(|(k, w)| match w {
+            [a, b] => Some((k, point_to_segment_distance(q, a, b))),
+            _ => None,
+        })
+        .min_by(|x, y| x.1.total_cmp(&y.1))
+}
+
+/// §13.2: lower the feed of each emitted `Linear` move that runs along a
+/// chain to `feed_rate` × the lowest factor of the steps it covers (a feed
+/// is only lowered). A move matches a chain when:
+/// 1. its ends and its points at a spacing of `tolerance` lie within
+///    `tolerance` of the chain;
+/// 2. it runs the chain's way (its direction against the nearest step of
+///    its midpoint);
+/// 3. it covers a step no move has covered yet;
+/// 4. the chain is not before the last matched chain (the toolpath keeps
+///    the plan order, so a chain's own moves come first).
+///
+/// `tolerance` is the RDP tolerance that simplified the cuts
+/// (`Adaptive3dParams::emission_chord_tolerance`): RDP keeps a point only if
+/// every dropped point is within it of the kept segment, and the tube round
+/// a segment is convex, so a merged move lies within it of its chain both
+/// ways (P3_C38 §13.2). The lift, the drape and the boundary clip move no
+/// point in XY. 1e-6 mm is the same-point tolerance of the turn match.
+pub(super) fn apply_chain_feeds(
+    tp: &mut Toolpath,
+    chains: &[FeedChain],
+    tolerance: f64,
+    feed_rate: f64,
+) -> ChainFeedSummary {
+    let d = tolerance.max(0.0) + 1e-6;
+    let boxes: Vec<(P2, P2)> = chains
+        .iter()
+        .map(|c| {
+            c.pts.iter().fold(
+                (
+                    P2::new(f64::INFINITY, f64::INFINITY),
+                    P2::new(f64::NEG_INFINITY, f64::NEG_INFINITY),
+                ),
+                |(lo, hi), p| {
+                    (
+                        P2::new(lo.x.min(p.x), lo.y.min(p.y)),
+                        P2::new(hi.x.max(p.x), hi.y.max(p.y)),
+                    )
+                },
+            )
+        })
+        .collect();
+    let in_box = |k: usize, p: &P2| {
+        boxes.get(k).is_some_and(|(lo, hi)| {
+            p.x >= lo.x - d && p.x <= hi.x + d && p.y >= lo.y - d && p.y <= hi.y + d
+        })
+    };
+    let mut covered: Vec<Vec<bool>> = chains
+        .iter()
+        .map(|c| vec![false; c.factors.len()])
+        .collect();
+    let mut last_move: Vec<Option<usize>> = vec![None; chains.len()];
+    let mut summary = ChainFeedSummary {
+        chains: chains.len(),
+        steps: chains.iter().map(|c| c.factors.len()).sum(),
+        reduced: chains
+            .iter()
+            .flat_map(|c| &c.factors)
+            .filter(|&&f| f < 1.0)
+            .count(),
+        lowest_factor: 1.0,
+        chain_list: chains.to_vec(),
+        tolerance: d,
+        ..ChainFeedSummary::default()
+    };
+    let mut cursor = 0usize;
+    let mut start: Option<P2> = None;
+    let mut cutting_since: Vec<bool> = vec![false; chains.len()];
+    for (i, m) in tp.moves.iter_mut().enumerate() {
+        let b = P2::new(m.target.x, m.target.y);
+        let mut matched = None;
+        if let (Some(a), MoveType::Linear { feed_rate: f }) = (start, &mut m.move_type) {
+            let len = (b.x - a.x).hypot(b.y - a.y);
+            if len > 1e-6 {
+                let n = (len / d).ceil().max(1.0) as usize;
+                for k in cursor..chains.len() {
+                    let Some(chain) = chains.get(k) else {
+                        continue;
+                    };
+                    if !in_box(k, &a) || !in_box(k, &b) {
+                        continue;
+                    }
+                    let mut lo = usize::MAX;
+                    let mut hi = 0usize;
+                    let mut ok = true;
+                    for s in 0..=n {
+                        let t = s as f64 / n as f64;
+                        let q = P2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y));
+                        match nearest_step(&chain.pts, &q) {
+                            Some((j, dist)) if dist <= d => {
+                                lo = lo.min(j);
+                                hi = hi.max(j);
+                            }
+                            _ => {
+                                ok = false;
+                                break;
+                            }
+                        }
+                    }
+                    if !ok || lo > hi {
+                        continue;
+                    }
+                    let mid = P2::new((a.x + b.x) / 2.0, (a.y + b.y) / 2.0);
+                    let forward = nearest_step(&chain.pts, &mid).is_some_and(|(j, _)| {
+                        match (chain.pts.get(j), chain.pts.get(j + 1)) {
+                            (Some(p), Some(q)) => {
+                                (b.x - a.x) * (q.x - p.x) + (b.y - a.y) * (q.y - p.y) > 0.0
+                            }
+                            _ => false,
+                        }
+                    });
+                    let fresh = covered
+                        .get(k)
+                        .is_some_and(|c| c.iter().take(hi + 1).skip(lo).any(|v| !v));
+                    if forward && fresh {
+                        let factor = chain
+                            .factors
+                            .iter()
+                            .take(hi + 1)
+                            .skip(lo)
+                            .fold(1.0_f64, |acc, &x| acc.min(x));
+                        if factor < 1.0 {
+                            *f = f.min(feed_rate * factor);
+                            summary.moves_lowered += 1;
+                            summary.lowest_factor = summary.lowest_factor.min(factor);
+                            summary.longest_move_mm = summary.longest_move_mm.max(len);
+                        }
+                        if let Some(c) = covered.get_mut(k) {
+                            for v in c.iter_mut().take(hi + 1).skip(lo) {
+                                *v = true;
+                            }
+                        }
+                        if last_move.get(k).copied().flatten().is_some()
+                            && cutting_since.get(k).copied().unwrap_or(false)
+                        {
+                            summary.matched_out_of_run += 1;
+                        }
+                        if let Some(slot) = last_move.get_mut(k) {
+                            *slot = Some(i);
+                        }
+                        matched = Some(k);
+                        break;
+                    }
+                }
+            }
+            // A cutting move that is not on a chain, after that chain's
+            // run started, marks the run as interleaved.
+            if matched.is_none() && len > 1e-6 {
+                for (k, flag) in cutting_since.iter_mut().enumerate() {
+                    if last_move.get(k).copied().flatten().is_some() {
+                        *flag = true;
+                    }
+                }
+            }
+        }
+        if let Some(k) = matched {
+            // The plan-order cursor (rule 4): later moves try this chain
+            // and the ones after it.
+            cursor = k;
+        }
+        if let Some(k) = matched
+            && let Some(flag) = cutting_since.get_mut(k)
+        {
+            *flag = false;
+        }
+        start = Some(b);
+    }
+    summary.fed = covered.iter().flatten().filter(|&&v| v).count();
+    summary.unfed = chains
+        .iter()
+        .zip(&covered)
+        .flat_map(|(c, cov)| c.factors.iter().zip(cov))
+        .filter(|(f, v)| **f < 1.0 && !**v)
+        .count();
+    summary
+}
