+/// C38 §13.3: a straight channel whose 2D tool-centre region is about one
+/// stepover wide, so the field's seed (a centre clearance of R) does not
+/// fit and the corridor opening plans it with counted slots. The channel
+/// width in material space is `2R + 2·(SIMPLIFY_INSET + cell) + s`: the
+/// region (in tool-centre space, `2R` narrower) loses the C31 smoothing
+/// inset and the one-cell margin on each side, which leaves about `s`.
+const CHANNEL_HALF_LENGTH: f64 = 30.0;
+/// The shipped region smoothing inset (`adaptive3d/clearing.rs`,
+/// `SIMPLIFY_INSET`).
+const SIMPLIFY_INSET: f64 = 0.3;
+
+fn channel_half_width() -> f64 {
+    (2.0 * TOOL_RADIUS + 2.0 * (SIMPLIFY_INSET + planner_cell()) + STEPOVER) / 2.0
+}
+
+fn channel() -> TriangleMesh {
+    let hw = channel_half_width();
+    height_field(MESH_HALF, MESH_STEP, |x, y| {
+        if x.abs() <= CHANNEL_HALF_LENGTH && y.abs() <= hw {
+            FLOOR_Z
+        } else {
+            TOP_Z
+        }
+    })
+}
+
+/// The XY distance from `q` to the polyline `pts`.
+fn chain_distance(q: (f64, f64), pts: &[rs_cam_core::geo::P2]) -> f64 {
+    pts.windows(2)
+        .map(|w| {
+            let (a, b) = (w[0], w[1]);
+            let (dx, dy) = (b.x - a.x, b.y - a.y);
+            let l2 = dx * dx + dy * dy;
+            let t = if l2 > 0.0 {
+                (((q.0 - a.x) * dx + (q.1 - a.y) * dy) / l2).clamp(0.0, 1.0)
+            } else {
+                0.0
+            };
+            (q.0 - a.x - t * dx).hypot(q.1 - a.y - t * dy)
+        })
+        .fold(f64::INFINITY, f64::min)
+}
+
+/// C38 §13.3 (the fed slot, design A): in the channel, the research arm
+/// plans corridor slots, every slot step the toolpath needs slower is fed,
+/// and every simulated sample over the screen bound on a move that runs
+/// along a slot chain carries a feed below the op feed. The slot moves are
+/// found here again by geometry (each point of the move within the chain
+/// tolerance of a chain), not by their feed, so the check is not circular.
+/// Entry moves and the steps that leave a straight plunge within R of it
+/// are not judged (the 2D exemption).
+#[test]
+#[ignore = "heavy: plans and simulates the channel fixture (two levels); run with -- --ignored"]
+fn the_corridor_slots_run_at_the_reduced_feed() {
+    let mesh = channel();
+    let index = SpatialIndex::build(&mesh, 10.0);
+    let p = params(ClearingStrategy3d::Geodesic(
+        GeodesicOptions::C35_SPIRAL_PICK,
+    ));
+    let (out, research) = plan(&mesh, &index, &p);
+    // Where the corridor plan went (D27 v3 read no chain): the region
+    // openings (C31), the slots the producer planned and the slot records
+    // the 2D replay kept (C22's exact-match summary, `planned` and `cut`),
+    // and the size of the plan.
+    for line in opening_lines("channel", &research.openings) {
+        eprintln!("{line}");
+    }
+    eprintln!(
+        "channel: slots planned {}, slot records {}; {} moves, {} entries",
+        research.slots.planned,
+        research.slots.turns.len(),
+        out.toolpath.moves.len(),
+        entry_count(&out.toolpath)
+    );
+    let chains = &research.slot_chains;
+    eprintln!(
+        "channel: half width {:.3} mm; slot chains {} steps {} reduced {} fed {} unfed {} lowered {} out of run {} lowest {:.3} longest move {:.3} mm",
+        channel_half_width(),
+        chains.chains,
+        chains.steps,
+        chains.reduced,
+        chains.fed,
+        chains.unfed,
+        chains.moves_lowered,
+        chains.matched_out_of_run,
+        chains.lowest_factor,
+        chains.longest_move_mm
+    );
+    assert!(chains.chains > 0, "the channel planned no corridor slot");
+    assert!(
+        chains.reduced > 0,
+        "no slot step needs a reduced feed: the fixture tests nothing"
+    );
+    assert_eq!(
+        chains.unfed, 0,
+        "slot steps that need a reduced feed and no move carries"
+    );
+    assert_eq!(
+        chains.matched_out_of_run, 0,
+        "a slot chain matched out of its own run"
+    );
+
+    let tp = &out.toolpath;
+    let cutter = FlatEndmill::new(2.0 * TOOL_RADIUS, 25.0);
+    let b = &mesh.bbox;
+    let mut stock = TriDexelStock::from_stock(
+        b.min.x - TOOL_RADIUS,
+        b.min.y - TOOL_RADIUS,
+        b.max.x + TOOL_RADIUS,
+        b.max.y + TOOL_RADIUS,
+        b.min.z,
+        TOP_Z,
+        SIM_CELL,
+    );
+    let samples = stock
+        .simulate_toolpath_with_metrics_with_cancel(
+            tp,
+            &cutter,
+            StockCutDirection::FromTop,
+            ToolpathId::from_raw(0),
+            12_000,
+            2,
+            3000.0,
+            SIM_CELL,
+            None,
+            &[],
+            &[],
+            false,
+            &|| false,
+        )
+        .expect("the simulation is not cancelled");
+    // The slot moves by geometry: every point of the move within the chain
+    // tolerance of one chain.
+    let on_chain: Vec<bool> = (0..tp.moves.len())
+        .map(|m| {
+            if m == 0 || !matches!(tp.moves[m].move_type, MoveType::Linear { .. }) {
+                return false;
+            }
+            let pts = move_points(tp.moves[m - 1].target, &tp.moves[m], chains.tolerance);
+            chains.chain_list.iter().any(|c| {
+                pts.iter()
+                    .all(|&q| chain_distance(q, &c.pts) <= chains.tolerance)
+            })
+        })
+        .collect();
+    let screen = sim_bound();
+    let mut hole: Option<(f64, f64)> = None;
+    let mut judged = 0usize;
+    let mut faults = Vec::new();
+    for s in &samples {
+        let m = s.move_index;
+        let Some(mv) = tp.moves.get(m) else { continue };
+        if mv.intent == MoveIntent::EntryPlunge {
+            hole = Some((mv.target.x, mv.target.y));
+        }
+        if !s.is_cutting || is_entry(mv.intent) {
+            continue;
+        }
+        let [x, y, _] = s.position;
+        if let Some((hx, hy)) = hole {
+            if (x - hx).hypot(y - hy) <= TOOL_RADIUS {
+                continue;
+            }
+            hole = None;
+        }
+        if !on_chain.get(m).copied().unwrap_or(false) {
+            continue;
+        }
+        judged += 1;
+        if s.engagement.radial_woc_fraction > screen && s.feed_rate_mm_min >= p.feed_rate - 1e-9 {
+            faults.push(format!(
+                "move {m} at ({x:.2}, {y:.2}): radial {:.3} at feed {:.0}",
+                s.engagement.radial_woc_fraction, s.feed_rate_mm_min
+            ));
+        }
+    }
+    eprintln!(
+        "channel: {judged} samples on slot moves, {} over the screen at the full feed",
+        faults.len()
+    );
+    assert!(judged > 0, "no simulated sample lies on a slot move");
+    assert!(
+        faults.is_empty(),
+        "over-ceiling slot samples at the full feed: {faults:#?}"
+    );
+}
