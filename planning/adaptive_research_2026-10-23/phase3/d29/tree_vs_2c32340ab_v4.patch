+/// The keep-down proof of a link that feeds at depth from `from` to `to`
+/// (any strategy's held link): the point of the swept disc of `radius`
+/// (sampled as [`corridor_ceiling_z`] samples it) where the conservative
+/// stock top stands highest above `ceiling_z`, and that height; `None`
+/// when no column of the disc stands above `ceiling_z`, so the link may
+/// stay down.
+///
+/// The ceiling a caller passes is the top of the slab the link's level
+/// cuts plus the stay-down clearance (the dexel resolution,
+/// `plan_entry`'s allowance). Inside the slab a link held to the 2D pass
+/// load may cut a side band up to `c·D` wide (G-ADAPTLINKLOAD): that is
+/// planned. A column above the slab is stock the level above did not cut,
+/// which no planned move of this level takes (C38 §14: the fed-link bars).
+/// Research only until a shipped strategy's held links adopt it.
+#[cfg(feature = "research")]
+pub(super) fn keep_down_excess(
+    stock: &TriDexelStock,
+    from: P3,
+    to: P3,
+    radius: f64,
+    ceiling_z: f64,
+) -> Option<(P2, f64)> {
+    let dx = to.x - from.x;
+    let dy = to.y - from.y;
+    let len = (dx * dx + dy * dy).sqrt();
+    let step = (stock.z_grid.cell_size * 0.5).max(1e-3);
+    let n = (len / step).ceil().max(1.0) as usize;
+    (0..=n)
+        .filter_map(|k| {
+            let t = k as f64 / n as f64;
+            let p = P2::new(from.x + dx * t, from.y + dy * t);
+            stock
+                .max_conservative_top_z_in_disc(p.x, p.y, radius)
+                .filter(|&top| top > ceiling_z)
+                .map(|top| (p, top - ceiling_z))
+        })
+        .max_by(|a, b| a.1.total_cmp(&b.1))
+}
+
+/// §16 Part A: the deepest axial engagement (mm) of a feed move from `p`
+/// to `q` with a tool of `radius`: at each sample along the move (every
+/// half cell, as [`corridor_ceiling_z`]), the conservative stock top over
+/// the disc less the tool's Z there. `NEG_INFINITY` when the move is off
+/// the grid. Any strategy's draped cut can read it.
+pub(super) fn step_axial_depth(stock: &TriDexelStock, p: P3, q: P3, radius: f64) -> f64 {
+    let dx = q.x - p.x;
+    let dy = q.y - p.y;
+    let len = (dx * dx + dy * dy).sqrt();
+    let step = (stock.z_grid.cell_size * 0.5).max(1e-3);
+    let n = (len / step).ceil().max(1.0) as usize;
+    (0..=n)
+        .filter_map(|k| {
+            let t = k as f64 / n as f64;
+            let z = p.z + t * (q.z - p.z);
+            stock
+                .max_conservative_top_z_in_disc(p.x + dx * t, p.y + dy * t, radius)
+                .map(|top| top - z)
+        })
+        .fold(f64::NEG_INFINITY, f64::max)
+}
