+/// §16 Part A (P3_C22_3d_turns.md §16.7): the stock-read split holds the
+/// exact bound where it acts. The heavy test's two-level plan has no
+/// large-Z step, so Part A has nothing to act on there. One level from the
+/// top to the floor (as [`the_geodesic_arm_feeds_its_turns_down_at_the_level`])
+/// drapes over the island and gives each arm its large-Z steps. For each G1
+/// arm, with the stock-read split (the research arm's rule) and the routed
+/// keep-down travel OFF (`Some(KeepDownRoute::Off)`), the simulation must
+/// read no judged sample over the exact bound, and at least one arm must
+/// have a step the rule cut at feed (else the test proves nothing).
+#[test]
+#[ignore = "heavy: about 6 min in debug: six one-level 3D plans and six dexel simulations \
+            with exact readings; run by name with --ignored (§16 Part A)"]
+fn the_stock_read_split_holds_the_exact_bound_on_draped_steps() {
+    let mesh = pocket_with_island();
+    let index = SpatialIndex::build(&mesh, 10.0);
+    let mut failures: Vec<String> = Vec::new();
+    let mut avoided_total = 0usize;
+    for (label, options) in [
+        ("geodesic_local_oneway", GeodesicOptions::C16_LOCAL_ONEWAY),
+        ("geodesic_local_zigzag", GeodesicOptions::C20_LOCAL_ZIGZAG),
+        ("geodesic_local_zigzag_v2", GeodesicOptions::C23_ZIGZAG_V2),
+        (
+            "geodesic_local_zigzag_pick",
+            GeodesicOptions::C28_ZIGZAG_PICK,
+        ),
+        (
+            "geodesic_local_spiral_pick",
+            GeodesicOptions::C35_SPIRAL_PICK,
+        ),
+        (
+            "geodesic_local_spiral_headon",
+            GeodesicOptions::C37_SPIRAL_HEADON,
+        ),
+    ] {
+        let mut p = params(ClearingStrategy3d::Geodesic(options));
+        p.depth.depth_per_pass = TOP_Z - FLOOR_Z;
+        p.linking.step_split = StepSplit::StockDepth;
+        p.linking.keep_down_route = Some(KeepDownRoute::Off);
+        let (out, research) = plan(&mesh, &index, &p);
+        let stats = research.split_stats;
+        eprintln!(
+            "{label} one level: step split made {}, avoided {}, max ap avoided {:.3} mm; route \
+             tried {}",
+            stats.made, stats.avoided, stats.max_ap_avoided_mm, research.route_stats.tried
+        );
+        avoided_total += stats.avoided;
+        if research.route_stats.tried > 0 {
+            failures.push(format!(
+                "{label}: the router ran ({} tries) with keep_down_route Some(Off)",
+                research.route_stats.tried
+            ));
+        }
+        let r = read(&mesh, &out, &research.turns, false);
+        eprintln!("{}", summary(label, &r));
+        for line in &r.screened {
+            eprintln!("  {label} screened: {line}");
+        }
+        for probe in &r.probes {
+            eprintln!("  {label} {probe}");
+        }
+        if !r.over.is_empty() {
+            failures.push(format!(
+                "{label}: {} judged samples read over the exact bound {:.3} (exact peak {:.3}); \
+                 the first: {}",
+                r.over.len(),
+                exact_bound(),
+                r.peak_exact,
+                r.over.first().map_or("", String::as_str)
+            ));
+        }
+    }
+    if avoided_total == 0 {
+        failures.push("no arm had a large-Z step the stock-read rule cut at feed".to_owned());
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
