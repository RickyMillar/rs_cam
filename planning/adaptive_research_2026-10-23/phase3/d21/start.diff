+/// One line per polygon of a stage of the C34 probe: the exterior's signed
+/// area and each hole's signed area (mm²; CCW positive).
+fn c34_stage(label: &str, polys: &[rs_cam_core::polygon::Polygon2]) {
+    eprintln!("C34 {label}: {} polygon(s)", polys.len());
+    for (k, p) in polys.iter().enumerate() {
+        let holes: Vec<String> = p
+            .holes
+            .iter()
+            .map(|h| {
+                format!(
+                    "{:.1}",
+                    rs_cam_core::polygon::Polygon2::new(h.clone()).signed_area()
+                )
+            })
+            .collect();
+        eprintln!(
+            "  {k}: exterior {:.1}, holes [{}], area {:.1}",
+            p.signed_area(),
+            holes.join(", "),
+            p.area()
+        );
+    }
+}
