+/// C34 probe (wanaka200 Z 4.0 region 1, `phase3/fix7`): the steps of
+/// `research_grown_outlines` (less the RDP) on a frame ring of the same
+/// size: an exterior square of 40100 mm² with a square hole of 37520 mm²
+/// (region area 2580 mm²; band about 3.3 mm). It prints the polygons of
+/// each stage, so the stage where the hole turns into a filled polygon
+/// shows. D20 read `centre_area_mm2` 77602.8 ≈ the filled exterior
+/// (39631, the full-square value of the upper levels) + an island the size
+/// of the hole grown and inset again (≈ 37971).
+#[test]
+#[ignore = "instrument: C34 probe of the grown-outline steps on a frame ring; prints, asserts nothing"]
+fn c34_frame_ring_grow_probe() {
+    use rs_cam_core::geo::P2;
+    use rs_cam_core::polygon::{FlattenPolicy, OffsetRingSet, Polygon2, offset_polygon};
+    let square = |half: f64| {
+        vec![
+            P2::new(-half, -half),
+            P2::new(half, -half),
+            P2::new(half, half),
+            P2::new(-half, half),
+        ]
+    };
+    let outer_half = 40100.0_f64.sqrt() / 2.0;
+    let hole_half = 37520.0_f64.sqrt() / 2.0;
+    let mut hole = square(hole_half);
+    hole.reverse();
+    let region = Polygon2::with_holes(square(outer_half), vec![hole]);
+    c34_stage("region", std::slice::from_ref(&region));
+    let (r, m, inset, shortfall) = (TOOL_RADIUS, 0.25, 0.3, 0.26);
+    let smoothed = offset_polygon(&region, inset);
+    c34_stage("smoothed (inset 0.3, no RDP)", &smoothed);
+    let s_prime: Vec<Polygon2> = smoothed
+        .iter()
+        .flat_map(|p| offset_polygon(p, shortfall))
+        .collect();
+    c34_stage("after the shortfall inset", &s_prime);
+    let grown: Vec<Polygon2> = s_prime
+        .iter()
+        .flat_map(|p| {
+            OffsetRingSet::from_polygon(p)
+                .offset(-(r - m))
+                .to_polygons(FlattenPolicy::untoleranced())
+        })
+        .collect();
+    c34_stage("grown by R - m (OffsetRingSet)", &grown);
+    let grown_single: Vec<Polygon2> = s_prime
+        .iter()
+        .flat_map(|p| offset_polygon(p, -(r - m)))
+        .collect();
+    c34_stage(
+        "grown by R - m (offset_polygon, for comparison)",
+        &grown_single,
+    );
+    let centre: Vec<Polygon2> = grown.iter().flat_map(|g| offset_polygon(g, r)).collect();
+    c34_stage("centre (grown inset by R)", &centre);
+    let target: Vec<Polygon2> = s_prime.iter().flat_map(|p| offset_polygon(p, m)).collect();
+    c34_stage("target (shortfall-inset outline inset by m)", &target);
+}
