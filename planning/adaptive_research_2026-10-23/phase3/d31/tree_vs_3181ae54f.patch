+                exact_bound(),
+                r.peak_exact,
+                r.over.first().map_or("", String::as_str)
+            ));
+        }
+    }
+    if width_total == 0 {
+        failures.push("no arm had a step the width read split on the shelf".to_owned());
+    }
+    assert!(failures.is_empty(), "{failures:#?}");
+}
