+        let mut entry = ToolpathEntry::for_operation(
+            tc.id,
+            "Edges".to_owned(),
+            tc.tool_id.expect("the case tool"),
+            tc.model_id,
+            OperationType::Pocket,
+        );
+        entry.boundary.enabled = true;
+        entry.boundary.source = BoundarySource::DerivedRestRegions {
+            source_toolpath_id: source,
