@@ -0,0 +1,164 @@
+//! Geodesic Adaptive, the edges of its plan (research C38,
+//! `planning/adaptive_research_2026-10-23/P3_C38_outer_band.md`).
+//!
+//! The arm clears the body only (§16, operator ruling 2026-10-27). The outer
+//! strip and the stock-edge band go to a separate rest pass. The parts here
+//! keep the body's plan correct at its edges:
+//! - Item B: the grown outline stops at the stock box
+//!   ([`clip_to_stock_box`]). Beyond the box edge no material stands, so
+//!   the grow there would put phantom stock in the 2D grid.
+//! - §13.7: the grown outline also stops at the reach of the boundary clip
+//!   ([`clip_to_centre_reach`]), so nothing is planned where the clip
+//!   would drop it.
+//! - G-CLIPAIR (§11): the boundary clear keeps the stock a disc with its
+//!   centre inside the boundary can reach ([`boundary_reach`]), so the plan
+//!   reads the band it ploughs, and the level's regions stay inside the
+//!   boundary ([`RegionClip::restrict_regions`]). Global ordering only.
+//!
+//! §13.8: each helper takes geometry only; the strategy test sits at the
+//! call site, so a shared layer can adopt it unchanged.
+
+use crate::dexel_stock::TriDexelStock;
+use crate::polygon::{Polygon2, offset_polygon};
+
+use super::centre_clip::CentreClip;
+
+/// The C31 grown outlines of a region clipped to the XY box of the planner
+/// stock, or `None` when nothing is left (the region then keeps the
+/// shipped path, as when the grow gives no outline).
+///
+/// A polygon inside the box is returned unchanged, so a region away from
+/// the stock edge plans exactly as before.
+pub(super) fn clip_to_stock_box(
+    grown: Vec<Polygon2>,
+    stock: &TriDexelStock,
+) -> Option<Vec<Polygon2>> {
+    let (lo, hi) = (stock.stock_bbox.min, stock.stock_bbox.max);
+    let inside = |poly: &Polygon2| {
+        poly.exterior
+            .iter()
+            .all(|p| p.x >= lo.x && p.x <= hi.x && p.y >= lo.y && p.y <= hi.y)
+    };
+    let stock_box = Polygon2::rectangle(lo.x, lo.y, hi.x, hi.y);
+    let out: Vec<Polygon2> = grown
+        .into_iter()
+        .flat_map(|poly| {
+            if inside(&poly) {
+                vec![poly]
+            } else {
+                poly.intersection(&stock_box)
+            }
+        })
+        .filter(|poly| poly.exterior.len() >= 3)
+        .collect();
+    (!out.is_empty()).then_some(out)
+}
+
+/// G-CLIPAIR (§11 a): the boundary grown by the tool radius, the reach of a
+/// disc whose centre is inside `boundary`, or `None` when the radius is not
+/// usable or the grow is empty. The boundary clear then empties only the
+/// planner-stock cells outside this reach. The cells between the boundary
+/// and the reach keep their stock, which a cut from inside the boundary
+/// meets (P3_C38 §10.7, §11.1b). Geometry only (§13.8): the caller decides
+/// which strategies use it.
+pub(super) fn boundary_reach(boundary: &Polygon2, tool_radius: f64) -> Option<Vec<Polygon2>> {
+    if !tool_radius.is_finite() || tool_radius <= 0.0 {
+        return None;
+    }
+    let reach = offset_polygon(boundary, -tool_radius);
+    (!reach.is_empty()).then_some(reach)
+}
+
+/// G-CLIPAIR (§11 b): which planner-stock cells have their centre inside
+/// the boundary. Built by the boundary clear (`path.rs`) when
+/// [`boundary_reach`] gives a reach.
+pub(super) struct RegionClip {
+    /// One flag per planner-stock cell (row-major, `rows × cols`).
+    inside: Vec<bool>,
+    rows: usize,
+    cols: usize,
+}
+
+impl RegionClip {
+    pub(super) fn new(inside: Vec<bool>, rows: usize, cols: usize) -> Option<Self> {
+        (inside.len() == rows * cols).then_some(Self { inside, rows, cols })
+    }
+
+    /// Restrict a level's padded material grid (`build_material_bool_grid`:
+    /// cell `(r, c)` of the stock is padded cell `(r + 1, c + 1)`) to the
+    /// region cells of Geodesic Adaptive: a cell whose centre is outside the
+    /// boundary is not a region cell, whatever its stock (the boundary
+    /// clear gave this before). §16: the band stock the reach keeps is read
+    /// by the plan, but no region is made to cut it; the edge contour pass
+    /// cuts it.
+    pub(super) fn restrict_regions(
+        &self,
+        grid: &mut [bool],
+        padded_rows: usize,
+        padded_cols: usize,
+    ) {
+        if padded_rows != self.rows + 2 || padded_cols != self.cols + 2 {
+            return;
+        }
+        let at = |r: usize, c: usize| (r + 1) * padded_cols + (c + 1);
+        for r in 0..self.rows {
+            for c in 0..self.cols {
+                let inside = self.inside.get(r * self.cols + c).copied().unwrap_or(false);
+                if let Some(cell) = grid.get_mut(at(r, c))
+                    && !inside
+                {
+                    *cell = false;
+                }
+            }
+        }
+    }
+}
+
+/// §13.7: the C31 grown outlines of a region clipped to the reach of the
+/// boundary clip: each clip polygon grown by `tool_radius - margin`. The 2D
+/// planner insets its outline by the tool radius, so its tool-centre region
+/// then lies within the clip shrunk by `margin` (up to a concave notch of
+/// the clip narrower than twice the grow), and every turn, held link and
+/// wrap end it plans is one the clip keeps. `margin` is the C31 margin
+/// (`PERIMETER_INSET_MARGIN_MM`). With no clip the outlines pass unchanged;
+/// a polygon inside the reach is returned unchanged; `None` when nothing is
+/// left (the region then keeps the shipped path). Geometry only (§13.8).
+pub(super) fn clip_to_centre_reach(
+    grown: Vec<Polygon2>,
+    clip: Option<&CentreClip>,
+    tool_radius: f64,
+    margin: f64,
+) -> Option<Vec<Polygon2>> {
+    let Some(clip) = clip else {
+        return Some(grown);
+    };
+    let grow = tool_radius - margin;
+    if !grow.is_finite() || grow <= 0.0 {
+        return Some(grown);
+    }
+    let reach: Vec<Polygon2> = clip
+        .polygons()
+        .iter()
+        .flat_map(|poly| offset_polygon(poly, -grow))
+        .collect();
+    if reach.is_empty() {
+        return None;
+    }
+    let inside = |poly: &Polygon2| {
+        reach
+            .iter()
+            .any(|r| poly.exterior.iter().all(|p| r.contains_point(p)))
+    };
+    let out: Vec<Polygon2> = grown
+        .into_iter()
+        .flat_map(|poly| {
+            if inside(&poly) {
+                vec![poly]
+            } else {
+                reach.iter().flat_map(|r| poly.intersection(r)).collect()
+            }
+        })
+        .filter(|poly| poly.exterior.len() >= 3)
+        .collect();
+    (!out.is_empty()).then_some(out)
+}
diff --git a/crates/rs_cam_core/tests/geodesic_adaptive_keeps_the_research_geometry_s7_4.rs b/crates/rs_cam_core/tests/geodesic_adaptive_keeps_the_research_geometry_s7_4.rs
new file mode 100644
index 000000000..87deb5c36
--- /dev/null
+++ b/crates/rs_cam_core/tests/geodesic_adaptive_keeps_the_research_geometry_s7_4.rs
@@ -0,0 +1,214 @@
+//! Integration step 7.4 (`planning/adaptive_research_2026-10-23/integration/
+//! step7_design.md` §5; lead conditions 1 and 3 of option B): Geodesic
+//! Adaptive plans the research arm's geometry, move by move.
+//!
+//! The research arm is `ClearingStrategy3d::Geodesic` of the research branch
+//! (607e52730) with the product preset, C35 plan A
+//! (`C35_SPIRAL_PICK.pick_variants().0`), the stock-depth step split and
+//! the routed keep-down travel at the cut feed. Both trees run the same
+//! fixtures (the island pocket of the research C12 judge at one level and
+//! at two, its shelf, and its straight channel) with these rules set
+//! explicitly, so no default of either tree enters.
+//!
+//! The pins are the research branch's numbers: the move count and the
+//! FNV-1a hash (`common::fingerprint::fnv1a_debug`) of each move's target,
+//! move kind with the feed value left out, and intent. Only the feed may
+//! differ: the research arm matched its turn records to moves by position
+//! and fed them from its readout; the product writes each turn's cap on its
+//! own cut from its own load reading (design part F,
+//! `adaptive::geodesic::feed_caps`). The feed differences are in the step
+//! 7.4 report. A pin that moves is a port defect: report it, do not
+//! re-pin.
+
+#![expect(
+    clippy::expect_used,
+    reason = "test code: a panic is how a test reports a failure"
+)]
+
+mod common;
+
+use common::fingerprint::fnv1a_debug;
+use common::meshes::height_field;
+use rs_cam_core::adaptive3d::{
+    Adaptive3dDepth, Adaptive3dGeometry, Adaptive3dLinking, Adaptive3dParams, ClearingStrategy3d,
+    EntryStyle3d, KeepDownRoute, RegionOrdering, StepSplit,
+    adaptive_3d_toolpath_output_with_cancel,
+};
+use rs_cam_core::mesh::{SpatialIndex, TriangleMesh};
+use rs_cam_core::tool::FlatEndmill;
+use rs_cam_core::toolpath::Toolpath;
+
+// The research C12 judge's fixture (`adaptive3d_geodesic_arm_c12.rs`).
+const TOOL_RADIUS: f64 = 3.0;
+const STEPOVER: f64 = 2.0;
+const TOLERANCE: f64 = 0.1;
+const STOCK_TO_LEAVE: f64 = 0.5;
+const TOP_Z: f64 = 10.0;
+const FLOOR_Z: f64 = 4.0;
+const MESH_HALF: f64 = 40.0;
+const MESH_STEP: f64 = 0.5;
+const POCKET_HALF_X: f64 = 34.0;
+const POCKET_HALF_Y: f64 = 24.0;
+const ISLAND_RADIUS: f64 = 5.0;
+/// The shelf of the research width-read test: x 12 to 30, y -12 to 12.
+const SHELF_Z: f64 = 6.5;
+/// The research channel (§13.3): half length, and the shipped smoothing
+/// inset its width is built from.
+const CHANNEL_HALF_LENGTH: f64 = 30.0;
+const SIMPLIFY_INSET: f64 = 0.3;
+
+fn pocket(shelf: bool) -> TriangleMesh {
+    height_field(MESH_HALF, MESH_STEP, |x, y| {
+        if x.hypot(y) <= ISLAND_RADIUS {
+            TOP_Z
+        } else if shelf && (12.0..=30.0).contains(&x) && y.abs() <= 12.0 {
+            SHELF_Z
+        } else if x.abs() <= POCKET_HALF_X && y.abs() <= POCKET_HALF_Y {
+            FLOOR_Z
+        } else {
+            TOP_Z
+        }
+    })
+}
+
+fn channel() -> TriangleMesh {
+    let cell = (TOOL_RADIUS / 6.0).max(TOLERANCE);
+    let hw = (2.0 * TOOL_RADIUS + 2.0 * (SIMPLIFY_INSET + cell) + STEPOVER) / 2.0;
+    height_field(MESH_HALF, MESH_STEP, |x, y| {
+        if x.abs() <= CHANNEL_HALF_LENGTH && y.abs() <= hw {
+            FLOOR_Z
+        } else {
+            TOP_Z
+        }
+    })
+}
+
+/// The research C12 judge's params, the arm's rules set explicitly.
+fn params(depth_per_pass: f64) -> Adaptive3dParams {
+    Adaptive3dParams {
+        entry_clearance_mm: 0.5,
+        ramp_feed_rate: None,
+        geometry: Adaptive3dGeometry {
+            tool_radius: TOOL_RADIUS,
+            envelope_radius: TOOL_RADIUS,
+            stepover: STEPOVER,
+            tolerance: TOLERANCE,
+            segment_merge_tolerance: None,
+            min_cutting_radius: 0.0,
+            boundary: None,
+            world_stock_xy_bbox: None,
+            centre_boundary: Vec::new(),
+        },
+        depth: Adaptive3dDepth {
+            depth_per_pass,
+            stock_to_leave: STOCK_TO_LEAVE,
+            stock_top_z: TOP_Z,
+            z_floor: None,
+            detect_flat_areas: false,
+        },
+        linking: Adaptive3dLinking {
+            region_ordering: RegionOrdering::Global,
+            min_region_cut_length_mm: 0.0,
+            max_stay_down_distance_mm: None,
+            stay_down_clearance_mm: 0.5,
+            step_split: Some(StepSplit::StockDepth),
+            keep_down_route: Some(KeepDownRoute::CutFeed),
+        },
+        feed_rate: 1000.0,
+        plunge_rate: 500.0,
+        safe_z: 15.0,
+        entry_style: EntryStyle3d::Plunge,
+        initial_stock: None,
+        clearing_strategy: ClearingStrategy3d::GeodesicAdaptive,
+        trochoid_cap_mult: 1.6,
+        engagement_measure: rs_cam_core::adaptive::EngagementMeasure::DiskArea,
+        z_blend: false,
+    }
+}
+
+fn plan(mesh: &TriangleMesh, depth_per_pass: f64) -> Toolpath {
+    let index = SpatialIndex::build(mesh, 10.0);
+    let cutter = FlatEndmill::new(2.0 * TOOL_RADIUS, 25.0);
+    adaptive_3d_toolpath_output_with_cancel(
+        mesh,
+        &index,
+        &cutter,
+        &params(depth_per_pass),
+        &|| false,
+        None,
+    )
+    .expect("the plan is not cancelled")
+    .toolpath
+}
+
+/// The move count and the hash of each move's target, move kind with the
+/// feed value left out, and intent.
+fn geometry(tp: &Toolpath) -> (usize, u64) {
+    let fields: Vec<_> = tp
+        .moves
+        .iter()
+        .map(|m| (m.target, m.move_type.with_feed_rate(0.0), m.intent))
+        .collect();
+    (tp.moves.len(), fnv1a_debug(&fields))
+}
+
+/// `(fixture, mesh, Depth/Pass)`.
+fn fixtures() -> Vec<(&'static str, TriangleMesh, f64)> {
+    vec![
+        ("island pocket, one level", pocket(false), TOP_Z - FLOOR_Z),
+        (
+            "island pocket, two levels",
+            pocket(false),
+            (TOP_Z - FLOOR_Z) / 2.0,
+        ),
+        ("shelf, one level", pocket(true), TOP_Z - FLOOR_Z),
+        ("channel, two levels", channel(), (TOP_Z - FLOOR_Z) / 2.0),
+    ]
+}
+
+/// The research branch's geometry of each fixture, in [`fixtures`] order.
+const PINS: [(usize, u64); 4] = [
+    (978, 14452218181729557987),
+    (2063, 3602713506842892098),
+    (1056, 14786195423799852005),
+    (0, 675868731199239589),
+];
+
+#[test]
+fn geodesic_adaptive_plans_the_research_geometry() {
+    let got: Vec<(&str, (usize, u64))> = fixtures()
+        .iter()
+        .map(|(name, mesh, dpp)| (*name, geometry(&plan(mesh, *dpp))))
+        .collect();
+    for ((name, g), pin) in got.iter().zip(PINS) {
+        assert_eq!(
+            *g, pin,
+            "{name}: the geometry left the research arm's; all: {got:?}"
+        );
+    }
+}
+
+/// Instrument for the step 7.4 feed-diff report: each move's feed and feed
+/// cap, one line per move, per fixture, into
+/// `<CARGO_TARGET_TMPDIR>/geodesic_feeds/<n>.txt`.
+#[test]
+#[ignore = "instrument: writes the per-move feeds for the step 7.4 feed-diff report"]
+fn write_the_per_move_feeds() {
+    let dir = std::path::PathBuf::from(env!("CARGO_TARGET_TMPDIR")).join("geodesic_feeds");
+    std::fs::create_dir_all(&dir).expect("create the output dir");
+    for (k, (_, mesh, dpp)) in fixtures().iter().enumerate() {
+        let tp = plan(mesh, *dpp);
+        let mut text = String::new();
+        for (i, m) in tp.moves.iter().enumerate() {
+            text.push_str(&format!(
+                "{i} {:.4} {:.4} {:.4} {:?} {:?}\n",
+                m.target.x,
+                m.target.y,
+                m.target.z,
+                m.move_type.feed_rate(),
+                m.feed_cap
+            ));
+        }
+        std::fs::write(dir.join(format!("{k}.txt")), text).expect("write the feeds");
+    }
+}
diff --git a/crates/rs_cam_core/tests/a_geodesic_cap_survives_every_dressup_s7_4.rs b/crates/rs_cam_core/tests/a_geodesic_cap_survives_every_dressup_s7_4.rs
