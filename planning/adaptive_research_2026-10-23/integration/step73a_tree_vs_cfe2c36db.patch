+                from: a,
+                to: target,
+                off_from: point_to_segment_distance(&from, &a, &target),
+                off_to: point_to_segment_distance(&to, &a, &target),
+            };
+            if best.is_none_or(|b| held.off_from.max(held.off_to) < b.off_from.max(b.off_to)) {
