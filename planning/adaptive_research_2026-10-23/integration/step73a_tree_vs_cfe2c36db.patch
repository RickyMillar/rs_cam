+            from,
+            to,
+            length_mm: (to.x - from.x).hypot(to.y - from.y),
+            steps: steps.len(),
+            steps_over: steps
+                .iter()
+                .filter(|t| t.swept > load.ceiling || t.area > load.ceiling)
+                .count(),
+            max_swept,
+            max_area,
+            feed_factor: factor,
+            feed_mm_min: feed,
+            fed,
+            holding: if fed {
+                None
+            } else {
+                holding_move(tp, from, to)
+            },
+            level_z: None,
+        });
+    }
