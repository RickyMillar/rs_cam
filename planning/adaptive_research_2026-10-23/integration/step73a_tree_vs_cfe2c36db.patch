+        let (sub, k0) = if gap <= reach {
+            let mut piece = vec![cur];
+            let k0 = if gap > CHAIN_EPS {
+                piece.extend_from_slice(path);
+                ((gap / self.step_len).ceil() as usize).max(1)
+            } else {
+                piece.extend(path.iter().skip(1).copied());
+                0
+            };
+            (subdivide(&piece, self.step_len), k0)
+        } else {
+            self.link(cur, start);
+            self.cut_start(start);
+            (subdivide(path, self.step_len), 0)
+        };
+        for (j, w) in sub.windows(2).enumerate() {
+            let &[a, b] = w else {
+                continue;
+            };
+            let down = self.down;
+            let before = self.material();
+            let held = self.step(a, b, false);
+            if j < k0 {
+                continue;
+            }
+            if held {
+                if self.material() < before {
+                    *wrap_cut = true;
+                }
+                continue;
+            }
+            if down && *wrap_cut {
+                self.down = true;
+                self.here = Some(a);
+                let mut out = vec![start];
+                out.extend(sub.iter().take(j + 1).skip(k0 + 1).copied());
+                return (out, Some(a));
+            }
+        }
+        self.here = sub.last().copied();
+        (path.to_vec(), None)
+    }
+}
+
+/// C9: the lattice nodes (of `grid`, the planner lattice the field shares)
+/// where a cutter of radius `r` meets no stock: no material cell centre
+/// within `r`, and under a fringe no standing sub-point within `r` (the
+/// points the swept width reads). `inside` limits it to the reachable
+/// nodes. A node on a stamped step is cleared: the stamp cleared every
+/// point within `r` of the step (`clear_segment`). These nodes are the
+/// cleared area in tool-centre space: a wrap is one spacing from the
+/// cutter centres that cut, not from the edge of the cut stock (that edge
+/// is `R` further out).
+fn cleared_nodes(grid: &MaterialGrid, inside: &[bool], r: f64) -> Vec<bool> {
+    let cell = grid.cell_size;
+    let r_sq = r * r;
+    // A sub-point lies up to half a cell diagonal from its cell node (the
+    // reach of `clear_circle` under a fringe).
+    let span = ((r + 0.5 * SQRT_2 * cell) / cell).ceil() as isize;
+    let stands = |row: usize, col: usize, cx: f64, cy: f64| -> bool {
+        let idx = row * grid.cols + col;
+        let state = grid.cells.get(idx).copied().unwrap_or(0);
+        if state != CELL_MATERIAL && state != CELL_FRINGE {
+            return false;
+        }
+        // The arithmetic of `clear_circle`, so a disc it stamped reads
+        // clear here.
+        let dx = grid.origin_x + col as f64 * cell - cx;
+        let dy = grid.origin_y + row as f64 * cell - cy;
+        if state == CELL_MATERIAL && dx * dx + dy * dy <= r_sq {
+            return true;
+        }
+        let bits = grid.fringe_bits(idx);
+        (0..SUB).any(|j| {
+            (0..SUB).any(|i| {
+                let sx = dx + sub_offset(i) * cell;
+                let sy = dy + sub_offset(j) * cell;
+                bits & (1u16 << (j * SUB + i)) != 0 && sx * sx + sy * sy <= r_sq
+            })
+        })
+    };
+    (0..grid.rows * grid.cols)
+        .map(|k| {
+            if inside.get(k).copied() != Some(true) {
+                return false;
+            }
+            let (row, col) = (k / grid.cols, k % grid.cols);
+            let cx = grid.origin_x + col as f64 * cell;
+            let cy = grid.origin_y + row as f64 * cell;
+            !(-span..=span).any(|dr| {
+                (-span..=span).any(|dc| {
+                    let (Some(rr), Some(cc)) =
+                        (row.checked_add_signed(dr), col.checked_add_signed(dc))
+                    else {
+                        return false;
+                    };
+                    rr < grid.rows && cc < grid.cols && stands(rr, cc, cx, cy)
+                })
+            })
+        })
+        .collect()
+}
+
+/// C9, [`Reseed::Cleared`] (operator idea 1a, 2026-10-24: "let the
+/// first-arriving branch keep diffusing"): the C5 plan (plain wraps, the
+/// G1 join, the one-side meeting rule, the field's own spacing) walked
+/// through the replay model ([`ReplayModel`]) as it is planned, with the
+/// field grown again from the cleared area where the model refuses a wrap.
+///
+/// - **The trigger.** A wrap step that the model refuses while its cutter
+///   is down (cutting, not hunting for a re-entry after a refused join), once
+///   a wrap step of the same field has cut stock. That refusal is the one
+///   that cascades: the replay stamps only accepted steps, so each later
+///   wrap of the field over that stretch meets the stock it left (D5: 640
+///   of the 763 wrap refusals on the pocket are cascades). A refused join
+///   does not trigger: the replay re-enters at the wrap (D5: 0 of 97 join
+///   refusals cascade on the star).
+/// - **At the trigger** the wrap ends before the refused step, and the
+///   field's remaining wraps are dropped (they were placed on stock the
+///   replay will not have cut). The new field holds `T = 0` on every node
+///   where the cutter meets no stock in the model grid ([`cleared_nodes`]:
+///   the accepted passes' own stamps, not the planned wraps), keeps the
+///   islands and the walls as obstacles and the front branches, and is
+///   solved by the same source tracking ([`GeodesicField::reseeded`]).
+/// - **The spacing of a new field** is the curvature law from `ρ_0 = R`
+///   ([`curvature_levels`]), the law of the first field at its seed: the
+///   cleared area is treated as the starter lap. The first new wrap lies
+///   `s'` from the cut (1.44 mm at s 2, R 3, c 0.3626), and the spacing
+///   reaches `s` at `ρ*`. Plain spacing would put the first new wrap
+///   where the refused one lay, on the same stock: the same refusal.
+/// - **Why this trigger, not the meeting line only.** The D5 render of
+///   `geodesic_curv` on the pocket shows the refusals start where the
+///   fronts bend round the island, before the two branches meet; a re-seed
+///   at the meeting line comes after the cascade has begun. A re-seed after
+///   the whole first field is too late for the same reason. The refusal
+///   trigger is the earliest point the cascade can be stopped, and it
+///   contains the meeting-line case (the far side's first refused wrap).
+/// - **The stop rule.** A field that places every wrap ends the plan. A
+///   re-seeded field with no level (every reachable node lies within the
+///   law's first spacing of the cleared area) ends it: the residue passes
+///   take the rest. A trigger needs a wrap step of the field that cut
+///   stock, so the stock count falls strictly between two re-seeds and the
+///   re-seeds are finite; a field whose wraps cut nothing before a refusal
+///   is placed whole, as under [`Reseed::Off`].
+/// - With no trigger the plan is the `Reseed::Off` plan of the same
+///   options, segment for segment (the same wraps, through [`append_path`]).
+#[expect(
+    clippy::too_many_arguments,
+    reason = "each parameter is a separate input of one planning call"
+)]
+fn reseed_segments(
+    polygon: &Polygon2,
+    params: &AdaptiveParams,
+    options: GeodesicOptions,
+    mut segments: Vec<AdaptiveSegment>,
+    starter_end: P2,
+    mut field: GeodesicField,
+    walls: &Walls<'_>,
+    reach: f64,
+    ceiling_width: f64,
+    cancel: &dyn CancelCheck,
+) -> Result<Option<Produced>, Cancelled> {
+    let r = params.tool_radius;
+    let s = params.stepover;
+    let cell = field.cell();
+    let region = walls.region;
+    let Some(mut model) = ReplayModel::new(polygon, params, cell) else {
+        return Ok(None);
+    };
+    model.walk(&segments);
+    let mut report = FieldReport {
+        applied: true,
+        seed: Some(field.seed),
+        seed_radius: r,
+        levels: field.level_count(),
+        chains: 0,
+        converged: field.converged(),
+        branches: field.branch_count(),
+        spiral_levels: 0,
+        lobes: LobeReport::default(),
+        joins: JoinReport::default(),
+        local_converged: field.local_converged,
+        level_values_mm: field.level_values_mm(),
+        core_pieces: Vec::new(),
+        reseed: ReseedReport {
+            enabled: true,
+            ..ReseedReport::default()
+        },
+        split: SplitReport::default(),
+        arcs: ArcReport::default(),
+    };
+    let uncleared_mm2 = |model: &ReplayModel, field: &GeodesicField| {
+        let cleared = cleared_nodes(&model.setup.grid, &field.inside, r);
+        let n = field
+            .inside
+            .iter()
+            .zip(&cleared)
+            .filter(|&(&inside, &cleared)| inside && !cleared)
+            .count();
+        n as f64 * cell * cell
+    };
+    let mut wraps = ordered_wraps(&field, region, starter_end, reach, s, 1, options, cancel)?;
+    if let Some(first) = wraps.iter().find_map(|w| w.pts.first()) {
+        segments.push(AdaptiveSegment::Marker(AdaptiveRuntimeEvent::PassEntry {
+            pass_index: 1,
+            entry_x: first.x,
+            entry_y: first.y,
+        }));
+    }
+    let mut run: Vec<P2> = vec![starter_end];
+    let mut cur = starter_end;
+    model.cut_start(starter_end);
+    let mut emitted: Vec<Vec<P2>> = Vec::new();
+    // Each emitted wrap as (field, closed, level), for the join counts.
+    let mut joined: Vec<(usize, bool, usize)> = Vec::new();
+    loop {
+        check_cancel(cancel)?;
+        let material_at_start = model.material();
+        let mut record = ReseedField {
+            levels: field.level_count(),
+            wraps: 0,
+            uncleared_mm2: uncleared_mm2(&model, &field),
+            cut_mm2: 0.0,
+            trigger: None,
+            trigger_level: None,
+            converged: field.converged(),
+        };
+        let mut wrap_cut = false;
+        for w in &wraps {
+            check_cancel(cancel)?;
+            let (pts, ended) = model.plan_wrap(cur, &w.pts, reach, &mut wrap_cut);
+            append_path(&pts, &mut run, &mut cur, &mut segments, reach);
+            emitted.push(pts);
+            // A truncated wrap is an open piece.
+            joined.push((
+                report.reseed.fields.len(),
+                w.closed && ended.is_none(),
+                w.level,
+            ));
+            record.wraps += 1;
+            if let Some(at) = ended {
+                record.trigger = Some(at);
+                record.trigger_level = Some(w.level);
+                break;
+            }
+        }
+        record.cut_mm2 = material_at_start.saturating_sub(model.material()) as f64 * cell * cell;
+        let triggered = record.trigger.is_some();
+        report.reseed.fields.push(record);
+        if !triggered {
+            report.reseed.stop = ReseedStop::Finished;
+            break;
+        }
+        let cleared = cleared_nodes(&model.setup.grid, &field.inside, r);
+        let Some(mut next) = field.reseeded(&cleared, walls) else {
+            report.reseed.stop = ReseedStop::NoSeed;
+            break;
+        };
+        next.use_curvature_spacing(r, ceiling_width);
+        report.reseed.solved += 1;
+        if next.level_count() == 0 {
+            report.reseed.stop = ReseedStop::NoLevel;
+            break;
+        }
+        field = next;
+        wraps = ordered_wraps(&field, region, cur, reach, s, 1, options, cancel)?;
+    }
+    if run.len() >= 2 {
+        segments.push(AdaptiveSegment::Cut(run));
+    }
+    report.chains = emitted.len();
+    report.joins = seam_joins(&joined);
+    let mut parts = PartIndex::new(cell);
+    for w in &emitted {
+        parts.add(w, StepPart::Wrap);
+    }
+    Ok(Some(Produced {
+        segments,
+        report,
+        wraps: emitted,
+        parts,
+        leads: Vec::new(),
+        turns: Vec::new(),
+    }))
+}
+
+/// The join counts of the seam join ([`JoinReport`]) over wraps in cutting
+/// order, each `(field, closed, level)`, by the rule of the one-field plan
+/// in [`geodesic_segments`]: a closed wrap followed by a closed wrap of the
+/// same field one level up is a closed-to-closed seam; else a closed wrap
+/// is a closed-to-arc join and an open one a join from an arc; the last
+/// wrap has no join. (D9: before C11 the re-seed plan left these at 0.)
+fn seam_joins(wraps: &[(usize, bool, usize)]) -> JoinReport {
+    let mut joins = JoinReport::default();
+    for (i, &(field, closed, level)) in wraps.iter().enumerate() {
+        let Some(&(next_field, next_closed, next_level)) = wraps.get(i + 1) else {
+            continue;
+        };
+        if closed && next_closed && next_field == field && next_level == level + 1 {
+            joins.closed_seam += 1;
+        } else if closed {
+            joins.closed_to_arc += 1;
+        } else {
+            joins.from_arc += 1;
+        }
+    }
+    joins
+}
+
+// ── The split at the meeting line (C11) ────────────────────────────────
+
+/// C11, [`Reseed::Zone`]: the far-side zone of `field`, the reachable,
+/// solved nodes whose straight path to the seed bends round an island (a
+/// hole of the tool-centre region): their front branch, or an ancestor of
+/// it, is a bend round a hole ring ([`Branches`], [`Walls::ring_near`]).
+///
+/// - **Why this set.** A node whose path does not bend sees the seed
+///   centre `c`, so its pivot is the seed and `ρ = R + T` exactly: the
+///   curvature law ([`curvature_levels`]) is derived for that circle and
+///   holds there without error. Where the path bends at a node `b` the
+///   front is a circle about `b`: `T = |b - c| - R + |x - b|`, so
+///   `(R + T) - |x - b| = |b - c|` (more bends only add to it), the
+///   distance from the seed to the bend node, which is never 0. So the
+///   law's `ρ` and the local `ρ` disagree at every zone node, and the set
+///   does not depend on a tolerance. A bend round the outer wall only (a
+///   lobe behind an inside corner) is left out: no two fronts meet there
+///   (one branch, C2), and the shipped shapes have none (the pocket's
+///   outer wall is convex; the seed sees the whole star). The meeting line
+///   lies in the zone: the two branches that meet there both went round
+///   the island.
+/// - **Closed off.** The zone is bounded by the island, the walls and the
+///   two shadow lines, the rays from the seed that touch the island. A ray
+///   from the seed is a gradient line of `T`, so the first region's wraps
+///   (circles about the seed) meet the border at a right angle, as at a
+///   wall: the last step of a wrap at the border meets only its band (the
+///   disc of the wrap below ends on the same ray and covers the stock on
+///   the inner side).
+/// - Not chosen: "the nodes of the second branch" (both branches reach the
+///   meeting line at the same `T`, by its definition, so "second" is an
+///   order of cutting, not a property of the field); "the nodes where the
+///   two `ρ` disagree by more than a tolerance" is this set, since the
+///   smallest disagreement is the seed's distance to the island.
+fn far_side_zone(field: &GeodesicField, walls: &Walls<'_>) -> Vec<bool> {
+    // The rings in the order of `Walls::ring_near`: each piece's exterior,
+    // then its holes.
+    let hole: Vec<bool> = walls
+        .region
+        .pieces()
+        .iter()
+        .flat_map(|piece| std::iter::once(false).chain(piece.holes.iter().map(|_| true)))
+        .collect();
+    // Branch ids index `branch_keys` from 1. A key's parent was in the table
+    // before it (`Branches::bend`), so one pass in id order sees each
+    // parent first.
+    let mut round_hole = vec![false; field.branch_keys.len() + 1];
+    for (k, &(parent, ring, _)) in field.branch_keys.iter().enumerate() {
+        let own = hole.get(ring).copied().unwrap_or(false);
+        let inherited = round_hole.get(parent as usize).copied().unwrap_or(false);
+        if let Some(slot) = round_hole.get_mut(k + 1) {
+            *slot = own || inherited;
+        }
+    }
+    field
+        .inside
+        .iter()
+        .zip(&field.branch)
+        .zip(&field.field.passes)
+        .map(|((&reach, &b), &t)| {
+            reach && t.is_finite() && round_hole.get(b as usize).copied().unwrap_or(false)
+        })
+        .collect()
+}
+
+/// C11: for every reachable node of `field`, the front branch of the zone
+/// node nearest it in lattice steps (breadth first over the 8 neighbours,
+/// from every zone node at once); 0 where no zone node is reached. A
+/// cleared node beside the zone's border takes the branch of the zone
+/// across that border, so the zone field's fronts from the two shadow
+/// lines grow in the two unrelated branches of the first field and meet on
+/// a meeting line ([`GeodesicField::cell_on_shock`]); the one-side rule
+/// then applies inside the zone. (With every cleared node in branch 0, the
+/// two fronts would be one branch and their kink would not be split.)
+fn zone_labels(field: &GeodesicField, zone: &[bool]) -> Vec<u32> {
+    let (rows, cols) = (field.field.rows, field.field.cols);
+    let n = rows * cols;
+    let mut label = vec![0u32; n];
+    let mut seen = vec![false; n];
+    let mut queue: VecDeque<usize> = VecDeque::new();
+    for i in 0..n {
+        if zone.get(i).copied() != Some(true) {
+            continue;
+        }
+        if let (Some(l), Some(v)) = (label.get_mut(i), seen.get_mut(i)) {
+            *l = field.branch.get(i).copied().unwrap_or(0);
+            *v = true;
+        }
+        queue.push_back(i);
+    }
+    while let Some(i) = queue.pop_front() {
+        let (row, col) = (i / cols, i % cols);
+        let here = label.get(i).copied().unwrap_or(0);
+        for (dr, dc) in NEIGHBOURS {
+            let (Some(nr), Some(nc)) = (row.checked_add_signed(dr), col.checked_add_signed(dc))
+            else {
+                continue;
+            };
+            if nr >= rows || nc >= cols {
+                continue;
+            }
+            let j = nr * cols + nc;
+            if field.inside.get(j).copied() != Some(true) || seen.get(j).copied() != Some(false) {
+                continue;
+            }
+            if let (Some(l), Some(v)) = (label.get_mut(j), seen.get_mut(j)) {
+                *l = here;
+                *v = true;
+            }
+            queue.push_back(j);
+        }
+    }
+    label
+}
+
+/// The distinct front branches of `field` over the nodes of `mask`.
+fn branches_in(field: &GeodesicField, mask: &[bool]) -> usize {
+    let mut seen: Vec<u32> = field
+        .branch
+        .iter()
+        .zip(mask)
+        .filter(|&(_, &m)| m)
+        .map(|(&b, _)| b)
+        .collect();
+    seen.sort_unstable();
+    seen.dedup();
+    seen.len()
+}
+
+/// The meeting-line cells of `field` ([`GeodesicField::cell_on_shock`]) whose
+/// four corners are reachable and in `mask`.
+fn meeting_cells_in(field: &GeodesicField, mask: &[bool]) -> usize {
+    let f = &field.field;
+    let at = |row: usize, col: usize| mask.get(row * f.cols + col).copied() == Some(true);
+    let mut count = 0usize;
+    for row in 0..f.rows.saturating_sub(1) {
+        for col in 0..f.cols.saturating_sub(1) {
+            if field.cell_reachable(row, col)
+                && field.cell_on_shock(row, col)
+                && at(row, col)
+                && at(row, col + 1)
+                && at(row + 1, col)
+                && at(row + 1, col + 1)
+            {
+                count += 1;
+            }
+        }
+    }
+    count
+}
+
+/// C11, [`Reseed::Zone`] (operator idea 1b, 2026-10-24: split at the
+/// meeting line and clear the far side as its own pass): two regions, two
+/// fields, one plan.
+///
+/// 1. **The first region** is the first field (the C5 plan: the curvature
+///    law, plain wraps, the G1 join, the one-side meeting rule) with the
+///    zone ([`far_side_zone`]) left out of its reachable nodes
+///    ([`GeodesicField::with_inside`]), so every wrap ends at the zone's
+///    border and none enters it. In this region the law is exact.
+/// 2. **The cut.** The plan so far (the starter and the first region) is
+///    walked through the replay model ([`ReplayModel`], C9), so the zone
+///    starts from the stock the replay will have cut, not from the planned
+///    wraps.
+/// 3. **The zone field** holds `T = 0` on the cleared nodes
+///    ([`cleared_nodes`]) and is solved over the zone and those nodes by
+///    the same source tracking ([`GeodesicField::grown_from`]); each
+///    cleared node starts in the branch of the zone across the border
+///    ([`zone_labels`]). It is spaced by the curvature law from
+///    `ρ_0 = R`, the C9 rule (the cleared area as the starter lap; never
+///    wider than plain spacing). Its wraps go through the same order and
+///    the one-side meeting rule ([`ordered_wraps`]), so the kink where its
+///    two fronts meet is split.
+/// 4. **The link.** The zone's first wrap is entered from the end of the
+///    first region by [`append_path`]: a cutting step within the reach, else
+///    one keep-down `Link`, which the replay admits under the pass load or
+///    turns into a re-entry.
+///
+/// **The zone's seed: `T = 0` on the cut, not an entry of its own.** An
+/// entry at the zone's EDT maximum costs one plunge and one starter pocket,
+/// and its front is a circle that the island, the walls and BOTH shadow
+/// lines cut, so a level gives up to four arcs, each with a join. The
+/// border the zone shares with the cut is the two shadow lines, straight,
+/// and the cut's edge along them is the row of the first region's wrap
+/// ends (a scallop of `R - √(R² - (s/2)²)`, 0.17 mm at s 2, R 3), so the
+/// front grown from the cut is straight and each level is one arc per side
+/// from the island or the meeting line to a wall. The planner has no EDT
+/// of a sub-region either (the shipped EDT measures the distance to the
+/// walls). The cut seed is C9's mechanism once: one solve, no trigger.
+///
+/// The replay, the residue contours, the wall pass and the mop then run on
+/// the plan as for every column.
+#[expect(
+    clippy::too_many_arguments,
+    reason = "each parameter is a separate input of one planning call"
+)]
+fn split_segments(
+    polygon: &Polygon2,
+    params: &AdaptiveParams,
+    options: GeodesicOptions,
+    mut segments: Vec<AdaptiveSegment>,
+    starter_end: P2,
+    field: &GeodesicField,
+    zone: &[bool],
+    walls: &Walls<'_>,
+    reach: f64,
+    ceiling_width: f64,
+    cancel: &dyn CancelCheck,
+) -> Result<Option<Produced>, Cancelled> {
+    let r = params.tool_radius;
+    let s = params.stepover;
+    let cell = field.cell();
+    let region = walls.region;
+    let count = |mask: &[bool]| mask.iter().filter(|&&m| m).count();
+
+    // 1. The first region.
+    let keep: Vec<bool> = field
+        .inside
+        .iter()
+        .zip(zone)
+        .map(|(&reach_node, &z)| reach_node && !z)
+        .collect();
+    let first = field.with_inside(keep);
+    let first_wraps = ordered_wraps(&first, region, starter_end, reach, s, 1, options, cancel)?;
+    if let Some(p) = first_wraps.iter().find_map(|w| w.pts.first()) {
+        segments.push(AdaptiveSegment::Marker(AdaptiveRuntimeEvent::PassEntry {
+            pass_index: 1,
+            entry_x: p.x,
+            entry_y: p.y,
+        }));
+    }
+    let mut run: Vec<P2> = vec![starter_end];
+    let mut cur = starter_end;
+    let mut emitted: Vec<Vec<P2>> = Vec::new();
+    // Each emitted wrap as (field, closed, level), for the join counts.
+    let mut joined: Vec<(usize, bool, usize)> = Vec::new();
+    for w in &first_wraps {
