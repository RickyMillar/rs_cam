+    /// C23: the closed form of the arc-end lens agrees with the raster
+    /// within five grid steps over `D` (the raster misses up to one step at
+    /// each edge and at the crossing; the Python check of the same cases
+    /// reads at most 0.0056) on both of its branches (the far
+    /// crossing ahead of both ends, and the swath of the arc before
+    /// covering it), and reads `(R + Δ/2)/2R` head-on, above the ceiling.
+    #[test]
+    fn the_arc_end_lens_matches_a_raster_of_the_end() {
+        let h = 0.01;
+        for delta in [1.0, 1.5, 2.0] {
+            for deg in [-70.0_f64, -50.0, -30.0, -14.0, 0.0, 10.0, 30.0] {
+                let theta = deg.to_radians();
+                let exact = arc_end_lens(R, delta, theta);
+                let raster = raster_end_lens(delta, theta, h);
+                assert!(
+                    (exact - raster).abs() <= 5.0 * h / (2.0 * R),
+                    "Δ {delta}, θ {deg}: closed form {exact}, raster {raster}"
+                );
