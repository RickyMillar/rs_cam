+fn holding_move(tp: &Toolpath, from: P2, to: P2) -> Option<HoldingMove> {
+    let mut best: Option<HoldingMove> = None;
+    let mut start: Option<P2> = None;
+    for m in &tp.moves {
+        let target = P2::new(m.target.x, m.target.y);
