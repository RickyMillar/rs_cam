+    /// C23: the lens of [`arc_end_lens`] by raster. The same geometry on a
+    /// grid of `h`: the wall is the line `y = 0` of the tool-centre space
+    /// (stock up to `y = −R`); the cutter ends at the origin, travelling
+    /// `d = (sin θ, −cos θ)`; the arc before is the parallel line `Δ` to
+    /// the side `n = (cos θ, sin θ)` away from the later arcs, up to the
+    /// wall. The stock read is every grid point of the disc ahead
+    /// (`f > 0`), before the wall face and farther than `R` from the arc
+    /// before; the reading is its sideways span over `2R`.
+    fn raster_end_lens(delta: f64, theta: f64, h: f64) -> f64 {
+        let (d, n) = ((theta.sin(), -theta.cos()), (theta.cos(), theta.sin()));
+        let p0 = (-delta * n.0, -delta * n.1);
+        let t_end = -p0.1 / d.1;
+        let steps = (R / h).round() as i64;
+        let (mut lo, mut hi) = (f64::INFINITY, f64::NEG_INFINITY);
+        for i in -steps..=steps {
+            for j in 1..=steps {
+                let (u, f) = (i as f64 * h, j as f64 * h);
+                if u * u + f * f > R * R {
+                    continue;
+                }
+                let w = (u * n.0 + f * d.0, u * n.1 + f * d.1);
+                if w.1 < -R {
+                    continue;
+                }
+                let t = ((w.0 - p0.0) * d.0 + (w.1 - p0.1) * d.1).min(t_end);
+                let foot = (p0.0 + t * d.0, p0.1 + t * d.1);
+                if (w.0 - foot.0).hypot(w.1 - foot.1) <= R {
+                    continue;
+                }
+                lo = lo.min(u);
+                hi = hi.max(u);
+            }
+        }
+        if hi < lo { 0.0 } else { (hi - lo) / (2.0 * R) }
+    }
