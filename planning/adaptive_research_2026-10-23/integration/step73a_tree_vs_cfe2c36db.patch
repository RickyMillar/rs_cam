+    /// way round the island and the far side stands. Then:
+    /// - every stamped node reads cleared ([`cleared_nodes`]);
+    /// - the re-seeded field holds `T = 0` exactly on the cleared nodes and
+    ///   more than 0 on every other node it solves, the far side included;
+    /// - its first level under the law is `s'` from `ρ_0 = R`, the law's
+    ///   first step at the seed (the law restarts at the cut);
+    /// - no wrap lies further from the cut than its level: a point of level
+    ///   `k` lies within `L_k·s + √2·cell` of a cleared node. (A contour
+    ///   point lies in a cell with a corner whose `T` is at most `L_k`; that
+    ///   corner's `T` is the length of a path to a cleared node; the corner
+    ///   is at most a cell diagonal from the point.)
+    #[test]
+    fn the_reseeded_field_grows_from_the_cleared_area() {
+        let params = test_params();
+        let (s, tol) = op_defaults();
+        let cell = planner_cell_size(R, tol);
+        let part = island_pocket();
+        let region = ToolCentreRegion::new(&part, R);
+        let walls = Walls { region: &region };
+        // `island_pocket`: the island of radius 6 about (25, 20).
+        let (island, island_radius) = (P2::new(25.0, 20.0), 6.0);
+        // A test position on the island's axis: the seed disc (x 5 to 11)
+        // lies inside the tool-centre region (x ≥ 3) and clear of the
+        // island's tool-centre edge (x ≤ 16).
+        let seed = P2::new(island.x - 17.0, island.y);
+        let field =
+            GeodesicField::over_part(&part, R, cell, s, seed, R, FieldSolver::SourceTracking)
+                .expect("seeded");
+        let t_mm = |f: &GeodesicField, i: usize| {
+            f.field
+                .passes
+                .get(i)
+                .copied()
+                .filter(|t| t.is_finite() && f.inside.get(i).copied() == Some(true))
+                .map(|t| t * s)
+        };
+        let t_cut = (island.x - seed.x) - R;
+        let mut grid = MaterialGrid::from_polygon(&part, cell);
+        grid.keep_fringe(&part);
+        let n = grid.rows * grid.cols;
+        assert_eq!(
+            n,
+            field.field.rows * field.field.cols,
+            "the field and the grid share the planner lattice"
+        );
+        let mut stamped: Vec<usize> = Vec::new();
+        for i in 0..n {
+            if t_mm(&field, i).is_some_and(|t| t <= t_cut) {
+                let p = field_node(&field, i);
+                grid.clear_circle(p.x, p.y, R);
+                stamped.push(i);
+            }
+        }
+        assert!(!stamped.is_empty(), "the cut reaches nodes");
+        let cleared = cleared_nodes(&grid, &field.inside, R);
+        for &i in &stamped {
+            assert_eq!(
+                cleared.get(i).copied(),
+                Some(true),
+                "a stamped node reads cleared: {:?}",
+                field_node(&field, i)
+            );
+        }
+        let mut next = field
+            .reseeded(&cleared, &walls)
+            .expect("cleared nodes exist");
+        let mut far_solved = 0usize;
+        for i in 0..n {
+            if field.inside.get(i).copied() != Some(true) {
+                continue;
+            }
+            let t = next.field.passes.get(i).copied().expect("a lattice node");
+            if cleared.get(i).copied() == Some(true) {
+                assert!(t == 0.0, "a cleared node holds T = 0 exactly: {t}");
+            } else {
+                assert!(t > 0.0, "an uncleared node holds T > 0: {t}");
+                if t.is_finite() && field_node(&field, i).x > island.x + island_radius + R {
+                    far_solved += 1;
+                }
+            }
+        }
+        assert!(far_solved > 0, "the re-seeded field reaches the far side");
+
+        let cd = pass_load_for(&params, cell).ceiling * 2.0 * R;
+        next.use_curvature_spacing(R, cd);
+        assert!(next.level_count() >= 1, "the far side holds a level");
+        let first = law_next_radius(R, s, cd, R) - R;
+        assert!(
+            (next.level_value(1) * s - first).abs() <= 1e-9,
+            "the law restarts at the cut: level 1 at {:.4} mm, s' from R {first:.4} mm",
+            next.level_value(1) * s
+        );
+
+        let cleared_at: Vec<P2> = (0..n)
+            .filter(|&i| cleared.get(i).copied() == Some(true))
+            .map(|i| field_node(&field, i))
+            .collect();
+        let mut far_points = 0usize;
+        for k in 1..=next.level_count() {
+            let bound = next.level_value(k) * s + SQRT_2 * cell;
+            for chain in next.level_chains(k, MeetingRule::Split) {
+                for p in chain {
+                    let d = cleared_at
+                        .iter()
+                        .map(|q| (q.x - p.x).hypot(q.y - p.y))
+                        .fold(f64::INFINITY, f64::min);
+                    assert!(
+                        d <= bound + 1e-9,
+                        "level {k}: a wrap point {p:?} lies {d:.3} mm from the cut, over {bound:.3}"
+                    );
+                    if p.x > island.x + island_radius + R {
+                        far_points += 1;
+                    }
+                }
+            }
+        }
+        assert!(far_points > 0, "the re-seeded wraps fill the far side");
+    }
