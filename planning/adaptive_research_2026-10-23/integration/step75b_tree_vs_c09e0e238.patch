+    let params_with = |dpp: f64, centre: Vec<crate::polygon::Polygon2>| {
+        let mut p = default_params();
+        p.depth.stock_to_leave = leave;
+        p.depth.depth_per_pass = dpp;
+        p.geometry.centre_boundary = centre;
