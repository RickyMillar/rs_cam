-    for w in poly.windows(2) {
-        let &[a, b] = w else {
-            continue;
-        };
-        let (dx, dy) = (b.x - a.x, b.y - a.y);
-        let len_sq = dx * dx + dy * dy;
-        let t = if len_sq > 0.0 {
-            (((p.x - a.x) * dx + (p.y - a.y) * dy) / len_sq).clamp(0.0, 1.0)
