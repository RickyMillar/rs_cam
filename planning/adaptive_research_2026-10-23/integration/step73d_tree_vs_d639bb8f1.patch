-/// C23: the lens reading ([`arc_end_lens`]) at the last point of the open
-/// arc `pts` of `level`, cut in the order of `pts`; 0 when that end is
-/// not on a wall or the travel there leaves the wall. `stock_right`: `T`
-/// grows to the right of the travel ([`right_growth`]).
-///
-/// - The travel `d`: the chord from the point one pass step back
-///   ([`pass_step_len`]; the first point on a shorter arc) to the end.
-/// - The wall normal `n` ([`wall_normal`]); `cos θ = d·n`.
-/// - The wall tangent `t` points where the later arcs end: the side where
-///   `T` grows, the right normal of `d` when `stock_right`. `sin θ = d·t`.
-/// - `Δ`: the level step `(T_k − T_{k−1})·s` (mm).
-fn end_lens_at(
-    field: &GeodesicField,
-    region: &ToolCentreRegion,
-    pts: &[P2],
-    level: usize,
-    stock_right: bool,
-    tool_radius: f64,
-) -> f64 {
-    let cell = field.cell();
-    let (Some(&end), Some(&first)) = (pts.last(), pts.first()) else {
-        return 0.0;
-    };
-    let mut cum = Vec::with_capacity(pts.len());
-    let mut total = 0.0_f64;
-    let mut prev = first;
-    for &p in pts {
-        total += (p.x - prev.x).hypot(p.y - prev.y);
-        cum.push(total);
-        prev = p;
-    }
-    let back = point_at_length(pts, &cum, total - pass_step_len(cell)).unwrap_or(first);
-    let (dx, dy) = (end.x - back.x, end.y - back.y);
-    let len = dx.hypot(dy);
-    if len <= CHAIN_EPS || level == 0 {
-        return 0.0;
-    }
-    let (dx, dy) = (dx / len, dy / len);
-    let Some((nx, ny)) = wall_normal(region, end, cell) else {
-        return 0.0;
-    };
-    let cos = dx * nx + dy * ny;
-    if cos <= 0.0 {
-        return 0.0;
-    }
-    // The side where `T` grows: the right normal (dy, -dx) of the travel,
-    // or its left one.
-    let (gx, gy) = if stock_right { (dy, -dx) } else { (-dy, dx) };
-    let (mut tx, mut ty) = (-ny, nx);
-    if tx * gx + ty * gy < 0.0 {
-        (tx, ty) = (-tx, -ty);
-    }
-    let sin = dx * tx + dy * ty;
-    let delta = (field.level_value(level) - field.level_value(level - 1)) * field.stepover;
-    arc_end_lens(tool_radius, delta, sin.atan2(cos))
-}
