-/// C14: the open arc `pts` oriented for a climb cut: the stock on the right
-/// of the travel (the code's convention for a clockwise spindle,
-/// [`ArcLink::OneWay`]). The stock side is where `T` grows: at the middle
-/// of each segment `T` is read one cell to the right and one cell to the
-/// left of the heading, and the differences, weighted by segment length,
-/// decide. A sample off the reachable cells is skipped.
-fn climb_oriented(field: &GeodesicField, pts: &[P2]) -> Vec<P2> {
-    let mut out = pts.to_vec();
-    if right_growth(field, pts) < 0.0 {
-        out.reverse();
-    }
-    out
-}
