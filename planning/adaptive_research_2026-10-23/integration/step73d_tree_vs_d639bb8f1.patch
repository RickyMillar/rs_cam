-    let reach = s + (1.0 + SQRT_2) * cell;
-    if options.reseed == Reseed::Cleared && options.join == JoinRule::Seam {
-        return reseed_segments(
-            polygon,
-            params,
-            options,
-            segments,
-            starter_end,
-            field,
-            &walls,
-            reach,
-            pass.ceiling * 2.0 * r,
-            cancel,
-        );
-    }
