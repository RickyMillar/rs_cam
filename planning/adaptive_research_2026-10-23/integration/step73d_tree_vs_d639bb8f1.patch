-/// C23: the unit normal into the wall at `p` (from `p` toward the nearest
-/// point of a ring of `region`), when `p` lies within one cell diagonal
-/// of a ring: an arc end on a wall ends on the edge of the last cell with
-/// four reachable corners, at most one cell diagonal short of the wall
-/// ([`turn_bound`]). `None` farther off (an end at a meeting line or in
-/// the open).
-fn wall_normal(region: &ToolCentreRegion, p: P2, cell: f64) -> Option<(f64, f64)> {
-    let mut best: Option<(f64, P2, P2)> = None;
-    for piece in region.pieces() {
-        for ring in std::iter::once(&piece.exterior).chain(piece.holes.iter()) {
-            let n = ring.len();
-            for k in 0..n {
-                let (Some(&a), Some(&b)) = (ring.get(k), ring.get((k + 1) % n)) else {
-                    continue;
-                };
-                let d = point_to_segment_distance(&p, &a, &b);
-                if best.is_none_or(|(bd, _, _)| d < bd) {
-                    best = Some((d, a, b));
-                }
-            }
-        }
-    }
-    let (d, a, b) = best?;
-    if d > SQRT_2 * cell + CHAIN_EPS {
-        return None;
-    }
-    let (dx, dy) = (b.x - a.x, b.y - a.y);
-    let len_sq = dx * dx + dy * dy;
-    if len_sq <= 0.0 {
-        return None;
-    }
-    if d > CHAIN_EPS {
-        let t = (((p.x - a.x) * dx + (p.y - a.y) * dy) / len_sq).clamp(0.0, 1.0);
-        let (fx, fy) = (a.x + t * dx - p.x, a.y + t * dy - p.y);
-        return Some((fx / d, fy / d));
-    }
-    // On the ring: the side of the segment that leaves the region.
-    let len = len_sq.sqrt();
-    let (nx, ny) = (dy / len, -dx / len);
-    if region.contains(&P2::new(p.x + 0.5 * cell * nx, p.y + 0.5 * cell * ny)) {
-        Some((-nx, -ny))
-    } else {
-        Some((nx, ny))
-    }
-}
