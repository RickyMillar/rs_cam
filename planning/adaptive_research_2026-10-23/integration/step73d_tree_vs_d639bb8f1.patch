-/// How much `T` grows to the right of the travel along `pts`: the sum of
-/// [`climb_oriented`]. Positive when the stock lies on the right.
-fn right_growth(field: &GeodesicField, pts: &[P2]) -> f64 {
-    let h = field.cell();
-    let mut right = 0.0_f64;
-    for w in pts.windows(2) {
-        let &[a, b] = w else {
-            continue;
-        };
-        let (dx, dy) = (b.x - a.x, b.y - a.y);
-        let len = dx.hypot(dy);
-        if len <= 0.0 {
-            continue;
-        }
-        let m = P2::new(0.5 * (a.x + b.x), 0.5 * (a.y + b.y));
-        // The right-hand normal of the heading.
-        let (nx, ny) = (dy / len, -dx / len);
-        if let (Some(r), Some(l)) = (
-            field.sample(P2::new(m.x + h * nx, m.y + h * ny)),
-            field.sample(P2::new(m.x - h * nx, m.y - h * ny)),
-        ) {
-            right += (r - l) * len;
-        }
-    }
-    right
-}
