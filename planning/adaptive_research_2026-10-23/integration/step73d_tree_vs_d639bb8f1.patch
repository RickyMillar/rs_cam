-/// The chord rule of [`core_spiral`]: the vertices per turn that keep each
-/// chord within `tolerance` of a circle of radius `outer`
-/// (`⌈π / acos(1 - tolerance / ρ)⌉`, the rule of [`circle_from`]).
-fn chord_turn_steps(outer: f64, tolerance: f64) -> usize {
-    let sag = (1.0 - (tolerance / outer).min(1.0))
-        .acos()
-        .max(f64::EPSILON);
-    (std::f64::consts::PI / sag).ceil().max(3.0) as usize
-}
