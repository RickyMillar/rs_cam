-/// C16 (measure only; the bound is the operator's ruling): one arc-to-arc
-/// join of [`ArcReport::over_bound`].
-///
-/// Two arcs `Δ` apart that meet a wall at an angle `θ` to their normal
-/// (`θ = 0`: the arcs cross the wall square, the join runs along the
-/// normal) have ends `Δ / cos θ` apart along the wall. `θ` is read as the
-/// angle between the join and the normal of the arc it goes onto, from
-/// that arc's chord over one pass step from its start (the whole arc when
-/// shorter). The slanted bound is `s / cos θ + (1 + √2)·cell`, the C14
-/// bound ([`turn_bound`]) with `s` over `cos θ`.
-#[derive(Debug, Clone, Copy)]
-pub struct OverBoundTurn {
-    pub from: P2,
-    pub to: P2,
-    pub length_mm: f64,
-    /// `θ` (rad), in `[0, π/2]`.
-    pub theta: f64,
-    /// `s / cos θ + (1 + √2)·cell` (mm); `INFINITY` at `θ = π/2`.
-    pub slanted_bound_mm: f64,
-}
-
-impl OverBoundTurn {
-    /// The join from `from` onto the arc `onto` (cutting order), for a
-    /// stepover `s` on the lattice `cell`, with the pass step `span`.
-    fn new(from: P2, onto: &[P2], s: f64, cell: f64, span: f64) -> Option<Self> {
-        let &to = onto.first()?;
-        let (dx, dy) = (to.x - from.x, to.y - from.y);
-        let length_mm = dx.hypot(dy);
-        let mut cum = Vec::with_capacity(onto.len());
-        let mut run = 0.0_f64;
-        let mut prev: Option<P2> = None;
-        for &p in onto {
-            if let Some(q) = prev {
-                run += (p.x - q.x).hypot(p.y - q.y);
-            }
-            cum.push(run);
-            prev = Some(p);
-        }
-        let ahead = point_at_length(onto, &cum, span.min(run))?;
-        let (tx, ty) = (ahead.x - to.x, ahead.y - to.y);
-        let chord = tx.hypot(ty);
-        if length_mm <= 0.0 || chord <= 0.0 {
-            return None;
-        }
-        // |sin| of the angle to the tangent is |cos| of the angle to the
-        // normal.
-        let cos_theta = ((dx * ty - dy * tx) / (length_mm * chord)).abs().min(1.0);
-        let slanted_bound_mm = if cos_theta > 0.0 {
-            s / cos_theta + (1.0 + SQRT_2) * cell
-        } else {
-            f64::INFINITY
-        };
-        Some(Self {
-            from,
-            to,
-            length_mm,
-            theta: cos_theta.acos(),
-            slanted_bound_mm,
-        })
-    }
-
-    /// True when the join fits the slanted bound.
-    #[must_use]
-    pub fn fits_slanted(&self) -> bool {
-        self.length_mm <= self.slanted_bound_mm
-    }
-}
