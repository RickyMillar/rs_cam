-    let mut best: Option<(P2, f64)> = None;
-    let mut take = |q: P2| {
-        let d = (q.x - p.x).hypot(q.y - p.y);
-        if best.is_none_or(|(_, b)| d < b) {
-            best = Some((q, d));
-        }
-    };
-    if let [only] = poly {
