-/// §12.9: `chains` less the core's own loops ([`SpiralCore::owns`]).
-fn beside_core(mut chains: Vec<Chain>, core: SpiralCore) -> Vec<Chain> {
-    chains.retain(|c| !core.owns(c));
-    chains
-}
