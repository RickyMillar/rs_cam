-        let (Some(&b), Some(&a)) = (pts.last(), pts.get(pts.len() - 2)) else {
-            return;
-        };
-        let seg = (b.x - a.x).hypot(b.y - a.y);
-        if seg > len {
-            let t = (seg - len) / seg;
-            if let Some(last) = pts.last_mut() {
-                *last = P2::new(a.x + t * (b.x - a.x), a.y + t * (b.y - a.y));
