-/// C23: the swept width (fraction of D) that an open arc reads at its end
-/// on a wall: the lens of stock that the arc one level before leaves
-/// between its own end and the wall ([`ArcEnds::HeadOn`]).
-///
-/// Two straight arcs `Δ` apart (normal distance) meet a straight wall at
-/// the signed angle `θ` between the travel and the wall normal; `θ > 0`
-/// when the travel leans toward the side where the later arcs end (where
-/// `T` grows along the wall). The cutter stands at the end, on the
-/// tool-centre edge. In the frame of the travel (`f` ahead, `u` sideways
-/// toward the stock) the arc before ends at `(u, f) = (−Δ, −Δ tan θ)`.
-/// Its swath and its end disc cover the stock beside the end, and the
-/// cutter's own swath covers `f ≤ 0`. The stock left in the disc ahead is
-/// the lens outside the earlier end disc. Its near edge is the far
-/// crossing of the two circles of radius `R`: `u = −Δ/2 − h sin θ`,
-/// `f = −(Δ tan θ)/2 + h cos θ`, `h = √(R² − Δ²/(4 cos² θ))`, when that
-/// point lies ahead of both ends (`f > max(0, −Δ tan θ)`); else the swath
-/// of the arc before covers the lens, and the near edge is the steady
-/// `R − Δ`. The far edge is `R`, the standing stock beside the cutter. The
-/// reading is the span over `2R`. At `θ = 0` it is `(R + Δ/2)/2R`, above
-/// the ceiling for every `Δ` (0.66 at Δ 1.9, R 3). With the two centres
-/// `2R` or more apart the discs do not meet: a travel that leans away
-/// reads the steady `Δ/2R`, one that leans toward reads the whole disc.
-/// No constant enters; the unit test checks the form against a raster of
-/// the same geometry.
-fn arc_end_lens(tool_radius: f64, delta: f64, theta: f64) -> f64 {
-    let r = tool_radius;
-    let (sin, cos) = theta.sin_cos();
-    if cos <= 0.0 || r <= 0.0 {
-        return 0.0;
-    }
-    let gap = delta / cos;
-    if gap >= 2.0 * r {
-        return if sin < 0.0 { delta / (2.0 * r) } else { 1.0 };
-    }
-    let h = (r * r - 0.25 * gap * gap).sqrt();
-    let b = delta * theta.tan();
-    let u = -0.5 * delta - h * sin;
-    let f = -0.5 * b + h * cos;
-    let steady = r - delta;
-    let near = if f > (-b).max(0.0) {
-        u.min(steady)
-    } else {
-        steady
-    };
-    (r - near) / (2.0 * r)
-}
