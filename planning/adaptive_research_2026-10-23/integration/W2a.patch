+/// refusal (no force line, no stickout) fails.
+fn wall_step_admits(
+    tool: &ToolDefinition,
+    material: &crate::material::Material,
+    skin: f64,
+    ap: f64,
+    fz: f64,
+) -> bool {
+    if skin <= 0.0 {
+        return true;
+    }
